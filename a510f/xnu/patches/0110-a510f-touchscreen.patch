--- /dev/null
+++ b/bsd/dev/a510f_touch.c
@@ -0,0 +1,861 @@
+/*
+ * A510F (Galaxy A5 2016, Exynos 7580) touchscreen: Zinitix ZT7538 (BT532
+ * protocol) at 0x20 on the s3c2410-style I2C2 controller (0x13850000, pins
+ * gpc3-0/1), attention line gpa1-1 (low = data ready). Its 3.3 V supply is
+ * LDO33 of the S2MPU03 PMIC (register 0x4E), reached through the HSI2C3
+ * "batcher" at 0x104C0000 (sequence as in Samsung's i2c-exynos5.c).
+ *
+ * boot-arg a510ftouch:
+ *   0  off (default)
+ *   1  probe: set up I2C2 pins/clock, read the PMIC ID and LDO33 control,
+ *      try the touch chip; print everything; no PMIC writes
+ *   2  full: as 1, then switch LDO33 on (3.3 V) if it is off and the PMIC
+ *      reads looked sane, power up the chip, poll it and report fingers to
+ *      SweetHIDTouch (sweet_hid_touch, panel pixels).
+ *
+ * Everything runs on one kernel thread with polled I/O.
+ */
+#include <pexpert/arm64/board_config.h>
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern kern_return_t thread_terminate(thread_t);
+extern void IOSleep(unsigned int milliseconds);
+extern void delay(int usec);
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+extern void sweet_hid_key(int key, int down);
+void a510f_touch_start(void);
+
+/* ---- addresses ------------------------------------------------------------ */
+#define CMU_PERI_PA     0x139F0000u
+#define EN_PCLK_PERIC   0x0904u         /* bit 9: pclk_i2c2 */
+#define I2C2_PA         0x13850000u
+#define PIN_NFC_PA      0x138C0000u     /* gpc3 at +0x000 */
+#define PIN_ALIVE_PA    0x139B0000u     /* gpa1 at +0x020 */
+#define HSI2C3_PA       0x104C0000u
+#define CMU_MIF_PA      0x10430000u
+#define EN_PCLK_MIF     0x0900u         /* bit 27: pclk_hsi2c3 */
+#define PIN_M_PA        0x104E0000u     /* gpm0 at +0x000: 0 SDA, 1 SCL */
+
+#define TS_ADDR         0x20
+#define PMIC_ADDR       0x66
+#define PMIC_REG_ID     0x00
+#define PMIC_REG_L33    0x4E
+#define PMIC_L33_ON     0xFC            /* [7:6]=11 on, 0x3C = 1.8 V + 60 x 25 mV = 3.3 V */
+
+/* s3c2410 I2C */
+#define IICCON          0x00
+#define IICSTAT         0x04
+#define IICADD          0x08
+#define IICDS           0x0C
+#define IICLC           0x10
+#define CON_ACKEN       (1u << 7)
+#define CON_IRQEN       (1u << 5)
+#define CON_PEND        (1u << 4)
+#define CON_DIV         15u             /* 66 MHz / 16 / 16 = 258 kHz */
+#define STAT_MTX        (3u << 6)
+#define STAT_MRX        (2u << 6)
+#define STAT_START      (1u << 5)       /* write: start, read: bus busy */
+#define STAT_TXRXEN     (1u << 4)
+#define STAT_ARB        (1u << 3)
+#define STAT_NACK       (1u << 0)
+
+/* HSI2C + batcher (i2c-exynos5.c) */
+#define HS_CTL          0x00
+#define HS_FIFO_CTL     0x04
+#define HS_TRAILIG_CTL  0x08
+#define HS_INT_ENABLE   0x20
+#define HS_INT_STATUS   0x24
+#define HS_FIFO_STATUS  0x30
+#define HS_TRANS_STATUS 0x50
+#define HS_TX_DATA      0x34
+#define HS_RX_DATA      0x38
+#define HS_CONF         0x40
+#define HS_AUTO_CONF    0x44
+#define HS_TIMEOUT      0x48
+#define HS_TIMING_HS1   0x54
+#define HS_TIMING_HS2   0x58
+#define HS_TIMING_HS3   0x5C
+#define HS_TIMING_FS1   0x60
+#define HS_TIMING_FS2   0x64
+#define HS_TIMING_FS3   0x68
+#define HS_TIMING_SLA   0x6C
+#define HS_ADDR         0x70
+#define BAT_CON         0x500
+#define BAT_STATE       0x504
+#define BAT_INT_EN      0x508
+#define BAT_FIFO_STATUS 0x50C
+#define BAT_INT_STATUS  0x510
+#define BAT_OPCODE      0x600
+#define BAT_PAYLOAD     0x1000
+#define BAT_PAYLOAD_END 0x1060
+#define BAT_ENABLE      (1u << 0)
+#define BAT_DEDICATE    (1u << 1)
+#define BAT_START       (1u << 4)
+#define BAT_COMPLETE    (1u << 0)
+#define BAT_UNEXPECTED  (1u << 1)
+#define BAT_IDLE_STATE  (1u << 3)
+#define HS_SM_RELEASE   0x200           /* HSI2C_SMRelease: write 1 = release AP semaphore */
+
+/* BT532 / ZT7538 */
+#define ZT_SWRESET      0x0000
+#define ZT_CLEAR_INT    0x0003
+#define ZT_TOUCH_MODE   0x0010
+#define ZT_FW_VERSION   0x0012
+#define ZT_VENDOR_ID    0x001C
+#define ZT_POINT_STATUS 0x0080
+#define ZT_INT_MASK     0x00F0
+#define ZT_FINGERS      5
+#define ZT_STATUS_EXIST (1u << 11)
+#define ZT_SUB_EXIST    (1u << 0)
+#define ZT_SUB_DOWN     (1u << 1)
+#define ZT_SUB_MOVE     (1u << 2)
+#define ZT_SUB_UP       (1u << 3)
+
+/* iPhone X layout (no sweetfb_fit): the panel shows the centre of the
+ * 1125x2436 frame (y offset 258); SweetHIDTouch adds (2436 - 2400) / 2 = 18,
+ * so add the other 240 here. With sweetfb_fit (iPhone 8 Plus, scaled to
+ * fit) the panel is the display and touch passes through unchanged. */
+#define TOUCH_Y_ADJUST  240
+
+static struct {
+	vm_offset_t cmu, i2c, pin_nfc, pin_alive, hs, cmu_mif, pin_m;
+	int mode;
+	int yadj;                       /* TOUCH_Y_ADJUST or 0 (sweetfb_fit) */
+	bool down[ZT_FINGERS];
+	unsigned cmd_index, cmd_pointer, desc_pointer;
+	uint32_t cmd_buffer;
+} t;
+
+static inline uint32_t
+rd(vm_offset_t b, uint32_t o)
+{
+	uint32_t v = *(volatile uint32_t *)(b + o);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static inline void
+wr(vm_offset_t b, uint32_t o, uint32_t v)
+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(b + o) = v;
+}
+
+/* ---- I2C2 (s3c2410) ------------------------------------------------------- */
+static bool
+i2c_wait_pend(void)
+{
+	for (int i = 0; i < 20000; i++) {          /* ~20 ms */
+		if (rd(t.i2c, IICCON) & CON_PEND) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+static void
+i2c_clear_pend(bool ack)
+{
+	uint32_t con = (rd(t.i2c, IICCON) & ~(CON_PEND | CON_ACKEN)) | (ack ? CON_ACKEN : 0);
+	wr(t.i2c, IICCON, con);
+}
+
+static void
+i2c_stop(uint32_t mode)
+{
+	wr(t.i2c, IICSTAT, mode | STAT_TXRXEN);
+	i2c_clear_pend(true);
+	for (int i = 0; i < 2000 && (rd(t.i2c, IICSTAT) & STAT_START); i++) {
+		delay(1);
+	}
+}
+
+/* Write len bytes to addr. 0 ok, else EIO/ETIMEDOUT/ENXIO (no ACK). */
+static int
+i2c_write(uint8_t addr, const uint8_t *buf, unsigned len)
+{
+	wr(t.i2c, IICCON, CON_ACKEN | CON_IRQEN | CON_DIV);
+	wr(t.i2c, IICSTAT, STAT_MTX | STAT_TXRXEN);
+	wr(t.i2c, IICDS, (uint32_t)addr << 1);
+	wr(t.i2c, IICSTAT, STAT_MTX | STAT_START | STAT_TXRXEN);
+	if (!i2c_wait_pend()) {
+		i2c_stop(STAT_MTX);
+		return ETIMEDOUT;
+	}
+	if (rd(t.i2c, IICSTAT) & STAT_NACK) {
+		i2c_stop(STAT_MTX);
+		return ENXIO;
+	}
+	for (unsigned i = 0; i < len; i++) {
+		wr(t.i2c, IICDS, buf[i]);
+		delay(1);
+		i2c_clear_pend(true);
+		if (!i2c_wait_pend()) {
+			i2c_stop(STAT_MTX);
+			return ETIMEDOUT;
+		}
+		if (rd(t.i2c, IICSTAT) & STAT_NACK) {
+			i2c_stop(STAT_MTX);
+			return EIO;
+		}
+	}
+	i2c_stop(STAT_MTX);
+	return 0;
+}
+
+static int
+i2c_read(uint8_t addr, uint8_t *buf, unsigned len)
+{
+	wr(t.i2c, IICCON, CON_ACKEN | CON_IRQEN | CON_DIV);
+	wr(t.i2c, IICSTAT, STAT_MRX | STAT_TXRXEN);
+	wr(t.i2c, IICDS, ((uint32_t)addr << 1) | 1);
+	wr(t.i2c, IICSTAT, STAT_MRX | STAT_START | STAT_TXRXEN);
+	if (!i2c_wait_pend()) {
+		i2c_stop(STAT_MRX);
+		return ETIMEDOUT;
+	}
+	if (rd(t.i2c, IICSTAT) & STAT_NACK) {
+		i2c_stop(STAT_MRX);
+		return ENXIO;
+	}
+	for (unsigned i = 0; i < len; i++) {
+		i2c_clear_pend(i + 1 < len);            /* NACK the last byte */
+		if (!i2c_wait_pend()) {
+			i2c_stop(STAT_MRX);
+			return ETIMEDOUT;
+		}
+		buf[i] = (uint8_t)rd(t.i2c, IICDS);
+	}
+	i2c_stop(STAT_MRX);
+	return 0;
+}
+
+/* BT532 register access: 16-bit little-endian register numbers. */
+static int
+zt_read(uint16_t reg, void *buf, unsigned len)
+{
+	uint8_t r[2] = { (uint8_t)reg, (uint8_t)(reg >> 8) };
+	int e = i2c_write(TS_ADDR, r, 2);
+	if (e) {
+		return e;
+	}
+	delay(50);
+	e = i2c_read(TS_ADDR, buf, len);
+	delay(10);
+	return e;
+}
+
+static int
+zt_cmd(uint16_t reg)
+{
+	uint8_t r[2] = { (uint8_t)reg, (uint8_t)(reg >> 8) };
+	int e = i2c_write(TS_ADDR, r, 2);
+	delay(10);
+	return e;
+}
+
+static int
+zt_write(uint16_t reg, uint16_t val)
+{
+	uint8_t r[4] = { (uint8_t)reg, (uint8_t)(reg >> 8), (uint8_t)val, (uint8_t)(val >> 8) };
+	int e = i2c_write(TS_ADDR, r, 4);
+	delay(10);
+	return e;
+}
+
+/* ---- HSI2C3 batcher (PMIC) ------------------------------------------------ */
+static void
+bat_op(uint32_t value, uint32_t reg)
+{
+	if (BAT_PAYLOAD + t.desc_pointer * 4 >= BAT_PAYLOAD_END) {
+		printf("A510F TOUCH: batcher payload full\n");
+		return;
+	}
+	t.cmd_buffer &= ~(0xffu << (8 * t.cmd_index));
+	t.cmd_buffer |= (reg & 0xffu) << (8 * t.cmd_index);
+	wr(t.hs, BAT_OPCODE + t.cmd_pointer * 4, t.cmd_buffer);
+	wr(t.hs, BAT_PAYLOAD + t.desc_pointer++ * 4, value);
+	if (++t.cmd_index == 4) {
+		t.cmd_index = 0;
+		t.cmd_pointer++;
+		t.cmd_buffer = 0xffffffffu;
+	}
+}
+
+static void
+bat_reset_ptrs(void)
+{
+	t.desc_pointer = t.cmd_index = t.cmd_pointer = 0;
+	t.cmd_buffer = 0xffffffffu;
+}
+
+/*
+ * One batcher message (i2c-exynos5.c exynos5_i2c_xfer_batcher): a write of
+ * len bytes (7-bit address) or a read of len bytes (10-bit address mode, as
+ * Samsung's driver does for the PMIC), stop after it if stop.
+ */
+static int
+bat_xfer(bool read, uint8_t *buf, unsigned len, bool stop, bool tenbit)
+{
+	bat_reset_ptrs();
+	uint32_t st0 = rd(t.hs, BAT_STATE);
+	if (st0 != BAT_IDLE_STATE) {
+		/* Samsung's recover_batcher: batcher reset, release the AP semaphore. */
+		wr(t.hs, BAT_CON, 1u << 31);
+		wr(t.hs, BAT_CON, 0);
+		wr(t.hs, HS_SM_RELEASE, 1);
+		printf("A510F TOUCH:   batcher was in state 0x%x, reset: now 0x%x\n", st0, rd(t.hs, BAT_STATE));
+	}
+	wr(t.hs, BAT_CON, 0);                                   /* idle */
+	wr(t.hs, BAT_CON, rd(t.hs, BAT_CON) | BAT_ENABLE | BAT_DEDICATE);
+
+	bat_op(0x0F0F0F00, HS_TIMING_HS1);
+	bat_op(0x080F0F04, HS_TIMING_HS2);
+	bat_op(0x00000013, HS_TIMING_HS3);
+	bat_op(0x78787800, HS_TIMING_FS1);
+	bat_op(0x3C0F7878, HS_TIMING_FS2);
+	bat_op(0x000000F0, HS_TIMING_FS3);
+	bat_op(0x00000007, HS_TIMING_SLA);
+	bat_op(0x2ff, HS_TRAILIG_CTL);
+
+	uint32_t conf = (1u << 31) | (1u << 29) |               /* auto, HS mode */
+	    (3u << 16) | (3u << 13) | (1u << 28) | (1u << 27) | 0xff;
+	if (read && tenbit) {
+		conf |= 1u << 30;                               /* 10-bit address mode */
+	}
+	bat_op(conf, HS_CONF);
+	bat_op(0, HS_TIMEOUT);
+	bat_op((1u << 0) | (1u << 1) | (0x8u << 16) | (len << 4), HS_FIFO_CTL);
+	uint32_t ctl = 1u << 3;                                 /* master */
+	ctl |= read ? (1u << 6) : (1u << 7);                   /* RXCHON / TXCHON */
+	if (read && tenbit) {
+		ctl |= 1u << 30;                                /* EXT_ADDR */
+	}
+	bat_op(ctl, HS_CTL);
+	bat_op((read && tenbit) ? ((uint32_t)(PMIC_ADDR & 0x3fff) << 10) : ((uint32_t)(PMIC_ADDR & 0x7f) << 10), HS_ADDR);
+	uint32_t ac = (read ? (1u << 16) : 0) | (stop ? (1u << 17) : 0) | len | (1u << 31);
+	bat_op(ac, HS_AUTO_CONF);
+	wr(t.hs, BAT_INT_STATUS, rd(t.hs, BAT_INT_STATUS));
+	/*
+	 * RX almost full / TX almost empty as Samsung, plus TRANSFER_DONE and
+	 * the trans-state errors (no ack, no dev, abort, timeout: 0xf00, as
+	 * samsung,check-transdone-int does for this bus): touch7's read waited
+	 * in 0x200 for an RX interrupt that never came.
+	 */
+	bat_op((read ? (1u << 1) : (1u << 0)) | (1u << 7) | (0xfu << 8), HS_INT_ENABLE);
+	uint32_t rx_at = BAT_PAYLOAD + t.desc_pointer * 4;
+	for (unsigned i = 0; i < len; i++) {
+		bat_op(read ? 0x77 : buf[i], read ? HS_RX_DATA : HS_TX_DATA);
+	}
+	bat_op(0x00, 0xff);                                     /* finalize */
+	bat_reset_ptrs();
+	wr(t.hs, BAT_INT_EN, 1);
+	wr(t.hs, BAT_CON, rd(t.hs, BAT_CON) | BAT_START);
+
+	/*
+	 * Done = OPERATION_COMPLETE (state bit 0), set by the hardware: touch6
+	 * showed a write finish as states 0x40 -> 0x11. INT_STATUS is no use: it
+	 * still read 0x81 from the previous message when a read had only reached
+	 * 0x40, and stopping there left the batcher stuck in 0x200.
+	 */
+	uint32_t st = 0, is = 0;
+	uint32_t trace[6] = { 0 };
+	unsigned nt = 0;
+	bool done = false;
+	for (int i = 0; i < 200000; i++) {                      /* ~200 ms */
+		st = rd(t.hs, BAT_STATE);
+		is = rd(t.hs, BAT_INT_STATUS);
+		if (nt < 6 && (nt == 0 || trace[nt - 1] != st)) {
+			trace[nt++] = st;                       /* state changes */
+		}
+		if (st & (BAT_COMPLETE | BAT_UNEXPECTED)) {
+			done = true;
+			break;
+		}
+		delay(1);
+	}
+	uint32_t payload = rd(t.hs, rx_at);
+	uint32_t bfifo = rd(t.hs, BAT_FIFO_STATUS);
+	wr(t.hs, BAT_INT_EN, 0);
+	int err = 0;
+	if (!done || (st & BAT_UNEXPECTED)) {
+		err = EIO;
+	} else if (read) {
+		for (unsigned i = 0; i < len; i++) {
+			buf[i] = (uint8_t)rd(t.hs, rx_at + i * 4);
+		}
+	}
+	/*
+	 * As Samsung's IRQ handler: mark complete, ack, back to idle. No HSI2C
+	 * (0x00-0xff) register access while the batcher owns the block: that
+	 * read stalled the CPU for good (touch3/4/5 froze right here).
+	 */
+	wr(t.hs, BAT_STATE, st | BAT_COMPLETE);
+	wr(t.hs, BAT_INT_STATUS, is);
+	wr(t.hs, BAT_CON, 0);                                   /* idle */
+	/* One line per message: states seen, int, payload, state after idle. */
+	printf("A510F TOUCH:  %s%s%s %x>%x>%x>%x i%x p%x f%x n%x%s\n",
+	    read ? "rd" : "wr", (read && tenbit) ? "10" : "", stop ? "S" : "",
+	    trace[0], trace[1], trace[2], trace[3], is, payload, bfifo, rd(t.hs, BAT_STATE),
+	    err ? (done ? " UNEXP" : " TIMEOUT") : "");
+	return err;
+}
+
+static bool
+pmic_sane(int e1, uint8_t id, int e2, uint8_t l33)
+{
+	/* Real data, and LDO33 either already set to 3.3 V, or off with a plausible ID. */
+	return !e1 && !e2 && id != 0xff && id != 0x77 && id != 0xee && l33 != 0x77 && l33 != 0xee &&
+	       ((l33 & 0x3f) == 0x3c || (id != 0x00 && (l33 & 0xc0) == 0));
+}
+
+/*
+ * Register read = write the register number, then read one byte. Samsung's
+ * batcher does it as write (no stop) + read in 10-bit "EXT_ADDR" mode; on
+ * touch7 that read never got a byte. Try that and the plain I2C forms:
+ *   0: write no-stop + read 10-bit (Samsung)
+ *   1: write + stop, read 7-bit
+ *   2: write no-stop + read 7-bit (repeated start)
+ *   3: write + stop, read 10-bit
+ */
+static const char *const pmic_mode_name[4] = {
+	"nostop+10bit", "stop+7bit", "nostop+7bit", "stop+10bit",
+};
+static int pmic_mode;
+
+static int
+pmic_read_mode(int mode, uint8_t reg, uint8_t *val)
+{
+	bool wstop = (mode == 1 || mode == 3);
+	bool tenbit = (mode == 0 || mode == 3);
+	int e = bat_xfer(false, &reg, 1, wstop, false);
+	if (!e) {
+		e = bat_xfer(true, val, 1, true, tenbit);
+	}
+	return e;
+}
+
+static int
+pmic_read(uint8_t reg, uint8_t *val)
+{
+	return pmic_read_mode(pmic_mode, reg, val);
+}
+
+static int
+pmic_write(uint8_t reg, uint8_t val)
+{
+	uint8_t b[2] = { reg, val };
+	return bat_xfer(false, b, 2, true, false);
+}
+
+/* ---- setup -------------------------------------------------------------- */
+static void
+setup_i2c2(void)
+{
+	/* pclk_i2c2 */
+	wr(t.cmu, EN_PCLK_PERIC, rd(t.cmu, EN_PCLK_PERIC) | (1u << 9));
+	/* gpc3-0/1: function 2 (I2C), pull-up (3), drive 0 */
+	uint32_t con = rd(t.pin_nfc, 0x00);
+	con = (con & ~0xffu) | 0x22u;
+	wr(t.pin_nfc, 0x00, con);
+	uint32_t pud = rd(t.pin_nfc, 0x08);
+	pud = (pud & ~0xfu) | 0xfu;
+	wr(t.pin_nfc, 0x08, pud);
+	wr(t.pin_nfc, 0x0c, rd(t.pin_nfc, 0x0c) & ~0xffu);
+	/* gpa1-1: plain input, no pull (we poll the level) */
+	wr(t.pin_alive, 0x20, rd(t.pin_alive, 0x20) & ~(0xfu << 4));
+	wr(t.pin_alive, 0x28, rd(t.pin_alive, 0x28) & ~(0x3u << 2));
+	/* controller: filter on, SDA delay 1 clock; ack, /16, divider 15 */
+	wr(t.i2c, IICLC, 0x5);
+	wr(t.i2c, IICCON, CON_ACKEN | CON_IRQEN | CON_DIV);
+	wr(t.i2c, IICSTAT, STAT_TXRXEN);
+}
+
+static bool
+attn_low(void)
+{
+	return (rd(t.pin_alive, 0x24) & (1u << 1)) == 0;
+}
+
+static bool
+zt_power_on(void)
+{
+	/* bt532_power_sequence */
+	if (zt_write(0xc000, 0x0001)) {
+		return false;
+	}
+	uint16_t code = 0;
+	(void)zt_read(0xcc00, &code, 2);
+	printf("A510F TOUCH: chip code 0x%04x\n", code);
+	if (zt_cmd(0xc004) || zt_write(0xc002, 0x0001)) {
+		return false;
+	}
+	IOSleep(2);
+	if (zt_write(0xc001, 0x0001)) {
+		return false;
+	}
+	IOSleep(150);                                           /* FIRMWARE_ON_DELAY */
+	/* mini_init_touch */
+	if (zt_cmd(ZT_SWRESET) || zt_write(ZT_TOUCH_MODE, 0) || zt_write(ZT_INT_MASK, 0x3f)) {
+		return false;
+	}
+	for (int i = 0; i < 10; i++) {
+		(void)zt_cmd(ZT_CLEAR_INT);
+	}
+	uint16_t vendor = 0, fw = 0;
+	(void)zt_read(ZT_VENDOR_ID, &vendor, 2);
+	(void)zt_read(ZT_FW_VERSION, &fw, 2);
+	printf("A510F TOUCH: ZT7538 up, vendor 0x%04x fw 0x%04x\n", vendor, fw);
+	return true;
+}
+
+static unsigned zt_logged, zt_errors;
+
+static void
+zt_poll_once(void)
+{
+	uint8_t p[4 + 6 * ZT_FINGERS];
+	int e = zt_read(ZT_POINT_STATUS, p, sizeof(p));
+	if (e) {
+		if (++zt_errors <= 5 || zt_errors % 1000 == 0) {
+			printf("A510F TOUCH: point read error %d (%u so far)\n", e, zt_errors);
+		}
+		(void)zt_cmd(ZT_CLEAR_INT);
+		return;
+	}
+	uint16_t status = (uint16_t)(p[0] | p[1] << 8);
+	/* Diagnostics: the first 40 reports in full, then every 200th. */
+	static unsigned seen;
+	if (++seen <= 40 || seen % 200 == 0) {
+		printf("A510F TOUCH: #%u st 0x%04x n %u f0 %u,%u w%u sub 0x%02x\n", seen, status, p[2],
+		    p[4] | p[5] << 8, p[6] | p[7] << 8, p[8], p[9]);
+	}
+	if (status == 0x0000 || status == 0xffff || status == 0x0001 || (status & (1u << 13))) {
+		/* periodic / invalid (MUST_ZERO bit) report, as Samsung's driver skips */
+		(void)zt_cmd(ZT_CLEAR_INT);
+		return;
+	}
+	for (int f = 0; f < ZT_FINGERS; f++) {
+		const uint8_t *c = p + 4 + 6 * f;
+		int x = c[0] | c[1] << 8, y = c[2] | c[3] << 8;
+		uint8_t sub = c[5];
+		bool down = (sub & ZT_SUB_EXIST) && !(sub & ZT_SUB_UP);
+		if (!(status & ZT_STATUS_EXIST) && !(sub & ZT_SUB_UP)) {
+			down = false;
+		}
+		if (down) {
+			if (x > 1079) {
+				x = 1079;
+			}
+			if (y > 1919) {
+				y = 1919;
+			}
+			sweet_hid_touch(f, 1, x, y + t.yadj);
+			t.down[f] = true;
+		} else if (t.down[f]) {
+			sweet_hid_touch(f, 0, x, y + t.yadj);
+			t.down[f] = false;
+		}
+	}
+	(void)zt_cmd(ZT_CLEAR_INT);
+}
+
+/*
+ * Buttons: plain GPIOs on gpa2 (always-on bank, 0x139B0040), active low,
+ * from Samsung's gpio-keys node: power gpa2-7, volume down gpa2-1, volume
+ * up gpa2-0, home gpa2-5. Polled every 8 ms with the touch chip; a change
+ * counts once two samples in a row agree (debounce), then goes to
+ * SweetHIDButtons: 0 power, 1 volume up, 2 volume down, 3 home (menu).
+ */
+#define GPA2_CON        0x40
+#define GPA2_DAT        0x44
+static const struct { uint8_t pin, key; const char *name; } a510f_keys[] = {
+	{ 7, 0, "power" }, { 0, 1, "volume up" }, { 1, 2, "volume down" }, { 5, 3, "home" },
+};
+#define NKEYS (sizeof(a510f_keys) / sizeof(a510f_keys[0]))
+static bool key_down[NKEYS], key_pending[NKEYS];
+
+static void
+keys_setup(void)
+{
+	uint32_t con = rd(t.pin_alive, GPA2_CON);
+	printf("A510F KEYS: gpa2 con 0x%x dat 0x%x pud 0x%x\n", con, rd(t.pin_alive, GPA2_DAT),
+	    rd(t.pin_alive, GPA2_CON + 8));
+	for (unsigned i = 0; i < NKEYS; i++) {
+		con &= ~(0xfu << (4 * a510f_keys[i].pin));     /* input */
+	}
+	wr(t.pin_alive, GPA2_CON, con);
+	uint32_t dat = rd(t.pin_alive, GPA2_DAT);
+	for (unsigned i = 0; i < NKEYS; i++) {
+		key_down[i] = key_pending[i] = !(dat & (1u << a510f_keys[i].pin));
+	}
+	printf("A510F KEYS: inputs, dat 0x%x\n", dat);
+}
+
+static void
+keys_poll(void)
+{
+	uint32_t dat = rd(t.pin_alive, GPA2_DAT);
+	for (unsigned i = 0; i < NKEYS; i++) {
+		bool now = !(dat & (1u << a510f_keys[i].pin));
+		if (now != key_down[i] && now == key_pending[i]) {
+			key_down[i] = now;
+			printf("A510F KEYS: %s %s\n", a510f_keys[i].name, now ? "down" : "up");
+			sweet_hid_key(a510f_keys[i].key, now);
+		}
+		key_pending[i] = now;
+	}
+}
+
+/*
+ * A510F CPU clock (boot-arg a510fcpufreq=1200): S-Boot leaves both
+ * clusters at 780 MHz (PLL M 240 P 4 S 1). Raise them to 1.2 GHz the way
+ * Samsung's exynos-smp-cpufreq.c goes up: voltage first, then the
+ * dividers, then the PLL with the cluster parked on the bus PLL meanwhile.
+ *   cluster 0: CMU_CPU 0x10900000, BUCK2 (vsel 0x1D)
+ *   cluster 1: CMU_APL 0x10800000, BUCK1 (vsel 0x1B)
+ * 1.18125 V (vsel 0x7D, 400 mV + n * 6.25 mV) is the highest voltage of any
+ * ASV group/table at 1.2 GHz (asv-exynos7580.h); ABB is bypassed there.
+ * Divider and PLL values: Samsung's apll_freq[] / table_cpu[].
+ */
+static int a510f_cpufreq;
+
+static bool
+cmu_wait(vm_offset_t b, uint32_t off, uint32_t mask, uint32_t want)
+{
+	for (int i = 0; i < 10000; i++) {               /* 10 ms */
+		if ((rd(b, off) & mask) == want) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+static void
+a510f_cpu_raise(void)
+{
+	static const struct { const char *name; uint32_t pa; uint8_t vreg; } cl[2] = {
+		{ "cluster0/CPU", 0x10900000u, 0x1D }, { "cluster1/APL", 0x10800000u, 0x1B },
+	};
+	if (a510f_cpufreq != 1200) {
+		printf("A510F CLK: left at the boot clock (a510fcpufreq=%d)\n", a510f_cpufreq);
+		return;
+	}
+	for (int c = 0; c < 2; c++) {
+		vm_offset_t b = ml_io_map(cl[c].pa, 0x1000);
+		if (b == 0) {
+			continue;
+		}
+		uint8_t v = 0xee;
+		int e = pmic_read(cl[c].vreg, &v);
+		printf("A510F CLK: %s now pll 0x%x div0 0x%x div1 0x%x, vsel %d 0x%02x (%u uV)\n",
+		    cl[c].name, rd(b, 0x100), rd(b, 0x600), rd(b, 0x604), e, v, 400000u + v * 6250u);
+		/* Expect 0.9 .. 1.18125 V for 780 MHz; anything else: leave it alone. */
+		if (e || v < 0x50 || v > 0x7D) {
+			printf("A510F CLK: %s voltage reading not plausible, clock unchanged\n", cl[c].name);
+			continue;
+		}
+		if (v != 0x7D) {
+			int ew = pmic_write(cl[c].vreg, 0x7D);
+			IOSleep(2);
+			uint8_t back = 0xee;
+			int er = pmic_read(cl[c].vreg, &back);
+			printf("A510F CLK: %s vsel -> 0x7D: write %d, read %d 0x%02x\n", cl[c].name, ew, er, back);
+			if (ew || er || back != 0x7D) {
+				printf("A510F CLK: %s voltage not confirmed, clock unchanged\n", cl[c].name);
+				continue;
+			}
+		}
+		IOSleep(2);                                     /* ramp 12 mV/us: plenty */
+
+		/* Dividers for 1.2 GHz (Samsung apll_freq[1200000]). */
+		wr(b, 0x600, 0x03727700);
+		bool d0 = cmu_wait(b, 0x700, 0xffffffffu, 0);
+		wr(b, 0x604, 0x76);
+		bool d1 = cmu_wait(b, 0x704, 0xffffffffu, 0);
+
+		/* Park on the bus PLL (MUX_SEL_x_2 bit 0 = 1, MUX_STAT reads 2). */
+		uint32_t sel = rd(b, 0x208);
+		wr(b, 0x208, sel | 1u);
+		bool parked = cmu_wait(b, 0x408, 0x7, 0x2);
+
+		/* PLL to 1.2 GHz: P 4 M 368 S 1 (composite.c pll255xx_set_rate). */
+		uint32_t con = rd(b, 0x100);
+		wr(b, 0x000, 4 * 200);                          /* lock time = P * 200 */
+		con &= ~((0x3ffu << 12) | (0x3fu << 4) | 0x7u);
+		con |= (368u << 12) | (4u << 4) | 1u;
+		con &= ~(1u << 31);
+		wr(b, 0x100, con);
+		con |= 1u << 31;
+		wr(b, 0x100, con);
+		bool locked = cmu_wait(b, 0x100, 1u << 29, 1u << 29);
+
+		bool back_on_pll = false;
+		if (locked) {
+			wr(b, 0x208, sel & ~1u);
+			back_on_pll = cmu_wait(b, 0x408, 0x7, 0x1);
+		}
+		uint32_t now = rd(b, 0x100);
+		uint32_t m = (now >> 12) & 0x3ff, p = (now >> 4) & 0x3f, s = now & 0x7;
+		printf("A510F CLK: %s div %d/%d parked %d locked %d on pll %d: pll 0x%x = %u MHz\n",
+		    cl[c].name, d0, d1, parked, locked, back_on_pll, now,
+		    p ? (unsigned)((26ull * m) / ((uint64_t)p << s)) : 0);
+	}
+}
+
+/* Touch unavailable: keep the buttons working. */
+static void
+keys_only_loop(void)
+{
+	for (;;) {
+		keys_poll();
+		IOSleep(8);
+	}
+}
+
+static void
+touch_thread(__unused void *arg, __unused wait_result_t w)
+{
+	IOSleep(3000);
+	setup_i2c2();
+	keys_setup();
+	printf("A510F TOUCH: mode %d, PERIC pclk 0x%x, gpc3 con 0x%x pud 0x%x, gpa1 con 0x%x dat 0x%x, "
+	    "iiccon 0x%x iicstat 0x%x, hsi2c ctl 0x%x conf 0x%x batcher con 0x%x state 0x%x\n",
+	    t.mode, rd(t.cmu, EN_PCLK_PERIC), rd(t.pin_nfc, 0), rd(t.pin_nfc, 8),
+	    rd(t.pin_alive, 0x20), rd(t.pin_alive, 0x24), rd(t.i2c, IICCON), rd(t.i2c, IICSTAT),
+	    rd(t.hs, HS_CTL), rd(t.hs, HS_CONF), rd(t.hs, BAT_CON), rd(t.hs, BAT_STATE));
+
+	uint8_t probe[2] = { 0, 0 };
+	int te = zt_read(ZT_VENDOR_ID, probe, 2);
+	printf("A510F TOUCH: chip at 0x20 before power: %d (%02x %02x)\n", te, probe[0], probe[1]);
+
+	/*
+	 * HSI2C3 is shared with the APM (Cortex-M3) behind a hardware
+	 * semaphore that only the batcher takes, so: batcher only, never the
+	 * HSI2C registers directly (that froze the phone twice). Read-only
+	 * look at the bus first: gpm0-0 SDA, gpm0-1 SCL, pclk_hsi2c3.
+	 */
+	printf("A510F TOUCH: hsi2c3 pclk(MIF 0x900 bit 27) 0x%x, gpm0 con 0x%x dat 0x%x pud 0x%x, "
+	    "trans 0x%x int 0x%x fifo 0x%x, bat con 0x%x state 0x%x int 0x%x fifo 0x%x\n",
+	    rd(t.cmu_mif, EN_PCLK_MIF), rd(t.pin_m, 0), rd(t.pin_m, 4), rd(t.pin_m, 8),
+	    rd(t.hs, HS_TRANS_STATUS), rd(t.hs, HS_INT_STATUS), rd(t.hs, HS_FIFO_STATUS),
+	    rd(t.hs, BAT_CON), rd(t.hs, BAT_STATE), rd(t.hs, BAT_INT_STATUS), rd(t.hs, BAT_FIFO_STATUS));
+
+	/*
+	 * S-Boot leaves gpm0-0/1 as GPIO outputs (con 0x11, dat 0x3), so the
+	 * HSI2C block is not on the pads at all. Apply Samsung's hs_i2c3_bus
+	 * pinctrl: function 2, pull-up (3), drive 2. gpm0 is a bank_type_2
+	 * bank: CON 4 bits, PUD 2 bits, DRV 4 bits per pin.
+	 */
+	wr(t.pin_m, 0x0, (rd(t.pin_m, 0x0) & ~0xffu) | 0x22u);
+	wr(t.pin_m, 0x8, (rd(t.pin_m, 0x8) & ~0xfu) | 0xfu);
+	wr(t.pin_m, 0xc, (rd(t.pin_m, 0xc) & ~0xffu) | 0x22u);
+	delay(100);
+	printf("A510F TOUCH: gpm0 -> hs_i2c3_bus: con 0x%x dat 0x%x pud 0x%x drv 0x%x\n",
+	    rd(t.pin_m, 0x0), rd(t.pin_m, 0x4), rd(t.pin_m, 0x8), rd(t.pin_m, 0xc));
+
+	uint8_t id = 0xee, l33 = 0xee;
+	int e1 = EIO, e2 = EIO;
+	bool bat_ok = false;
+	for (int m = 0; m < 4 && !bat_ok; m++) {
+		id = l33 = 0xee;
+		e1 = pmic_read_mode(m, PMIC_REG_ID, &id);
+		IOSleep(5);
+		e2 = pmic_read_mode(m, PMIC_REG_L33, &l33);
+		bat_ok = pmic_sane(e1, id, e2, l33);
+		printf("A510F TOUCH: PMIC read mode %d (%s): id %d 0x%02x, LDO33 ctrl %d 0x%02x%s\n",
+		    m, pmic_mode_name[m], e1, id, e2, l33, bat_ok ? "  <- using this" : "");
+		if (bat_ok) {
+			pmic_mode = m;
+		}
+		IOSleep(5);
+	}
+
+	if (bat_ok) {
+		a510f_cpu_raise();
+	}
+
+	if (t.mode < 2) {
+		printf("A510F TOUCH: probe only (a510ftouch=1), done\n");
+		keys_only_loop();
+		return;
+	}
+	if (te) {
+		/* Write only after both reads worked and LDO33 reads like an LDO control. */
+		if (!bat_ok) {
+			printf("A510F TOUCH: PMIC reads not trusted, LDO33 left alone\n");
+			keys_only_loop();
+			return;
+		}
+		uint8_t back = 0xee;
+		int ew = pmic_write(PMIC_REG_L33, PMIC_L33_ON);
+		IOSleep(5);
+		(void)pmic_read(PMIC_REG_L33, &back);
+		printf("A510F TOUCH: LDO33 on: write %d, now 0x%02x\n", ew, back);
+		IOSleep(50);                                    /* CHIP_ON_DELAY */
+	}
+	if (!zt_power_on()) {
+		printf("A510F TOUCH: ZT7538 init failed\n");
+		keys_only_loop();
+		return;
+	}
+	printf("A510F TOUCH: polling, attn %s\n", attn_low() ? "LOW" : "high");
+	/*
+	 * Always sleep between polls: every I2C transfer here busy-waits, and
+	 * with one CPU a loop that keeps finding attn low (no sleep) starved
+	 * backboardd. 125 Hz is plenty for touch.
+	 */
+	unsigned lows = 0;
+	for (;;) {
+		keys_poll();
+		if (attn_low()) {
+			zt_poll_once();
+			if (++lows == 1 || lows % 500 == 0) {
+				printf("A510F TOUCH: %u attn reports\n", lows);
+			}
+		}
+		IOSleep(8);
+	}
+}
+
+void
+a510f_touch_start(void)
+{
+	static bool started;
+	if (started) {
+		return;
+	}
+	started = true;
+	t.mode = 0;
+	PE_parse_boot_argn("a510ftouch", &t.mode, sizeof(t.mode));
+	PE_parse_boot_argn("a510fcpufreq", &a510f_cpufreq, sizeof(a510f_cpufreq));
+	int fit = 0;
+	PE_parse_boot_argn("sweetfb_fit", &fit, sizeof(fit));
+	t.yadj = fit ? 0 : TOUCH_Y_ADJUST;
+	if (t.mode <= 0) {
+		return;
+	}
+	t.cmu = ml_io_map(CMU_PERI_PA, 0x1000);
+	t.i2c = ml_io_map(I2C2_PA, 0x1000);
+	t.pin_nfc = ml_io_map(PIN_NFC_PA, 0x1000);
+	t.pin_alive = ml_io_map(PIN_ALIVE_PA, 0x1000);
+	t.hs = ml_io_map(HSI2C3_PA, 0x2000);
+	t.cmu_mif = ml_io_map(CMU_MIF_PA, 0x1000);
+	t.pin_m = ml_io_map(PIN_M_PA, 0x1000);
+	thread_t th;
+	if (kernel_thread_start(touch_thread, NULL, &th) == KERN_SUCCESS) {
+		thread_deallocate(th);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
