+/*
+ * A510F Wi-Fi, step 1: Broadcom BCM43454 on SDIO.
+ *
+ * Samsung's a5xelte device tree: the chip sits on DW-MMC channel 1
+ * (0x13550000, SPI 246, 4-bit, fifo depth 64), pins gpr2-0 clk / gpr2-1 cmd
+ * / gpr3-0..3 data (function 2, FSYS pinctrl 0x13750000), WL_REG_ON on
+ * gpd1-0 (WLAN_EN, TOP pinctrl 0x139C0000). Clocks (clk-exynos7580.c):
+ * aclk_mmc1 = CMU_FSYS EN_ACLK_FSYS0 bit 8, sclk_mmc1_sdclkin = CMU_FSYS
+ * EN_SCLK_FSYS bit 6, sclk_fsys_mmc1 = CMU_TOP EN_SCLK_TOP_FSYS bit 1,
+ * mux/div CMU_TOP 0x224 / 0x624 (mmc0: 0x220 / 0x620).
+ *
+ * Step 1 only: clocks on (before any MMC1 register access: a gated block
+ * can hang the bus), pins, power the chip, enumerate the SDIO card
+ * (CMD5/CMD3/CMD7), read CCCR, enable function 1, request the ALP clock and
+ * read the chip id from ChipCommon (backplane 0x18000000) with CMD53.
+ * Everything goes to the log as "A510F WIFI:". Nothing else uses the chip.
+ * Boot-arg a510fwifi=N: run N seconds after start (unset or 0: off).
+ */
+
+#include <pexpert/arm64/board_config.h>
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/locks.h>
+#include <kern/sched_prim.h>
+#include <kern/kalloc.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void IOSleep(unsigned int milliseconds);
+extern kern_return_t thread_terminate(thread_t);
+
+void a510f_wifi_start(void);
+
+#define CMU_TOP_PA      0x10010000u
+#define CMU_FSYS_PA     0x13730000u
+#define PIN_FSYS_PA     0x13750000u     /* gpr2 at +0x40 (clk, cmd), gpr3 at +0x60 (data 0-3) */
+#define PIN_TOP_PA      0x139C0000u     /* gpd1 at +0xe0: pin 0 WLAN_EN */
+#define MMC1_PA         0x13550000u
+
+#define TOP_MUX_FSYS0   0x220
+#define TOP_MUX_FSYS1   0x224
+#define TOP_DIV_FSYS0   0x620
+#define TOP_DIV_FSYS1   0x624
+#define TOP_EN_SCLK_FSYS 0xa00          /* bit 1: sclk_fsys_mmc1_sdclkin */
+#define FSYS_EN_ACLK0   0x800           /* bit 8: aclk_mmc1 */
+#define FSYS_EN_SCLK    0xa00           /* bit 6: sclk_mmc1_sdclkin */
+
+#define W_CTRL          0x000
+#define W_PWREN         0x004
+#define W_CLKDIV        0x008
+#define W_CLKSRC        0x00c
+#define W_CLKENA        0x010
+#define W_TMOUT         0x014
+#define W_CTYPE         0x018
+#define W_BLKSIZ        0x01c
+#define W_BYTCNT        0x020
+#define W_INTMASK       0x024
+#define W_CMDARG        0x028
+#define W_CMD           0x02c
+#define W_RESP0         0x030
+#define W_RINTSTS       0x044
+#define W_STATUS        0x048
+#define W_FIFOTH        0x04c
+#define W_VERID         0x06c
+#define W_HCON          0x070
+#define W_CLKSEL        0x09c           /* Exynos: sample [2:0], drive [18:16], divider [26:24] */
+
+#define I_RESP_ERR      (1u << 1)
+#define I_CMD_DONE      (1u << 2)
+#define I_DATA_OVER     (1u << 3)
+#define I_TXDR          (1u << 4)
+#define I_RXDR          (1u << 5)
+#define I_RCRC          (1u << 6)
+#define I_DCRC          (1u << 7)
+#define I_RTO           (1u << 8)
+#define I_DRTO          (1u << 9)
+#define I_HTO           (1u << 10)
+#define I_FRUN          (1u << 11)
+#define I_HLE           (1u << 12)
+#define I_SBE           (1u << 13)
+#define I_EBE           (1u << 15)
+#define I_CMD_ERR       (I_RESP_ERR | I_RCRC | I_RTO | I_HLE)
+#define I_DATA_ERR      (I_DCRC | I_DRTO | I_FRUN | I_SBE | I_EBE)
+
+#define C_START         (1u << 31)
+#define C_USE_HOLD      (1u << 29)
+#define C_UPD_CLK       (1u << 21)
+#define C_SEND_INIT     (1u << 15)
+#define C_PRV_WAIT      (1u << 13)
+#define C_DAT_WR        (1u << 10)
+#define C_DAT_EXP       (1u << 9)
+#define C_RESP_CRC      (1u << 8)
+#define C_RESP_EXP      (1u << 6)
+
+static struct {
+	vm_offset_t top, fsys, pfsys, ptop, mmc;
+	uint32_t data_off, fifo_bytes;
+	int after_s;
+} w;
+
+static inline uint32_t
+rd(vm_offset_t b, uint32_t o)
+{
+	return *(volatile uint32_t *)(b + o);
+}
+
+static inline void
+wr(vm_offset_t b, uint32_t o, uint32_t v)
+{
+	*(volatile uint32_t *)(b + o) = v;
+}
+
+static void
+field(vm_offset_t b, uint32_t o, unsigned shift, unsigned width, uint32_t v)
+{
+	uint32_t m = ((1u << width) - 1u) << shift;
+	wr(b, o, (rd(b, o) & ~m) | ((v << shift) & m));
+}
+
+static uint64_t
+after_ms(uint32_t ms)
+{
+	uint64_t abs;
+	nanoseconds_to_absolutetime((uint64_t)ms * NSEC_PER_MSEC, &abs);
+	return mach_absolute_time() + abs;
+}
+
+static bool
+wait_clear(uint32_t off, uint32_t bits, uint32_t ms)
+{
+	uint64_t end = after_ms(ms);
+	while (rd(w.mmc, off) & bits) {
+		if (mach_absolute_time() > end) {
+			return false;
+		}
+	}
+	return true;
+}
+
+static int
+clk_update(void)
+{
+	wr(w.mmc, W_CMD, C_START | C_UPD_CLK | C_PRV_WAIT);
+	return wait_clear(W_CMD, C_START, 100) ? 0 : ETIMEDOUT;
+}
+
+/* one command; *resp = RESP0; ETIMEDOUT (no response), EIO (CRC/response error) */
+static int
+cmd(uint32_t c, uint32_t arg, uint32_t *resp)
+{
+	wr(w.mmc, W_RINTSTS, I_CMD_DONE | I_CMD_ERR);
+	wr(w.mmc, W_CMDARG, arg);
+	wr(w.mmc, W_CMD, c | C_START | C_USE_HOLD);
+	if (!wait_clear(W_CMD, C_START, 100)) {
+		return EBUSY;
+	}
+	uint64_t end = after_ms(100);
+	uint32_t s;
+	while (!((s = rd(w.mmc, W_RINTSTS)) & (I_CMD_DONE | I_HLE))) {
+		if (mach_absolute_time() > end) {
+			return ETIMEDOUT;
+		}
+	}
+	wr(w.mmc, W_RINTSTS, s & (I_CMD_DONE | I_CMD_ERR));
+	if (resp != NULL) {
+		*resp = rd(w.mmc, W_RESP0);
+	}
+	if (s & I_RTO) {
+		return ETIMEDOUT;
+	}
+	return (s & I_CMD_ERR) ? EIO : 0;
+}
+
+/* CMD52: one byte of function fn at addr (write: data; *out: the byte the card returns) */
+static int
+cmd52(unsigned fn, uint32_t addr, bool write, uint8_t data, uint8_t *out)
+{
+	uint32_t arg = (write ? (1u << 31) : 0) | ((fn & 7u) << 28) | ((addr & 0x1ffffu) << 9) | data;
+	uint32_t r = 0;
+	int e = cmd(52 | C_RESP_EXP | C_RESP_CRC | C_PRV_WAIT, arg, &r);
+	if (e == 0 && (((r >> 8) & 0xcbu) != 0)) {
+		e = EIO;                                /* R5 flags: CRC, illegal, error, function, range */
+	}
+	if (out != NULL) {
+		*out = (uint8_t)r;
+	}
+	return e;
+}
+
+/* CMD53 byte mode read of n (<= 64) bytes of function fn at addr, incrementing */
+static int
+cmd53_read(unsigned fn, uint32_t addr, uint8_t *buf, uint32_t n)
+{
+	if (!wait_clear(W_STATUS, 1u << 9, 100)) {
+		return EBUSY;
+	}
+	wr(w.mmc, W_CTRL, rd(w.mmc, W_CTRL) | 2u);  /* FIFO reset */
+	if (!wait_clear(W_CTRL, 2u, 100)) {
+		return EBUSY;
+	}
+	wr(w.mmc, W_RINTSTS, 0xffffffffu);
+	wr(w.mmc, W_BLKSIZ, n);
+	wr(w.mmc, W_BYTCNT, n);
+	uint32_t arg = ((fn & 7u) << 28) | (1u << 26) | ((addr & 0x1ffffu) << 9) | (n & 0x1ffu);
+	wr(w.mmc, W_CMDARG, arg);
+	wr(w.mmc, W_CMD, 53 | C_RESP_EXP | C_RESP_CRC | C_DAT_EXP | C_PRV_WAIT | C_START | C_USE_HOLD);
+	if (!wait_clear(W_CMD, C_START, 100)) {
+		return EBUSY;
+	}
+	uint32_t got = 0, s = 0;
+	uint64_t end = after_ms(1000);
+	volatile uint8_t *fifo = (volatile uint8_t *)(w.mmc + w.data_off);
+	for (;;) {
+		s = rd(w.mmc, W_RINTSTS);
+		uint32_t cnt = (rd(w.mmc, W_STATUS) >> 17) & 0x1fffu;
+		while (cnt-- > 0 && got < n) {
+			uint32_t v[2] = {0, 0};
+			v[0] = *(volatile uint32_t *)fifo;
+			if (w.fifo_bytes == 8) {
+				v[1] = *(volatile uint32_t *)(fifo + 4);
+			}
+			for (uint32_t k = 0; k < w.fifo_bytes && got < n; k++) {
+				buf[got++] = ((uint8_t *)v)[k];
+			}
+		}
+		if (s & I_RXDR) {
+			wr(w.mmc, W_RINTSTS, I_RXDR);
+		}
+		if (s & (I_CMD_ERR | I_DATA_ERR)) {
+			printf("A510F WIFI: CMD53 fn %u addr 0x%x x%u: rintsts 0x%x, %u bytes, r5 0x%x status 0x%x\n", fn, addr, n, s, got,
+			    rd(w.mmc, W_RESP0), rd(w.mmc, W_STATUS));
+			return EIO;
+		}
+		if ((s & I_DATA_OVER) && got >= n) {
+			return 0;
+		}
+		if (mach_absolute_time() > end) {
+			printf("A510F WIFI: CMD53 fn %u addr 0x%x x%u timed out: rintsts 0x%x, %u bytes, r5 0x%x status 0x%x\n", fn, addr, n, s,
+			    got, rd(w.mmc, W_RESP0), rd(w.mmc, W_STATUS));
+			return ETIMEDOUT;
+		}
+	}
+}
+
+/* CMD53 byte mode write of n (<= 64) bytes to function fn at addr, incrementing (Linux order: command, then FIFO) */
+static int
+cmd53_write(unsigned fn, uint32_t addr, const uint8_t *buf, uint32_t n)
+{
+	if (!wait_clear(W_STATUS, 1u << 9, 100)) {
+		return EBUSY;
+	}
+	wr(w.mmc, W_CTRL, rd(w.mmc, W_CTRL) | 2u);  /* FIFO reset */
+	if (!wait_clear(W_CTRL, 2u, 100)) {
+		return EBUSY;
+	}
+	wr(w.mmc, W_RINTSTS, 0xffffffffu);
+	wr(w.mmc, W_BLKSIZ, n);
+	wr(w.mmc, W_BYTCNT, n);
+	uint32_t arg = (1u << 31) | ((fn & 7u) << 28) | (1u << 26) | ((addr & 0x1ffffu) << 9) | (n & 0x1ffu);
+	wr(w.mmc, W_CMDARG, arg);
+	wr(w.mmc, W_CMD, 53 | C_RESP_EXP | C_RESP_CRC | C_DAT_EXP | C_DAT_WR | C_PRV_WAIT | C_START | C_USE_HOLD);
+	if (!wait_clear(W_CMD, C_START, 100)) {
+		return EBUSY;
+	}
+	uint32_t put = 0, s = 0;
+	uint64_t end = after_ms(1000);
+	volatile uint8_t *fifo = (volatile uint8_t *)(w.mmc + w.data_off);
+	for (;;) {
+		s = rd(w.mmc, W_RINTSTS);
+		if (put < n) {
+			uint32_t used = (rd(w.mmc, W_STATUS) >> 17) & 0x1fffu;
+			uint32_t room = used < 64u ? 64u - used : 0;
+			while (room-- > 0 && put < n) {
+				uint32_t v[2] = {0, 0};
+				uint32_t c = n - put < w.fifo_bytes ? n - put : w.fifo_bytes;
+				memcpy(v, buf + put, c);
+				*(volatile uint32_t *)fifo = v[0];
+				if (w.fifo_bytes == 8) {
+					*(volatile uint32_t *)(fifo + 4) = v[1];
+				}
+				put += w.fifo_bytes;
+			}
+		}
+		if (s & I_TXDR) {
+			wr(w.mmc, W_RINTSTS, I_TXDR);
+		}
+		if (s & (I_CMD_ERR | I_DATA_ERR)) {
+			printf("A510F WIFI: CMD53 write fn %u addr 0x%x x%u: rintsts 0x%x, r5 0x%x\n", fn, addr, n, s, rd(w.mmc, W_RESP0));
+			return EIO;
+		}
+		if (s & I_DATA_OVER) {
+			return wait_clear(W_STATUS, 1u << 9, 100) ? 0 : EBUSY;
+		}
+		if (mach_absolute_time() > end) {
+			printf("A510F WIFI: CMD53 write fn %u addr 0x%x x%u timed out: rintsts 0x%x\n", fn, addr, n, s);
+			return ETIMEDOUT;
+		}
+	}
+}
+
+/* backplane: 32 KiB window (SBADDR low/mid/high), 4-byte accesses at +0x8000 */
+static uint32_t bp_win = 0xffffffffu;
+
+static int
+bp_window(uint32_t addr)
+{
+	uint32_t win = addr & 0xffff8000u;
+	if (win == bp_win) {
+		return 0;
+	}
+	int e = cmd52(1, 0x1000a, true, (uint8_t)((win >> 8) & 0x80u), NULL);
+	e |= cmd52(1, 0x1000b, true, (uint8_t)(win >> 16), NULL);
+	e |= cmd52(1, 0x1000c, true, (uint8_t)(win >> 24), NULL);
+	bp_win = e == 0 ? win : 0xffffffffu;
+	return e;
+}
+
+static int
+bp_read32(uint32_t addr, uint32_t *v)
+{
+	uint8_t b[4] = {0, 0, 0, 0};
+	int e = bp_window(addr);
+	if (e == 0) {
+		e = cmd53_read(1, (addr & 0x7fffu) | 0x8000u, b, 4);
+	}
+	*v = (uint32_t)b[0] | ((uint32_t)b[1] << 8) | ((uint32_t)b[2] << 16) | ((uint32_t)b[3] << 24);
+	return e;
+}
+
+static int
+bp_write32(uint32_t addr, uint32_t v)
+{
+	uint8_t b[4] = {(uint8_t)v, (uint8_t)(v >> 8), (uint8_t)(v >> 16), (uint8_t)(v >> 24)};
+	int e = bp_window(addr);
+	return e != 0 ? e : cmd53_write(1, (addr & 0x7fffu) | 0x8000u, b, 4);
+}
+
+extern int a510f_mmc_read(const char *part, uint64_t lba, uint32_t nsect, void *dst);   /* sweet_mmc.c */
+
+/*
+ * Step 2a: the chip's cores (EROM), the ARM CR4's RAM, and the firmware and
+ * network written by twrp-write/auto.py wifi: the blob is in the last MiB of
+ * the sweetgl region (4 KiB block 2268198 = LBA 18145584), the network in OTA
+ * sector 100. The passphrase is never logged.
+ */
+#define WIFI_BLOB_LBA   18145584ull
+#define WIFI_BLOB_SECT  2048u
+#define CC_BASE         0x18000000u
+#define CORE_CR4        0x83eu
+#define CORE_SDIO       0x829u
+#define WRAP_IOCTL_EARLY        0x408u  /* AI wrapper registers (see step 2b) */
+#define WRAP_RESETCTL_EARLY     0x800u
+
+static struct {
+	uint32_t cr4_base, cr4_wrap, sdio_base, sdio_wrap, ram_size;
+	uint32_t d11_wrap;                      /* 802.11 core (0x812) wrapper: PHY held in reset while the ARM is halted */
+	int fw_ok;                              /* blob sum matched */
+	uint8_t *blob;
+	uint32_t fw_len, nv_len;
+	char ssid[33];
+	char pass[65];
+} w2;
+
+static void
+wifi_step2a(void)
+{
+	uint32_t id = 0, erom = 0;
+	int e = bp_read32(CC_BASE, &id);
+	e |= bp_read32(CC_BASE + 0xfc, &erom);
+	printf("A510F WIFI: chipid 0x%08x (chip 0x%x rev %u), EROM at 0x%x (%d)\n", id, id & 0xffffu, (id >> 16) & 0xfu, erom, e);
+	if (e != 0) {
+		return;
+	}
+	/* EROM: component (CIA, CIB), then master port / address descriptors, EOT 0xf */
+	uint32_t a = erom, core = 0, rev = 0, base = 0, wrap = 0;
+	int ncores = 0;
+	{
+		/* round 71: round 70 found no cores: the raw table first */
+		uint32_t raw[16];
+		int er = 0;
+		for (int k = 0; k < 16; k++) {
+			raw[k] = 0;
+			er |= bp_read32(erom + 4u * (uint32_t)k, &raw[k]);
+		}
+		printf("A510F WIFI: EROM (%d): %08x %08x %08x %08x %08x %08x %08x %08x  %08x %08x %08x %08x %08x %08x %08x %08x\n",
+		    er, raw[0], raw[1], raw[2], raw[3], raw[4], raw[5], raw[6], raw[7], raw[8], raw[9], raw[10], raw[11], raw[12],
+		    raw[13], raw[14], raw[15]);
+	}
+	for (int k = 0; k < 400; k++) {
+		uint32_t v = 0;
+		int er = bp_read32(a, &v);
+		if (er != 0) {
+			printf("A510F WIFI: EROM read at 0x%x failed (%d) after %d words\n", a, er, k);
+			break;
+		}
+		a += 4;
+		uint32_t type = v & 0xfu;
+		if (type == 0xfu) {
+			printf("A510F WIFI: EROM end at word %d\n", k);
+		}
+		if (type == 0xfu || type == 0x1u) {
+			if (core != 0) {
+				printf("A510F WIFI: core 0x%03x rev %u base 0x%08x wrap 0x%08x\n", core, rev, base, wrap);
+				if (core == CORE_CR4 && w2.cr4_base == 0) {
+					w2.cr4_base = base;
+					w2.cr4_wrap = wrap;
+				}
+				if (core == CORE_SDIO && w2.sdio_base == 0) {
+					w2.sdio_base = base;
+					w2.sdio_wrap = wrap;
+				}
+				if (core == 0x812u && w2.d11_wrap == 0) {
+					w2.d11_wrap = wrap;
+				}
+				ncores++;
+			}
+			core = rev = base = wrap = 0;
+			if (type == 0xfu) {
+				break;
+			}
+			uint32_t cib = 0;
+			if (bp_read32(a, &cib) != 0) {
+				break;
+			}
+			a += 4;
+			core = (v >> 8) & 0xfffu;
+			rev = cib >> 24;
+		} else if (type == 0x5u) {
+			uint32_t stype = (v >> 6) & 3u, sz = (v >> 4) & 3u;
+			if (v & 0x8u) {
+				a += 4;                         /* 64-bit address: high word */
+			}
+			if (sz == 3u) {
+				uint32_t sd = 0;
+				(void)bp_read32(a, &sd);
+				a += (sd & 0x8u) ? 8 : 4;       /* size descriptor (+ high word) */
+			}
+			if (stype == 0 && base == 0) {
+				base = v & 0xfffff000u;
+			} else if ((stype == 2 || stype == 3) && wrap == 0) {
+				wrap = v & 0xfffff000u;
+			}
+		}
+	}
+	/*
+	 * Round 72: the EROM pointer (0x1810a000) read like wrapper registers.
+	 * Map the 16 wrapper slots (IOCTL, RESET_CTL) and core bases (+0, +4),
+	 * then, if the scan found no CR4, try the layout brcmfmac logs show for
+	 * this family (4339 / 4359 / 43456: CR4 0x18002000 wrap 0x18102000,
+	 * 802.11 0x18001000 wrap 0x18101000, SDIO 0x18004000 wrap 0x18104000),
+	 * kept only if the CR4's corecap reads as a plausible bank count.
+	 */
+	for (uint32_t n = 0; n < 16; n += 4) {
+		uint32_t io[4], rc[4], c0[4], c4[4];
+		for (uint32_t j = 0; j < 4; j++) {
+			io[j] = rc[j] = c0[j] = c4[j] = 0xdeadbeefu;
+			(void)bp_read32(0x18100000u + (n + j) * 0x1000u + WRAP_IOCTL_EARLY, &io[j]);
+			(void)bp_read32(0x18100000u + (n + j) * 0x1000u + WRAP_RESETCTL_EARLY, &rc[j]);
+			(void)bp_read32(0x18000000u + (n + j) * 0x1000u, &c0[j]);
+			(void)bp_read32(0x18000000u + (n + j) * 0x1000u + 4u, &c4[j]);
+		}
+		printf("A510F WIFI: slots %2u-%2u: io %x %x %x %x, reset %x %x %x %x, core+0 %x %x %x %x, core+4 %x %x %x %x\n",
+		    n, n + 3, io[0], io[1], io[2], io[3], rc[0], rc[1], rc[2], rc[3], c0[0], c0[1], c0[2], c0[3], c4[0], c4[1], c4[2], c4[3]);
+	}
+	if (w2.cr4_base == 0) {
+		uint32_t cap = 0;
+		(void)bp_read32(0x18002004u, &cap);
+		uint32_t banks = (cap & 0xfu) + ((cap >> 4) & 0xfu);
+		printf("A510F WIFI: guess CR4 at 0x18002000: corecap 0x%x (%u banks)\n", cap, banks);
+		if (banks >= 1u && banks <= 16u && cap != 0xffffffffu) {
+			w2.cr4_base = 0x18002000u;
+			w2.cr4_wrap = 0x18102000u;
+			w2.d11_wrap = 0x18101000u;
+			w2.sdio_base = 0x18004000u;
+			w2.sdio_wrap = 0x18104000u;
+		}
+	}
+	printf("A510F WIFI: %d cores; ARM CR4 at 0x%x (wrap 0x%x), SDIO core at 0x%x (wrap 0x%x)\n", ncores, w2.cr4_base, w2.cr4_wrap,
+	    w2.sdio_base, w2.sdio_wrap);
+	if (w2.cr4_base != 0) {
+		uint32_t cap = 0;
+		(void)bp_read32(w2.cr4_base + 0x04, &cap);
+		uint32_t nab = cap & 0xfu, nbb = (cap >> 4) & 0xfu;
+		w2.ram_size = 0;
+		for (uint32_t i = 0; i < nab + nbb && i < 16; i++) {
+			uint32_t bx = 0;
+			(void)bp_write32(w2.cr4_base + 0x40, i);
+			(void)bp_read32(w2.cr4_base + 0x44, &bx);
+			w2.ram_size += ((bx & 0x7fu) + 1u) * ((bx & 0x200u) ? 1024u : 8192u);
+		}
+		printf("A510F WIFI: CR4 corecap 0x%x (%u+%u banks): RAM 0x198000, %u KiB\n", cap, nab, nbb, w2.ram_size / 1024u);
+	}
+
+	/* the firmware blob and the network, from the eMMC */
+	w2.blob = kalloc_data((vm_size_t)WIFI_BLOB_SECT * 512u, Z_WAITOK | Z_ZERO);
+	e = w2.blob != NULL ? a510f_mmc_read(NULL, WIFI_BLOB_LBA, WIFI_BLOB_SECT, w2.blob) : ENOMEM;
+	if (e == 0 && memcmp(w2.blob, "SWWIFI01", 8) == 0) {
+		uint32_t sum = 0, want = 0;
+		memcpy(&w2.fw_len, w2.blob + 8, 4);
+		memcpy(&w2.nv_len, w2.blob + 12, 4);
+		memcpy(&want, w2.blob + 16, 4);
+		uint32_t fw_pad = (w2.fw_len + 511u) & ~511u;
+		if (512u + fw_pad + w2.nv_len <= WIFI_BLOB_SECT * 512u) {
+			for (uint32_t i = 0; i < w2.fw_len; i++) {
+				sum += w2.blob[512 + i];
+			}
+			for (uint32_t i = 0; i < w2.nv_len; i++) {
+				sum += w2.blob[512 + fw_pad + i];
+			}
+		}
+		printf("A510F WIFI: firmware %u bytes, NVRAM %u bytes, sum 0x%x (%s)\n", w2.fw_len, w2.nv_len, sum,
+		    sum == want ? "OK" : "BAD");
+		w2.fw_ok = sum == want && w2.fw_len > 4;
+	} else {
+		printf("A510F WIFI: no firmware blob (read %d)\n", e);
+	}
+	uint8_t *sec = kalloc_data(512, Z_WAITOK | Z_ZERO);
+	e = sec != NULL ? a510f_mmc_read("OTA", 100, 1, sec) : ENOMEM;
+	if (e == 0 && memcmp(sec, "SWNET001", 8) == 0 && sec[8] >= 1 && sec[8] <= 32 && sec[41] >= 8 && sec[41] <= 63) {
+		memcpy(w2.ssid, sec + 9, sec[8]);
+		w2.ssid[sec[8]] = 0;
+		memcpy(w2.pass, sec + 42, sec[41]);
+		w2.pass[sec[41]] = 0;
+		printf("A510F WIFI: network \"%s\" (passphrase %u characters)\n", w2.ssid, sec[41]);
+	} else {
+		printf("A510F WIFI: no network in OTA sector 100 (read %d)\n", e);
+	}
+	if (sec != NULL) {
+		bzero(sec, 512);
+		kfree_data(sec, 512);
+	}
+	printf("A510F WIFI: step 2a done\n");
+}
+
+/*
+ * Step 2b: firmware download and start (brcmfmac chip.c / sdio.c for an ARM
+ * CR4 chip): halt the CR4 (wrapper IOCTL 0x408 CPUHALT 0x20, RESET_CTL 0x800),
+ * hold the 802.11 PHY in reset, write the firmware to RAM at 0x198000 and the
+ * NVRAM (key=value strings, NUL-separated, 4-byte padded, then the length
+ * token (~words << 16 | words)) to the end of RAM, the reset vector (the
+ * firmware's first word) to address 0, release the CR4, request the HT clock,
+ * enable function 2 and read what the firmware says (mailbox, sdpcm_shared).
+ */
+#define WRAP_IOCTL      0x408u
+#define WRAP_RESETCTL   0x800u
+#define IOCTL_CLK       0x1u
+#define IOCTL_FGC       0x2u
+#define CR4_CPUHALT     0x20u
+#define RAM_BASE        0x198000u
+
+extern void delay(int usec);
+
+static void
+core_disable(uint32_t wrap, uint32_t pre, uint32_t reset)
+{
+	uint32_t v = 0;
+	(void)bp_read32(wrap + WRAP_RESETCTL, &v);
+	if (!(v & 1u)) {
+		(void)bp_write32(wrap + WRAP_IOCTL, pre | IOCTL_FGC | IOCTL_CLK);
+		(void)bp_read32(wrap + WRAP_IOCTL, &v);
+		(void)bp_write32(wrap + WRAP_RESETCTL, 1);
+		delay(20);
+		for (int i = 0; i < 30; i++) {
+			(void)bp_read32(wrap + WRAP_RESETCTL, &v);
+			if (v == 1u) {
+				break;
+			}
+			delay(10);
+		}
+	}
+	(void)bp_write32(wrap + WRAP_IOCTL, reset | IOCTL_FGC | IOCTL_CLK);
+	(void)bp_read32(wrap + WRAP_IOCTL, &v);
+}
+
+static void
+core_reset(uint32_t wrap, uint32_t pre, uint32_t reset, uint32_t post)
+{
+	uint32_t v = 0;
+	core_disable(wrap, pre, reset);
+	for (int i = 0; i < 50; i++) {
+		(void)bp_read32(wrap + WRAP_RESETCTL, &v);
+		if (!(v & 1u)) {
+			break;
+		}
+		(void)bp_write32(wrap + WRAP_RESETCTL, 0);
+		delay(50);
+	}
+	(void)bp_write32(wrap + WRAP_IOCTL, post | IOCTL_CLK);
+	(void)bp_read32(wrap + WRAP_IOCTL, &v);
+}
+
+/* chip memory: CMD53 writes of up to 64 bytes, never across a 32 KiB window */
+static int
+bp_write_mem(uint32_t addr, const uint8_t *buf, uint32_t len)
+{
+	uint32_t off = 0;
+	while (off < len) {
+		uint32_t a = addr + off, c = len - off;
+		if (c > 64u) {
+			c = 64u;
+		}
+		if (c > 0x8000u - (a & 0x7fffu)) {
+			c = 0x8000u - (a & 0x7fffu);
+		}
+		int e = bp_window(a);
+		if (e == 0) {
+			e = cmd53_write(1, (a & 0x7fffu) | 0x8000u, buf + off, c);
+		}
+		if (e != 0) {
+			printf("A510F WIFI: memory write at 0x%x failed (%d) after %u bytes\n", a, e, off);
+			return e;
+		}
+		off += c;
+	}
+	return 0;
+}
+
+static int
+bp_read_mem(uint32_t addr, uint8_t *buf, uint32_t len)
+{
+	uint32_t off = 0;
+	while (off < len) {
+		uint32_t a = addr + off, c = len - off;
+		if (c > 64u) {
+			c = 64u;
+		}
+		if (c > 0x8000u - (a & 0x7fffu)) {
+			c = 0x8000u - (a & 0x7fffu);
+		}
+		int e = bp_window(a);
+		if (e == 0) {
+			e = cmd53_read(1, (a & 0x7fffu) | 0x8000u, buf + off, c);
+		}
+		if (e != 0) {
+			return e;
+		}
+		off += c;
+	}
+	return 0;
+}
+
+/* the NVRAM text as the firmware wants it; macaddr replaced (a locally administered address) */
+static uint8_t *
+nvram_build(const uint8_t *txt, uint32_t n, uint32_t *out_len)
+{
+	uint32_t cap = n + 64u;
+	uint8_t *o = kalloc_data(cap, Z_WAITOK | Z_ZERO);
+	if (o == NULL) {
+		return NULL;
+	}
+	uint32_t p = 0, i = 0;
+	while (i < n) {
+		uint32_t s = i, e = i;
+		while (e < n && txt[e] != '\n') {
+			e++;
+		}
+		i = e + 1;
+		while (s < e && (txt[s] == ' ' || txt[s] == '\t')) {
+			s++;
+		}
+		while (e > s && (txt[e - 1] == '\r' || txt[e - 1] == ' ' || txt[e - 1] == '\t')) {
+			e--;
+		}
+		if (e == s || txt[s] == '#') {
+			continue;
+		}
+		bool eq = false;
+		for (uint32_t k = s; k < e; k++) {
+			eq |= txt[k] == '=';
+		}
+		if (!eq) {
+			continue;
+		}
+		const char *mac = "macaddr=02:a5:10:f0:0b:3c";
+		if (e - s > 8 && memcmp(txt + s, "macaddr=", 8) == 0) {
+			size_t ml = strlen(mac);
+			if (p + ml + 1 < cap) {
+				memcpy(o + p, mac, ml);
+				p += (uint32_t)ml + 1u;
+			}
+			continue;
+		}
+		if (p + (e - s) + 1 < cap) {
+			memcpy(o + p, txt + s, e - s);
+			p += (e - s) + 1u;
+		}
+	}
+	p += 1;                                 /* final NUL */
+	p = (p + 3u) & ~3u;
+	uint32_t words = p / 4u, token = (~words << 16) | (words & 0xffffu);
+	if (p + 4u > cap) {
+		kfree_data(o, cap);
+		return NULL;
+	}
+	memcpy(o + p, &token, 4);
+	*out_len = p + 4u;
+	return o;
+}
+
+static void
+wifi_step2b(void)
+{
+	if (w2.cr4_wrap == 0 || w2.sdio_base == 0 || w2.ram_size == 0 || !w2.fw_ok) {
+		printf("A510F WIFI: step 2b skipped (cr4 wrap 0x%x, sdio 0x%x, ram %u, firmware %d)\n", w2.cr4_wrap, w2.sdio_base,
+		    w2.ram_size, w2.fw_ok);
+		return;
+	}
+	uint64_t t0 = mach_absolute_time();
+	/* halt the ARM (out of reset, clock on, CPUHALT), PHY in reset */
+	uint32_t ioctl = 0;
+	(void)bp_read32(w2.cr4_wrap + WRAP_IOCTL, &ioctl);
+	core_reset(w2.cr4_wrap, ioctl & CR4_CPUHALT, CR4_CPUHALT, CR4_CPUHALT);
+	if (w2.d11_wrap != 0) {
+		core_disable(w2.d11_wrap, 0x8u | 0x4u, 0x4u);
+	}
+	(void)bp_read32(w2.cr4_wrap + WRAP_IOCTL, &ioctl);
+	printf("A510F WIFI: CR4 halted: ioctl 0x%x\n", ioctl);
+
+	/* firmware */
+	const uint8_t *fw = w2.blob + 512;
+	int e = bp_write_mem(RAM_BASE, fw, w2.fw_len);
+	uint8_t chk[64];
+	int bad = 0;
+	if (e == 0) {
+		uint32_t at[3] = {0, w2.fw_len / 2u & ~63u, (w2.fw_len - 64u) & ~3u};
+		for (int k = 0; k < 3; k++) {
+			if (bp_read_mem(RAM_BASE + at[k], chk, 64) != 0 || memcmp(chk, fw + at[k], 64) != 0) {
+				bad |= 1 << k;
+			}
+		}
+	}
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	printf("A510F WIFI: firmware %u bytes written (%d) in %llu ms, read-back spots %s (0x%x)\n", w2.fw_len, e,
+	    ns / 1000000ull, bad ? "DIFFER" : "match", bad);
+	if (e != 0 || bad) {
+		return;
+	}
+
+	/* NVRAM at the end of RAM */
+	uint32_t fw_pad = (w2.fw_len + 511u) & ~511u, nvl = 0;
+	uint8_t *nv = nvram_build(w2.blob + 512 + fw_pad, w2.nv_len, &nvl);
+	if (nv == NULL) {
+		printf("A510F WIFI: NVRAM build failed\n");
+		return;
+	}
+	uint32_t nva = RAM_BASE + w2.ram_size - nvl;
+	e = bp_write_mem(nva, nv, nvl);
+	printf("A510F WIFI: NVRAM %u bytes at 0x%x (%d)\n", nvl, nva, e);
+	kfree_data(nv, w2.nv_len + 64u);
+	if (e != 0) {
+		return;
+	}
+
+	/* clear SDIO core interrupts, reset vector to address 0, CPU on */
+	uint32_t rstvec = 0;
+	memcpy(&rstvec, fw, 4);
+	(void)bp_write32(w2.sdio_base + 0x20, 0xffffffffu);
+	e = bp_write32(0, rstvec);
+	core_reset(w2.cr4_wrap, CR4_CPUHALT, 0, 0);
+	(void)bp_read32(w2.cr4_wrap + WRAP_IOCTL, &ioctl);
+	printf("A510F WIFI: reset vector 0x%08x (%d), CR4 released: ioctl 0x%x\n", rstvec, e, ioctl);
+
+	/* HT clock (HT_AVAIL_REQ 0x10, wait HT_AVAIL 0x80) */
+	(void)cmd52(1, 0x1000e, true, 0x10, NULL);
+	uint8_t csr = 0;
+	int ms = 0;
+	for (; ms < 1000; ms += 5) {
+		(void)cmd52(1, 0x1000e, false, 0, &csr);
+		if ((csr & 0xc0u) == 0xc0u) {
+			break;
+		}
+		IOSleep(5);
+	}
+	printf("A510F WIFI: HT clock csr 0x%x after %d ms\n", csr, ms);
+
+	/* function 2 */
+	uint8_t ioen = 0, iordy = 0;
+	(void)cmd52(0, 0x02, false, 0, &ioen);
+	(void)cmd52(0, 0x02, true, (uint8_t)(ioen | 0x04u), NULL);
+	for (ms = 0; ms < 3000; ms += 10) {
+		(void)cmd52(0, 0x03, false, 0, &iordy);
+		if (iordy & 0x04u) {
+			break;
+		}
+		IOSleep(10);
+	}
+	uint32_t mb = 0, shared = 0, inst = 0;
+	(void)bp_read32(w2.sdio_base + 0x4c, &mb);
+	(void)bp_read32(w2.sdio_base + 0x20, &inst);
+	(void)bp_read32(RAM_BASE + w2.ram_size - 4u, &shared);
+	printf("A510F WIFI: function 2 ready 0x%x after %d ms; mailbox 0x%x (fw ready %d, version %u), intstatus 0x%x, "
+	    "sdpcm_shared 0x%x\n", iordy, ms, mb, (mb & 0xau) != 0, (mb >> 16) & 0xffu, inst, shared);
+	printf("A510F WIFI: step 2b done\n");
+}
+
+static void
+wifi_step1(void)
+{
+	/* 1. clocks: the same source and dividers as mmc0 (S-Boot set those up), gates on */
+	printf("A510F WIFI: before: top mux 0x%x/0x%x div 0x%x/0x%x en_sclk_top_fsys 0x%x, fsys en_aclk0 0x%x en_sclk 0x%x, "
+	    "gpr2 con 0x%x pud 0x%x drv 0x%x, gpr3 con 0x%x, gpd1 con 0x%x dat 0x%x\n",
+	    rd(w.top, TOP_MUX_FSYS0), rd(w.top, TOP_MUX_FSYS1), rd(w.top, TOP_DIV_FSYS0), rd(w.top, TOP_DIV_FSYS1),
+	    rd(w.top, TOP_EN_SCLK_FSYS), rd(w.fsys, FSYS_EN_ACLK0), rd(w.fsys, FSYS_EN_SCLK),
+	    rd(w.pfsys, 0x40), rd(w.pfsys, 0x48), rd(w.pfsys, 0x4c), rd(w.pfsys, 0x60),
+	    rd(w.ptop, 0xe0), rd(w.ptop, 0xe4));
+	wr(w.top, TOP_MUX_FSYS1, rd(w.top, TOP_MUX_FSYS0));
+	wr(w.top, TOP_DIV_FSYS1, rd(w.top, TOP_DIV_FSYS0));
+	field(w.top, TOP_EN_SCLK_FSYS, 1, 1, 1);
+	field(w.fsys, FSYS_EN_ACLK0, 8, 1, 1);
+	field(w.fsys, FSYS_EN_SCLK, 6, 1, 1);
+	IOSleep(2);
+
+	/* 2. pins: SDIO function 2, pull-up on cmd/data, drive strength 3 */
+	for (unsigned p = 0; p < 2; p++) {
+		field(w.pfsys, 0x40, 4 * p, 4, 2);
+		field(w.pfsys, 0x48, 2 * p, 2, p == 0 ? 0 : 3);
+		field(w.pfsys, 0x4c, 4 * p, 4, 3);
+	}
+	for (unsigned p = 0; p < 4; p++) {
+		field(w.pfsys, 0x60, 4 * p, 4, 2);
+		field(w.pfsys, 0x68, 2 * p, 2, 3);
+		field(w.pfsys, 0x6c, 4 * p, 4, 3);
+	}
+
+	/* 3. power cycle the chip: WL_REG_ON low, then high (bcmdhd waits ~200 ms) */
+	field(w.ptop, 0xe0, 0, 4, 1);
+	field(w.ptop, 0xe4, 0, 1, 0);
+	IOSleep(20);
+	field(w.ptop, 0xe4, 0, 1, 1);
+	IOSleep(250);
+
+	/* 4. controller */
+	uint32_t verid = rd(w.mmc, W_VERID), hcon = rd(w.mmc, W_HCON);
+	w.data_off = (verid & 0xffffu) >= 0x240a ? 0x200 : 0x100;
+	w.fifo_bytes = ((hcon >> 7) & 7u) == 2 ? 8 : 4;
+	printf("A510F WIFI: mmc1 verid 0x%x hcon 0x%x (fifo %u-byte at +0x%x), ctrl 0x%x clkena 0x%x clksel 0x%x\n",
+	    verid, hcon, w.fifo_bytes, w.data_off, rd(w.mmc, W_CTRL), rd(w.mmc, W_CLKENA), rd(w.mmc, W_CLKSEL));
+	wr(w.mmc, W_CTRL, rd(w.mmc, W_CTRL) | 7u);
+	if (!wait_clear(W_CTRL, 7u, 200)) {
+		printf("A510F WIFI: controller reset stuck, ctrl 0x%x\n", rd(w.mmc, W_CTRL));
+		return;
+	}
+	wr(w.mmc, W_PWREN, 1);
+	wr(w.mmc, W_INTMASK, 0);
+	wr(w.mmc, W_RINTSTS, 0xffffffffu);
+	wr(w.mmc, W_TMOUT, 0xffffffffu);
+	wr(w.mmc, W_FIFOTH, (2u << 28) | (31u << 16) | 32u);
+	wr(w.mmc, W_CTYPE, 0);
+	wr(w.mmc, W_CLKSEL, (3u << 24) | 2u);       /* ciu / 4 (samsung,dw-mshc-ciu-div = 3), sample phase 2 */
+	wr(w.mmc, W_CLKENA, 0);
+	int e1 = clk_update();
+	wr(w.mmc, W_CLKDIV, 255);                   /* card clock = ciu / 510: a few hundred kHz */
+	wr(w.mmc, W_CLKSRC, 0);
+	int e2 = clk_update();
+	wr(w.mmc, W_CLKENA, 1);
+	int e3 = clk_update();
+	printf("A510F WIFI: card clock on (updates %d %d %d)\n", e1, e2, e3);
+	IOSleep(10);
+
+	/* 5. SDIO reset (CCCR 6 bit 3; may not answer), 80 clocks + CMD0, then CMD5 */
+	(void)cmd52(0, 0x06, true, 0x08, NULL);
+	int e0 = cmd(0 | C_SEND_INIT, 0, NULL);
+	uint32_t ocr = 0;
+	int e5 = cmd(5 | C_RESP_EXP, 0, &ocr);
+	printf("A510F WIFI: CMD0 %d, CMD5 %d ocr 0x%x (functions %u)\n", e0, e5, ocr, (ocr >> 28) & 7u);
+	if (e5 != 0) {
+		printf("A510F WIFI: no SDIO answer: rintsts 0x%x status 0x%x\n", rd(w.mmc, W_RINTSTS), rd(w.mmc, W_STATUS));
+		return;
+	}
+	uint32_t want = (ocr & 0x00ffff00u) != 0 ? (ocr & 0x00300000u ? 0x00300000u : ocr & 0x00ffff00u) : 0x00300000u;
+	int tries = 0;
+	do {
+		e5 = cmd(5 | C_RESP_EXP, want, &ocr);
+		if (e5 == 0 && (ocr & (1u << 31))) {
+			break;
+		}
+		IOSleep(10);
+	} while (++tries < 100);
+	printf("A510F WIFI: CMD5 0x%x: %d ocr 0x%x after %d tries\n", want, e5, ocr, tries);
+	if (!(ocr & (1u << 31))) {
+		return;
+	}
+	uint32_t r6 = 0, r1 = 0;
+	int e3c = cmd(3 | C_RESP_EXP | C_RESP_CRC, 0, &r6);
+	uint32_t rca = r6 >> 16;
+	int e7 = cmd(7 | C_RESP_EXP | C_RESP_CRC | C_PRV_WAIT, rca << 16, &r1);
+	printf("A510F WIFI: CMD3 %d rca 0x%x, CMD7 %d r1 0x%x\n", e3c, rca, e7, r1);
+	if (e3c != 0 || e7 != 0) {
+		return;
+	}
+
+	/* 6. CCCR */
+	uint8_t cccr[20];
+	int ecc = 0;
+	for (unsigned i = 0; i < 20; i++) {
+		cccr[i] = 0;
+		ecc |= cmd52(0, i, false, 0, &cccr[i]);
+	}
+	printf("A510F WIFI: CCCR (%d): %02x %02x %02x %02x %02x %02x %02x %02x  %02x %02x %02x %02x %02x %02x %02x %02x  %02x %02x %02x %02x\n",
+	    ecc, cccr[0], cccr[1], cccr[2], cccr[3], cccr[4], cccr[5], cccr[6], cccr[7], cccr[8], cccr[9], cccr[10], cccr[11],
+	    cccr[12], cccr[13], cccr[14], cccr[15], cccr[16], cccr[17], cccr[18], cccr[19]);
+
+	/* 7. CIS (function 0): manufacturer / card id tuple (0x20), with CMD52 only */
+	{
+		uint32_t cis = (uint32_t)cccr[9] | ((uint32_t)cccr[10] << 8) | ((uint32_t)cccr[11] << 16);
+		uint32_t a = cis;
+		for (int t = 0; t < 32 && a < cis + 512; t++) {
+			uint8_t code = 0, link = 0;
+			if (cmd52(0, a, false, 0, &code) != 0 || code == 0xff) {
+				break;
+			}
+			(void)cmd52(0, a + 1, false, 0, &link);
+			if (code == 0x20 && link >= 4) {
+				uint8_t m[4] = {0, 0, 0, 0};
+				for (unsigned b = 0; b < 4; b++) {
+					(void)cmd52(0, a + 2 + b, false, 0, &m[b]);
+				}
+				printf("A510F WIFI: CIS at 0x%x: manufacturer 0x%02x%02x, card 0x%02x%02x\n", cis, m[1], m[0], m[3], m[2]);
+			}
+			a += 2u + link;
+		}
+	}
+
+	/* 8. function 1 on, block size 64 */
+	(void)cmd52(0, 0x02, true, 0x02, NULL);
+	uint8_t rdy = 0;
+	tries = 0;
+	do {
+		(void)cmd52(0, 0x03, false, 0, &rdy);
+		if (rdy & 0x02) {
+			break;
+		}
+		IOSleep(10);
+	} while (++tries < 100);
+	(void)cmd52(0, 0x110, true, 64, NULL);
+	(void)cmd52(0, 0x111, true, 0, NULL);
+	printf("A510F WIFI: function 1 ready 0x%x after %d tries\n", rdy, tries);
+	if (!(rdy & 0x02)) {
+		return;
+	}
+
+	/* 9. backplane: ALP clock (CHIPCLKCSR 0x1000e: FORCE_HW_CLKREQ_OFF | ALP_AVAIL_REQ, wait ALP_AVAIL 0x40) */
+	(void)cmd52(1, 0x1000e, true, 0x28, NULL);
+	uint8_t csr = 0;
+	tries = 0;
+	do {
+		(void)cmd52(1, 0x1000e, false, 0, &csr);
+		if (csr & 0x40) {
+			break;
+		}
+		IOSleep(1);
+	} while (++tries < 200);
+	/* keep ALP forced (brcmfmac: FORCE_HW_CLKREQ_OFF | FORCE_ALP); 0x20 alone dropped it and the backplane hung */
+	(void)cmd52(1, 0x1000e, true, 0x21, NULL);
+	printf("A510F WIFI: chip clock csr 0x%x after %d ms\n", csr, tries);
+
+	/* 10. ChipCommon chip id: window 0x18000000 (SBADDR low/mid/high), 4-byte access at +0x8000 */
+	(void)cmd52(1, 0x1000a, true, 0x00, NULL);
+	(void)cmd52(1, 0x1000b, true, 0x00, NULL);
+	(void)cmd52(1, 0x1000c, true, 0x18, NULL);
+	/* 10a. the chip id byte by byte (CMD52 into the window, no 4-byte flag) */
+	uint8_t cb[4] = {0, 0, 0, 0};
+	int e52 = 0;
+	for (unsigned b = 0; b < 4; b++) {
+		e52 |= cmd52(1, b, false, 0, &cb[b]);
+	}
+	uint32_t v = (uint32_t)cb[0] | ((uint32_t)cb[1] << 8) | ((uint32_t)cb[2] << 16) | ((uint32_t)cb[3] << 24);
+	printf("A510F WIFI: chipid by CMD52 (%d) 0x%08x: chip 0x%x (%u) rev %u, package %u, %u cores\n",
+	    e52, v, v & 0xffffu, v & 0xffffu, (v >> 16) & 0xfu, (v >> 20) & 0xfu, (v >> 24) & 0xfu);
+	/* 10b. the same with CMD53 (4 bytes, 4-byte access flag), 1-bit bus */
+	uint8_t id[4] = {0, 0, 0, 0};
+	int eid = cmd53_read(1, 0x8000, id, 4);
+	v = (uint32_t)id[0] | ((uint32_t)id[1] << 8) | ((uint32_t)id[2] << 16) | ((uint32_t)id[3] << 24);
+	printf("A510F WIFI: chipid by CMD53, 1-bit (%d) 0x%08x\n", eid, v);
+
+	/* 11. 4-bit bus, then CMD53 again */
+	uint8_t bic = 0;
+	if (cmd52(0, 0x07, false, 0, &bic) == 0 && cmd52(0, 0x07, true, (uint8_t)((bic & ~3u) | 2u), NULL) == 0) {
+		wr(w.mmc, W_CTYPE, 1);
+	}
+	uint8_t chk = 0;
+	int ebw = cmd52(0, 0x07, false, 0, &chk);
+	printf("A510F WIFI: bus interface 0x%x -> 0x%x (%d), 4-bit\n", bic, chk, ebw);
+	id[0] = id[1] = id[2] = id[3] = 0;
+	eid = cmd53_read(1, 0x8000, id, 4);
+	v = (uint32_t)id[0] | ((uint32_t)id[1] << 8) | ((uint32_t)id[2] << 16) | ((uint32_t)id[3] << 24);
+	printf("A510F WIFI: chipid by CMD53, 4-bit (%d) 0x%08x\n", eid, v);
+	printf("A510F WIFI: step 1 done\n");
+	wifi_step2a();
+	wifi_step2b();
+}
+
+static void
+wifi_thread(__unused void *arg, __unused wait_result_t wr_)
+{
+	IOSleep((unsigned)w.after_s * 1000u);
+	printf("A510F WIFI: step 1 (SDIO bring-up, chip id) at %d s\n", w.after_s);
+	wifi_step1();
+	thread_terminate(current_thread());
+}
+
+void
+a510f_wifi_start(void)
+{
+	w.after_s = 0;
+	PE_parse_boot_argn("a510fwifi", &w.after_s, sizeof(w.after_s));
+	if (w.after_s <= 0) {
+		return;
+	}
+	w.top = ml_io_map(CMU_TOP_PA, 0x1000);
+	w.fsys = ml_io_map(CMU_FSYS_PA, 0x1000);
+	w.pfsys = ml_io_map(PIN_FSYS_PA, 0x1000);
+	w.ptop = ml_io_map(PIN_TOP_PA, 0x1000);
+	w.mmc = ml_io_map(MMC1_PA, 0x2000);
+	thread_t th;
+	if (kernel_thread_start(wifi_thread, NULL, &th) == KERN_SUCCESS) {
+		thread_deallocate(th);
+	}
+}
