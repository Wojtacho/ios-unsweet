+/*
+ * A510F Wi-Fi, step 1: Broadcom BCM43454 on SDIO.
+ *
+ * Samsung's a5xelte device tree: the chip sits on DW-MMC channel 1
+ * (0x13550000, SPI 246, 4-bit, fifo depth 64), pins gpr2-0 clk / gpr2-1 cmd
+ * / gpr3-0..3 data (function 2, FSYS pinctrl 0x13750000), WL_REG_ON on
+ * gpd1-0 (WLAN_EN, TOP pinctrl 0x139C0000). Clocks (clk-exynos7580.c):
+ * aclk_mmc1 = CMU_FSYS EN_ACLK_FSYS0 bit 8, sclk_mmc1_sdclkin = CMU_FSYS
+ * EN_SCLK_FSYS bit 6, sclk_fsys_mmc1 = CMU_TOP EN_SCLK_TOP_FSYS bit 1,
+ * mux/div CMU_TOP 0x224 / 0x624 (mmc0: 0x220 / 0x620).
+ *
+ * Step 1 only: clocks on (before any MMC1 register access: a gated block
+ * can hang the bus), pins, power the chip, enumerate the SDIO card
+ * (CMD5/CMD3/CMD7), read CCCR, enable function 1, request the ALP clock and
+ * read the chip id from ChipCommon (backplane 0x18000000) with CMD53.
+ * Everything goes to the log as "A510F WIFI:". Nothing else uses the chip.
+ * Boot-arg a510fwifi=N: run N seconds after start (unset or 0: off).
+ */
+
+#include <pexpert/arm64/board_config.h>
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/locks.h>
+#include <kern/sched_prim.h>
+#include <kern/kalloc.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <sys/socket.h>
+#include <sys/sockio.h>
+#include <sys/kpi_mbuf.h>
+#include <sys/kpi_socket.h>
+#include <net/if.h>
+#include <net/if_types.h>
+#include <net/if_dl.h>
+#include <net/if_ether.h>
+#include <net/kpi_interface.h>
+#include <net/route.h>
+#include <net/bpf.h>
+#include <netinet/in.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void IOSleep(unsigned int milliseconds);
+extern kern_return_t thread_terminate(thread_t);
+
+void a510f_wifi_start(void);
+
+#define CMU_TOP_PA      0x10010000u
+#define CMU_FSYS_PA     0x13730000u
+#define PIN_FSYS_PA     0x13750000u     /* gpr2 at +0x40 (clk, cmd), gpr3 at +0x60 (data 0-3) */
+#define PIN_TOP_PA      0x139C0000u     /* gpd1 at +0xe0: pin 0 WLAN_EN */
+#define MMC1_PA         0x13550000u
+
+#define TOP_MUX_FSYS0   0x220
+#define TOP_MUX_FSYS1   0x224
+#define TOP_DIV_FSYS0   0x620
+#define TOP_DIV_FSYS1   0x624
+#define TOP_EN_SCLK_FSYS 0xa00          /* bit 1: sclk_fsys_mmc1_sdclkin */
+#define FSYS_EN_ACLK0   0x800           /* bit 8: aclk_mmc1 */
+#define FSYS_EN_SCLK    0xa00           /* bit 6: sclk_mmc1_sdclkin */
+
+#define W_CTRL          0x000
+#define W_PWREN         0x004
+#define W_CLKDIV        0x008
+#define W_CLKSRC        0x00c
+#define W_CLKENA        0x010
+#define W_TMOUT         0x014
+#define W_CTYPE         0x018
+#define W_BLKSIZ        0x01c
+#define W_BYTCNT        0x020
+#define W_INTMASK       0x024
+#define W_CMDARG        0x028
+#define W_CMD           0x02c
+#define W_RESP0         0x030
+#define W_RINTSTS       0x044
+#define W_STATUS        0x048
+#define W_FIFOTH        0x04c
+#define W_VERID         0x06c
+#define W_HCON          0x070
+#define W_CLKSEL        0x09c           /* Exynos: sample [2:0], drive [18:16], divider [26:24] */
+
+#define I_RESP_ERR      (1u << 1)
+#define I_CMD_DONE      (1u << 2)
+#define I_DATA_OVER     (1u << 3)
+#define I_TXDR          (1u << 4)
+#define I_RXDR          (1u << 5)
+#define I_RCRC          (1u << 6)
+#define I_DCRC          (1u << 7)
+#define I_RTO           (1u << 8)
+#define I_DRTO          (1u << 9)
+#define I_HTO           (1u << 10)
+#define I_FRUN          (1u << 11)
+#define I_HLE           (1u << 12)
+#define I_SBE           (1u << 13)
+#define I_EBE           (1u << 15)
+#define I_CMD_ERR       (I_RESP_ERR | I_RCRC | I_RTO | I_HLE)
+#define I_DATA_ERR      (I_DCRC | I_DRTO | I_FRUN | I_SBE | I_EBE)
+
+#define C_START         (1u << 31)
+#define C_USE_HOLD      (1u << 29)
+#define C_UPD_CLK       (1u << 21)
+#define C_SEND_INIT     (1u << 15)
+#define C_PRV_WAIT      (1u << 13)
+#define C_DAT_WR        (1u << 10)
+#define C_DAT_EXP       (1u << 9)
+#define C_RESP_CRC      (1u << 8)
+#define C_RESP_EXP      (1u << 6)
+
+static struct {
+	vm_offset_t top, fsys, pfsys, ptop, mmc;
+	uint32_t data_off, fifo_bytes;
+	int after_s;
+} w;
+
+static inline uint32_t
+rd(vm_offset_t b, uint32_t o)
+{
+	return *(volatile uint32_t *)(b + o);
+}
+
+static inline void
+wr(vm_offset_t b, uint32_t o, uint32_t v)
+{
+	*(volatile uint32_t *)(b + o) = v;
+}
+
+static void
+field(vm_offset_t b, uint32_t o, unsigned shift, unsigned width, uint32_t v)
+{
+	uint32_t m = ((1u << width) - 1u) << shift;
+	wr(b, o, (rd(b, o) & ~m) | ((v << shift) & m));
+}
+
+static uint64_t
+after_ms(uint32_t ms)
+{
+	uint64_t abs;
+	nanoseconds_to_absolutetime((uint64_t)ms * NSEC_PER_MSEC, &abs);
+	return mach_absolute_time() + abs;
+}
+
+static bool
+wait_clear(uint32_t off, uint32_t bits, uint32_t ms)
+{
+	uint64_t end = after_ms(ms);
+	while (rd(w.mmc, off) & bits) {
+		if (mach_absolute_time() > end) {
+			return false;
+		}
+	}
+	return true;
+}
+
+static int
+clk_update(void)
+{
+	wr(w.mmc, W_CMD, C_START | C_UPD_CLK | C_PRV_WAIT);
+	return wait_clear(W_CMD, C_START, 100) ? 0 : ETIMEDOUT;
+}
+
+/* one command; *resp = RESP0; ETIMEDOUT (no response), EIO (CRC/response error) */
+static int
+cmd(uint32_t c, uint32_t arg, uint32_t *resp)
+{
+	wr(w.mmc, W_RINTSTS, I_CMD_DONE | I_CMD_ERR);
+	wr(w.mmc, W_CMDARG, arg);
+	wr(w.mmc, W_CMD, c | C_START | C_USE_HOLD);
+	if (!wait_clear(W_CMD, C_START, 100)) {
+		return EBUSY;
+	}
+	uint64_t end = after_ms(100);
+	uint32_t s;
+	while (!((s = rd(w.mmc, W_RINTSTS)) & (I_CMD_DONE | I_HLE))) {
+		if (mach_absolute_time() > end) {
+			return ETIMEDOUT;
+		}
+	}
+	wr(w.mmc, W_RINTSTS, s & (I_CMD_DONE | I_CMD_ERR));
+	if (resp != NULL) {
+		*resp = rd(w.mmc, W_RESP0);
+	}
+	if (s & I_RTO) {
+		return ETIMEDOUT;
+	}
+	return (s & I_CMD_ERR) ? EIO : 0;
+}
+
+/* CMD52: one byte of function fn at addr (write: data; *out: the byte the card returns) */
+static int
+cmd52(unsigned fn, uint32_t addr, bool write, uint8_t data, uint8_t *out)
+{
+	uint32_t arg = (write ? (1u << 31) : 0) | ((fn & 7u) << 28) | ((addr & 0x1ffffu) << 9) | data;
+	uint32_t r = 0;
+	int e = cmd(52 | C_RESP_EXP | C_RESP_CRC | C_PRV_WAIT, arg, &r);
+	if (e == 0 && (((r >> 8) & 0xcbu) != 0)) {
+		e = EIO;                                /* R5 flags: CRC, illegal, error, function, range */
+	}
+	if (out != NULL) {
+		*out = (uint8_t)r;
+	}
+	return e;
+}
+
+/* CMD53 opcode: incrementing address (backplane), or fixed (the function 2 FIFO reads) */
+static bool w_fixed;
+static uint32_t w_dcrc, w_dcrc_soft;       /* data CRC errors on reads; reads taken after two agreed (round 77) */
+
+/* CMD53 byte mode read of n (<= 512) bytes of function fn at addr */
+static int
+cmd53_read(unsigned fn, uint32_t addr, uint8_t *buf, uint32_t n)
+{
+	if (!wait_clear(W_STATUS, 1u << 9, 100)) {
+		return EBUSY;
+	}
+	wr(w.mmc, W_CTRL, rd(w.mmc, W_CTRL) | 2u);  /* FIFO reset */
+	if (!wait_clear(W_CTRL, 2u, 100)) {
+		return EBUSY;
+	}
+	wr(w.mmc, W_RINTSTS, 0xffffffffu);
+	wr(w.mmc, W_BLKSIZ, n);
+	wr(w.mmc, W_BYTCNT, n);
+	uint32_t arg = ((fn & 7u) << 28) | (w_fixed ? 0u : (1u << 26)) | ((addr & 0x1ffffu) << 9) | (n & 0x1ffu);
+	wr(w.mmc, W_CMDARG, arg);
+	wr(w.mmc, W_CMD, 53 | C_RESP_EXP | C_RESP_CRC | C_DAT_EXP | C_PRV_WAIT | C_START | C_USE_HOLD);
+	if (!wait_clear(W_CMD, C_START, 100)) {
+		return EBUSY;
+	}
+	uint32_t got = 0, s = 0;
+	uint64_t end = after_ms(1000);
+	volatile uint8_t *fifo = (volatile uint8_t *)(w.mmc + w.data_off);
+	for (;;) {
+		s = rd(w.mmc, W_RINTSTS);
+		uint32_t cnt = (rd(w.mmc, W_STATUS) >> 17) & 0x1fffu;
+		while (cnt-- > 0 && got < n) {
+			uint32_t v[2] = {0, 0};
+			v[0] = *(volatile uint32_t *)fifo;
+			if (w.fifo_bytes == 8) {
+				v[1] = *(volatile uint32_t *)(fifo + 4);
+			}
+			for (uint32_t k = 0; k < w.fifo_bytes && got < n; k++) {
+				buf[got++] = ((uint8_t *)v)[k];
+			}
+		}
+		if (s & I_RXDR) {
+			wr(w.mmc, W_RINTSTS, I_RXDR);
+		}
+		if ((s & (I_CMD_ERR | I_DATA_ERR)) == I_DCRC && got >= n) {
+			/* round 77: data CRC only, all bytes in: the caller may compare repeated reads */
+			w_dcrc++;
+			if (w_dcrc <= 6) {
+				printf("A510F WIFI: CMD53 fn %u addr 0x%x x%u: data CRC error (%u so far), status 0x%x\n", fn, addr, n, w_dcrc,
+				    rd(w.mmc, W_STATUS));
+			}
+			(void)wait_clear(W_STATUS, 1u << 9, 100);
+			wr(w.mmc, W_RINTSTS, 0xffffffffu);
+			return EBADMSG;
+		}
+		if (s & (I_CMD_ERR | I_DATA_ERR)) {
+			printf("A510F WIFI: CMD53 fn %u addr 0x%x x%u: rintsts 0x%x, %u bytes, r5 0x%x status 0x%x\n", fn, addr, n, s, got,
+			    rd(w.mmc, W_RESP0), rd(w.mmc, W_STATUS));
+			return EIO;
+		}
+		if ((s & I_DATA_OVER) && got >= n) {
+			return 0;
+		}
+		if (mach_absolute_time() > end) {
+			printf("A510F WIFI: CMD53 fn %u addr 0x%x x%u timed out: rintsts 0x%x, %u bytes, r5 0x%x status 0x%x\n", fn, addr, n, s,
+			    got, rd(w.mmc, W_RESP0), rd(w.mmc, W_STATUS));
+			return ETIMEDOUT;
+		}
+	}
+}
+
+/* CMD53 byte mode write of n (<= 64) bytes to function fn at addr, incrementing (Linux order: command, then FIFO) */
+static int
+cmd53_write(unsigned fn, uint32_t addr, const uint8_t *buf, uint32_t n)
+{
+	if (!wait_clear(W_STATUS, 1u << 9, 100)) {
+		return EBUSY;
+	}
+	wr(w.mmc, W_CTRL, rd(w.mmc, W_CTRL) | 2u);  /* FIFO reset */
+	if (!wait_clear(W_CTRL, 2u, 100)) {
+		return EBUSY;
+	}
+	wr(w.mmc, W_RINTSTS, 0xffffffffu);
+	wr(w.mmc, W_BLKSIZ, n);
+	wr(w.mmc, W_BYTCNT, n);
+	uint32_t arg = (1u << 31) | ((fn & 7u) << 28) | (w_fixed ? 0u : (1u << 26)) | ((addr & 0x1ffffu) << 9) | (n & 0x1ffu);
+	wr(w.mmc, W_CMDARG, arg);
+	wr(w.mmc, W_CMD, 53 | C_RESP_EXP | C_RESP_CRC | C_DAT_EXP | C_DAT_WR | C_PRV_WAIT | C_START | C_USE_HOLD);
+	if (!wait_clear(W_CMD, C_START, 100)) {
+		return EBUSY;
+	}
+	uint32_t put = 0, s = 0;
+	uint64_t end = after_ms(1000);
+	volatile uint8_t *fifo = (volatile uint8_t *)(w.mmc + w.data_off);
+	for (;;) {
+		s = rd(w.mmc, W_RINTSTS);
+		if (put < n) {
+			uint32_t used = (rd(w.mmc, W_STATUS) >> 17) & 0x1fffu;
+			uint32_t room = used < 64u ? 64u - used : 0;
+			while (room-- > 0 && put < n) {
+				uint32_t v[2] = {0, 0};
+				uint32_t c = n - put < w.fifo_bytes ? n - put : w.fifo_bytes;
+				memcpy(v, buf + put, c);
+				*(volatile uint32_t *)fifo = v[0];
+				if (w.fifo_bytes == 8) {
+					*(volatile uint32_t *)(fifo + 4) = v[1];
+				}
+				put += w.fifo_bytes;
+			}
+		}
+		if (s & I_TXDR) {
+			wr(w.mmc, W_RINTSTS, I_TXDR);
+		}
+		if (s & (I_CMD_ERR | I_DATA_ERR)) {
+			printf("A510F WIFI: CMD53 write fn %u addr 0x%x x%u: rintsts 0x%x, r5 0x%x\n", fn, addr, n, s, rd(w.mmc, W_RESP0));
+			return EIO;
+		}
+		if (s & I_DATA_OVER) {
+			return wait_clear(W_STATUS, 1u << 9, 100) ? 0 : EBUSY;
+		}
+		if (mach_absolute_time() > end) {
+			printf("A510F WIFI: CMD53 write fn %u addr 0x%x x%u timed out: rintsts 0x%x\n", fn, addr, n, s);
+			return ETIMEDOUT;
+		}
+	}
+}
+
+/* backplane: 32 KiB window (SBADDR low/mid/high), 4-byte accesses at +0x8000 */
+static uint32_t bp_win = 0xffffffffu;
+
+static int
+bp_window(uint32_t addr)
+{
+	uint32_t win = addr & 0xffff8000u;
+	if (win == bp_win) {
+		return 0;
+	}
+	int e = cmd52(1, 0x1000a, true, (uint8_t)((win >> 8) & 0x80u), NULL);
+	e |= cmd52(1, 0x1000b, true, (uint8_t)(win >> 16), NULL);
+	e |= cmd52(1, 0x1000c, true, (uint8_t)(win >> 24), NULL);
+	bp_win = e == 0 ? win : 0xffffffffu;
+	return e;
+}
+
+static int
+bp_read32(uint32_t addr, uint32_t *v)
+{
+	uint8_t b[4] = {0, 0, 0, 0};
+	int e = bp_window(addr);
+	uint32_t prev = 0;
+	bool have_prev = false;
+	for (int tries = 0; e == 0 || e == EBADMSG; tries++) {
+		e = cmd53_read(1, (addr & 0x7fffu) | 0x8000u, b, 4);
+		*v = (uint32_t)b[0] | ((uint32_t)b[1] << 8) | ((uint32_t)b[2] << 16) | ((uint32_t)b[3] << 24);
+		if (e != EBADMSG) {
+			break;
+		}
+		/* data CRC error: two reads that agree are taken (round 77) */
+		if (have_prev && prev == *v) {
+			w_dcrc_soft++;
+			return 0;
+		}
+		prev = *v;
+		have_prev = true;
+		if (tries >= 3) {
+			break;
+		}
+	}
+	return e;
+}
+
+static int
+bp_write32(uint32_t addr, uint32_t v)
+{
+	uint8_t b[4] = {(uint8_t)v, (uint8_t)(v >> 8), (uint8_t)(v >> 16), (uint8_t)(v >> 24)};
+	int e = bp_window(addr);
+	return e != 0 ? e : cmd53_write(1, (addr & 0x7fffu) | 0x8000u, b, 4);
+}
+
+extern int a510f_mmc_read(const char *part, uint64_t lba, uint32_t nsect, void *dst);   /* sweet_mmc.c */
+
+/*
+ * Step 2a: the chip's cores (EROM), the ARM CR4's RAM, and the firmware and
+ * network written by twrp-write/auto.py wifi: the blob is in the last MiB of
+ * the sweetgl region (4 KiB block 2268198 = LBA 18145584), the network in OTA
+ * sector 100. The passphrase is never logged.
+ */
+#define WIFI_BLOB_LBA   18145584ull
+#define WIFI_BLOB_SECT  2048u
+#define CC_BASE         0x18000000u
+#define CORE_CR4        0x83eu
+#define CORE_SDIO       0x829u
+#define WRAP_IOCTL_EARLY        0x408u  /* AI wrapper registers (see step 2b) */
+#define WRAP_RESETCTL_EARLY     0x800u
+
+static struct {
+	uint32_t cr4_base, cr4_wrap, sdio_base, sdio_wrap, ram_size;
+	uint32_t d11_wrap;                      /* 802.11 core (0x812) wrapper: PHY held in reset while the ARM is halted */
+	int fw_ok;                              /* blob sum matched */
+	int f2_ready;                           /* step 2b: function 2 came up */
+	int up;                                 /* step 3: WLC_UP worked */
+	int keyed;                              /* step 4: WPA2 keys in place */
+	int dhcp;                               /* step 5: DHCP ACK */
+	uint8_t ip[4], mask[4], gw[4], dns[4];
+	uint8_t *blob;
+	uint32_t fw_len, nv_len;
+	char ssid[33];
+	char pass[65];
+} w2;
+
+static void
+wifi_step2a(void)
+{
+	uint32_t id = 0, erom = 0;
+	int e = bp_read32(CC_BASE, &id);
+	e |= bp_read32(CC_BASE + 0xfc, &erom);
+	printf("A510F WIFI: chipid 0x%08x (chip 0x%x rev %u), EROM at 0x%x (%d)\n", id, id & 0xffffu, (id >> 16) & 0xfu, erom, e);
+	if (e != 0) {
+		return;
+	}
+	/* EROM: component (CIA, CIB), then master port / address descriptors, EOT 0xf */
+	uint32_t a = erom, core = 0, rev = 0, base = 0, wrap = 0;
+	int ncores = 0;
+	{
+		/* round 71: round 70 found no cores: the raw table first */
+		uint32_t raw[16];
+		int er = 0;
+		for (int k = 0; k < 16; k++) {
+			raw[k] = 0;
+			er |= bp_read32(erom + 4u * (uint32_t)k, &raw[k]);
+		}
+		printf("A510F WIFI: EROM (%d): %08x %08x %08x %08x %08x %08x %08x %08x  %08x %08x %08x %08x %08x %08x %08x %08x\n",
+		    er, raw[0], raw[1], raw[2], raw[3], raw[4], raw[5], raw[6], raw[7], raw[8], raw[9], raw[10], raw[11], raw[12],
+		    raw[13], raw[14], raw[15]);
+	}
+	for (int k = 0; k < 400; k++) {
+		uint32_t v = 0;
+		int er = bp_read32(a, &v);
+		if (er != 0) {
+			printf("A510F WIFI: EROM read at 0x%x failed (%d) after %d words\n", a, er, k);
+			break;
+		}
+		a += 4;
+		uint32_t type = v & 0xfu;
+		if (type == 0xfu) {
+			printf("A510F WIFI: EROM end at word %d\n", k);
+		}
+		if (type == 0xfu || type == 0x1u) {
+			if (core != 0) {
+				printf("A510F WIFI: core 0x%03x rev %u base 0x%08x wrap 0x%08x\n", core, rev, base, wrap);
+				if (core == CORE_CR4 && w2.cr4_base == 0) {
+					w2.cr4_base = base;
+					w2.cr4_wrap = wrap;
+				}
+				if (core == CORE_SDIO && w2.sdio_base == 0) {
+					w2.sdio_base = base;
+					w2.sdio_wrap = wrap;
+				}
+				if (core == 0x812u && w2.d11_wrap == 0) {
+					w2.d11_wrap = wrap;
+				}
+				ncores++;
+			}
+			core = rev = base = wrap = 0;
+			if (type == 0xfu) {
+				break;
+			}
+			uint32_t cib = 0;
+			if (bp_read32(a, &cib) != 0) {
+				break;
+			}
+			a += 4;
+			core = (v >> 8) & 0xfffu;
+			rev = cib >> 24;
+		} else if (type == 0x5u) {
+			uint32_t stype = (v >> 6) & 3u, sz = (v >> 4) & 3u;
+			if (v & 0x8u) {
+				a += 4;                         /* 64-bit address: high word */
+			}
+			if (sz == 3u) {
+				uint32_t sd = 0;
+				(void)bp_read32(a, &sd);
+				a += (sd & 0x8u) ? 8 : 4;       /* size descriptor (+ high word) */
+			}
+			if (stype == 0 && base == 0) {
+				base = v & 0xfffff000u;
+			} else if ((stype == 2 || stype == 3) && wrap == 0) {
+				wrap = v & 0xfffff000u;
+			}
+		}
+	}
+	/*
+	 * Round 72: the EROM pointer (0x1810a000) read like wrapper registers.
+	 * Map the 16 wrapper slots (IOCTL, RESET_CTL) and core bases (+0, +4),
+	 * then, if the scan found no CR4, try the layout brcmfmac logs show for
+	 * this family (4339 / 4359 / 43456: CR4 0x18002000 wrap 0x18102000,
+	 * 802.11 0x18001000 wrap 0x18101000, SDIO 0x18004000 wrap 0x18104000),
+	 * kept only if the CR4's corecap reads as a plausible bank count.
+	 */
+	/*
+	 * Round 74: wrappers only. Round 73 read the 802.11 core's own registers
+	 * while it was in reset (wrapper reset 1): the backplane hung (CMD53
+	 * timeout) and every later read returned 0. A core's registers are read
+	 * only once its wrapper shows it clocked and out of reset.
+	 */
+	uint32_t wio[8], wrc[8];
+	int sdio_slot = -1;
+	for (uint32_t n = 0; n < 8; n++) {
+		wio[n] = wrc[n] = 0xdeadbeefu;
+		(void)bp_read32(0x18100000u + n * 0x1000u + WRAP_IOCTL_EARLY, &wio[n]);
+		(void)bp_read32(0x18100000u + n * 0x1000u + WRAP_RESETCTL_EARLY, &wrc[n]);
+		if (n >= 3 && sdio_slot < 0 && (wio[n] & 1u) && !(wrc[n] & 1u) && wio[n] != 0xffffffffu) {
+			sdio_slot = (int)n;             /* clocked, out of reset: the SDIO core runs (we are talking through it) */
+		}
+	}
+	printf("A510F WIFI: wrappers 0-7: io %x %x %x %x %x %x %x %x, reset %x %x %x %x %x %x %x %x; SDIO guess slot %d\n",
+	    wio[0], wio[1], wio[2], wio[3], wio[4], wio[5], wio[6], wio[7], wrc[0], wrc[1], wrc[2], wrc[3], wrc[4], wrc[5], wrc[6], wrc[7],
+	    sdio_slot);
+	if (w2.cr4_base == 0) {
+		/* round 73: the window registers as the card has them, the EROM pointer byte by byte */
+		uint8_t sl = 0, sm_ = 0, sh_ = 0, ep[4] = {0, 0, 0, 0};
+		(void)bp_window(0x1810a000u);
+		(void)cmd52(1, 0x1000a, false, 0, &sl);
+		(void)cmd52(1, 0x1000b, false, 0, &sm_);
+		(void)cmd52(1, 0x1000c, false, 0, &sh_);
+		(void)bp_window(CC_BASE);
+		for (unsigned b = 0; b < 4; b++) {
+			(void)cmd52(1, 0xfcu + b, false, 0, &ep[b]);
+		}
+		printf("A510F WIFI: window for 0x1810a000 reads back %02x %02x %02x; EROM pointer by CMD52 %02x%02x%02x%02x\n",
+		    sh_, sm_, sl, ep[3], ep[2], ep[1], ep[0]);
+		/*
+		 * The CR4's registers read 0 while its clock is off: halt it the way
+		 * brcmfmac's set_passive does (reset with CPUHALT, clock on) at the
+		 * family's wrapper, then read corecap.
+		 */
+		extern void a510f_wifi_cr4_halt(uint32_t wrap);
+		a510f_wifi_cr4_halt(0x18102000u);
+		uint32_t cap = 0, io = 0, rc = 0;
+		(void)bp_read32(0x18002004u, &cap);
+		(void)bp_read32(0x18102000u + WRAP_IOCTL_EARLY, &io);
+		(void)bp_read32(0x18102000u + WRAP_RESETCTL_EARLY, &rc);
+		uint32_t banks = (cap & 0xfu) + ((cap >> 4) & 0xfu);
+		printf("A510F WIFI: CR4 at 0x18002000 after halt (ioctl 0x%x reset 0x%x): corecap 0x%x (%u banks)\n", io, rc, cap, banks);
+		if (banks >= 1u && banks <= 16u && cap != 0xffffffffu) {
+			w2.cr4_base = 0x18002000u;
+			w2.cr4_wrap = 0x18102000u;
+			w2.d11_wrap = 0x18101000u;
+			uint32_t sn = sdio_slot >= 0 ? (uint32_t)sdio_slot : 4u;
+			w2.sdio_base = 0x18000000u + sn * 0x1000u;
+			w2.sdio_wrap = 0x18100000u + sn * 0x1000u;
+		}
+	}
+	printf("A510F WIFI: %d cores; ARM CR4 at 0x%x (wrap 0x%x), SDIO core at 0x%x (wrap 0x%x)\n", ncores, w2.cr4_base, w2.cr4_wrap,
+	    w2.sdio_base, w2.sdio_wrap);
+	if (w2.cr4_base != 0) {
+		uint32_t cap = 0;
+		(void)bp_read32(w2.cr4_base + 0x04, &cap);
+		uint32_t nab = cap & 0xfu, nbb = (cap >> 4) & 0xfu;
+		w2.ram_size = 0;
+		for (uint32_t i = 0; i < nab + nbb && i < 16; i++) {
+			uint32_t bx = 0;
+			(void)bp_write32(w2.cr4_base + 0x40, i);
+			(void)bp_read32(w2.cr4_base + 0x44, &bx);
+			w2.ram_size += ((bx & 0x7fu) + 1u) * ((bx & 0x200u) ? 1024u : 8192u);
+		}
+		printf("A510F WIFI: CR4 corecap 0x%x (%u+%u banks): RAM 0x198000, %u KiB\n", cap, nab, nbb, w2.ram_size / 1024u);
+	}
+
+	/* the firmware blob and the network, from the eMMC */
+	w2.blob = kalloc_data((vm_size_t)WIFI_BLOB_SECT * 512u, Z_WAITOK | Z_ZERO);
+	e = w2.blob != NULL ? a510f_mmc_read(NULL, WIFI_BLOB_LBA, WIFI_BLOB_SECT, w2.blob) : ENOMEM;
+	if (e == 0 && memcmp(w2.blob, "SWWIFI01", 8) == 0) {
+		uint32_t sum = 0, want = 0;
+		memcpy(&w2.fw_len, w2.blob + 8, 4);
+		memcpy(&w2.nv_len, w2.blob + 12, 4);
+		memcpy(&want, w2.blob + 16, 4);
+		uint32_t fw_pad = (w2.fw_len + 511u) & ~511u;
+		if (512u + fw_pad + w2.nv_len <= WIFI_BLOB_SECT * 512u) {
+			for (uint32_t i = 0; i < w2.fw_len; i++) {
+				sum += w2.blob[512 + i];
+			}
+			for (uint32_t i = 0; i < w2.nv_len; i++) {
+				sum += w2.blob[512 + fw_pad + i];
+			}
+		}
+		printf("A510F WIFI: firmware %u bytes, NVRAM %u bytes, sum 0x%x (%s)\n", w2.fw_len, w2.nv_len, sum,
+		    sum == want ? "OK" : "BAD");
+		w2.fw_ok = sum == want && w2.fw_len > 4;
+	} else {
+		printf("A510F WIFI: no firmware blob (read %d)\n", e);
+	}
+	uint8_t *sec = kalloc_data(512, Z_WAITOK | Z_ZERO);
+	e = sec != NULL ? a510f_mmc_read("OTA", 100, 1, sec) : ENOMEM;
+	if (e == 0 && memcmp(sec, "SWNET001", 8) == 0 && sec[8] >= 1 && sec[8] <= 32 && sec[41] >= 8 && sec[41] <= 63) {
+		memcpy(w2.ssid, sec + 9, sec[8]);
+		w2.ssid[sec[8]] = 0;
+		memcpy(w2.pass, sec + 42, sec[41]);
+		w2.pass[sec[41]] = 0;
+		printf("A510F WIFI: network \"%s\" (passphrase %u characters)\n", w2.ssid, sec[41]);
+	} else {
+		printf("A510F WIFI: no network in OTA sector 100 (read %d)\n", e);
+	}
+	if (sec != NULL) {
+		bzero(sec, 512);
+		kfree_data(sec, 512);
+	}
+	printf("A510F WIFI: step 2a done\n");
+}
+
+/*
+ * Step 2b: firmware download and start (brcmfmac chip.c / sdio.c for an ARM
+ * CR4 chip): halt the CR4 (wrapper IOCTL 0x408 CPUHALT 0x20, RESET_CTL 0x800),
+ * hold the 802.11 PHY in reset, write the firmware to RAM at 0x198000 and the
+ * NVRAM (key=value strings, NUL-separated, 4-byte padded, then the length
+ * token (~words << 16 | words)) to the end of RAM, the reset vector (the
+ * firmware's first word) to address 0, release the CR4, request the HT clock,
+ * enable function 2 and read what the firmware says (mailbox, sdpcm_shared).
+ */
+#define WRAP_IOCTL      0x408u
+#define WRAP_RESETCTL   0x800u
+#define IOCTL_CLK       0x1u
+#define IOCTL_FGC       0x2u
+#define CR4_CPUHALT     0x20u
+#define RAM_BASE        0x198000u
+
+extern void delay(int usec);
+
+static void
+core_disable(uint32_t wrap, uint32_t pre, uint32_t reset)
+{
+	uint32_t v = 0;
+	(void)bp_read32(wrap + WRAP_RESETCTL, &v);
+	if (!(v & 1u)) {
+		(void)bp_write32(wrap + WRAP_IOCTL, pre | IOCTL_FGC | IOCTL_CLK);
+		(void)bp_read32(wrap + WRAP_IOCTL, &v);
+		(void)bp_write32(wrap + WRAP_RESETCTL, 1);
+		delay(20);
+		for (int i = 0; i < 30; i++) {
+			(void)bp_read32(wrap + WRAP_RESETCTL, &v);
+			if (v == 1u) {
+				break;
+			}
+			delay(10);
+		}
+	}
+	(void)bp_write32(wrap + WRAP_IOCTL, reset | IOCTL_FGC | IOCTL_CLK);
+	(void)bp_read32(wrap + WRAP_IOCTL, &v);
+}
+
+static void
+core_reset(uint32_t wrap, uint32_t pre, uint32_t reset, uint32_t post)
+{
+	uint32_t v = 0;
+	core_disable(wrap, pre, reset);
+	for (int i = 0; i < 50; i++) {
+		(void)bp_read32(wrap + WRAP_RESETCTL, &v);
+		if (!(v & 1u)) {
+			break;
+		}
+		(void)bp_write32(wrap + WRAP_RESETCTL, 0);
+		delay(50);
+	}
+	(void)bp_write32(wrap + WRAP_IOCTL, post | IOCTL_CLK);
+	(void)bp_read32(wrap + WRAP_IOCTL, &v);
+}
+
+/* brcmfmac set_passive for the CR4: reset with CPUHALT, clock on (its registers read 0 while the clock is off) */
+void a510f_wifi_cr4_halt(uint32_t wrap);
+
+void
+a510f_wifi_cr4_halt(uint32_t wrap)
+{
+	uint32_t io = 0;
+	(void)bp_read32(wrap + WRAP_IOCTL, &io);
+	core_reset(wrap, io & CR4_CPUHALT, CR4_CPUHALT, CR4_CPUHALT);
+}
+
+/* the card clock divider in use (step 1 picks it); clk_slower() steps it down: 4 -> 8 -> 16 -> 32 -> 255 */
+static uint32_t w_clkdiv = 255u;
+
+static bool
+clk_slower(void)
+{
+	uint32_t next = w_clkdiv < 32u ? w_clkdiv * 2u : 255u;
+	if (w_clkdiv >= 255u) {
+		return false;
+	}
+	wr(w.mmc, W_CLKENA, 0);
+	(void)clk_update();
+	wr(w.mmc, W_CLKDIV, next);
+	(void)clk_update();
+	wr(w.mmc, W_CLKENA, 1);
+	(void)clk_update();
+	printf("A510F WIFI: card clock divider %u -> %u (write errors)\n", w_clkdiv, next);
+	w_clkdiv = next;
+	return true;
+}
+
+/* chip memory: CMD53 writes of up to 512 bytes, never across a 32 KiB window */
+static int
+bp_write_mem(uint32_t addr, const uint8_t *buf, uint32_t len)
+{
+	uint32_t off = 0;
+	while (off < len) {
+		uint32_t a = addr + off, c = len - off;
+		if (c > 64u) {
+			c = 64u;                /* function 1's block size: 512-byte byte-mode writes failed at every clock (round 86) */
+		}
+		if (c > 0x8000u - (a & 0x7fffu)) {
+			c = 0x8000u - (a & 0x7fffu);
+		}
+		int e = EIO;
+		/*
+		 * Round 86: at divider 4 the first 512-byte write got a CRC error
+		 * (round 85; reads were fine). Retry, then slow the card clock a step.
+		 */
+		for (int tries = 0; tries < 12 && e != 0; tries++) {
+			e = bp_window(a);
+			if (e == 0) {
+				e = cmd53_write(1, (a & 0x7fffu) | 0x8000u, buf + off, c);
+			}
+			if (e != 0 && (tries % 3) == 2 && !clk_slower()) {
+				break;
+			}
+		}
+		if (e != 0) {
+			printf("A510F WIFI: memory write at 0x%x failed (%d) after %u bytes\n", a, e, off);
+			return e;
+		}
+		off += c;
+	}
+	return 0;
+}
+
+static int
+bp_read_mem(uint32_t addr, uint8_t *buf, uint32_t len)
+{
+	uint32_t off = 0;
+	while (off < len) {
+		uint32_t a = addr + off, c = len - off;
+		if (c > 64u) {
+			c = 64u;                /* function 1's block size: 512-byte byte-mode writes failed at every clock (round 86) */
+		}
+		if (c > 0x8000u - (a & 0x7fffu)) {
+			c = 0x8000u - (a & 0x7fffu);
+		}
+		int e = bp_window(a);
+		if (e == 0) {
+			e = cmd53_read(1, (a & 0x7fffu) | 0x8000u, buf + off, c);
+		}
+		if (e != 0) {
+			return e;
+		}
+		off += c;
+	}
+	return 0;
+}
+
+/* the NVRAM text as the firmware wants it; macaddr replaced (a locally administered address) */
+static uint8_t *
+nvram_build(const uint8_t *txt, uint32_t n, uint32_t *out_len)
+{
+	uint32_t cap = n + 64u;
+	uint8_t *o = kalloc_data(cap, Z_WAITOK | Z_ZERO);
+	if (o == NULL) {
+		return NULL;
+	}
+	uint32_t p = 0, i = 0;
+	while (i < n) {
+		uint32_t s = i, e = i;
+		while (e < n && txt[e] != '\n') {
+			e++;
+		}
+		i = e + 1;
+		while (s < e && (txt[s] == ' ' || txt[s] == '\t')) {
+			s++;
+		}
+		while (e > s && (txt[e - 1] == '\r' || txt[e - 1] == ' ' || txt[e - 1] == '\t')) {
+			e--;
+		}
+		if (e == s || txt[s] == '#') {
+			continue;
+		}
+		bool eq = false;
+		for (uint32_t k = s; k < e; k++) {
+			eq |= txt[k] == '=';
+		}
+		if (!eq) {
+			continue;
+		}
+		const char *mac = "macaddr=02:a5:10:f0:0b:3c";
+		if (e - s > 8 && memcmp(txt + s, "macaddr=", 8) == 0) {
+			size_t ml = strlen(mac);
+			if (p + ml + 1 < cap) {
+				memcpy(o + p, mac, ml);
+				p += (uint32_t)ml + 1u;
+			}
+			continue;
+		}
+		if (p + (e - s) + 1 < cap) {
+			memcpy(o + p, txt + s, e - s);
+			p += (e - s) + 1u;
+		}
+	}
+	p += 1;                                 /* final NUL */
+	p = (p + 3u) & ~3u;
+	uint32_t words = p / 4u, token = (~words << 16) | (words & 0xffffu);
+	if (p + 4u > cap) {
+		kfree_data(o, cap);
+		return NULL;
+	}
+	memcpy(o + p, &token, 4);
+	*out_len = p + 4u;
+	return o;
+}
+
+static void
+wifi_step2b(void)
+{
+	if (w2.cr4_wrap == 0 || w2.sdio_base == 0 || w2.ram_size == 0 || !w2.fw_ok) {
+		printf("A510F WIFI: step 2b skipped (cr4 wrap 0x%x, sdio 0x%x, ram %u, firmware %d)\n", w2.cr4_wrap, w2.sdio_base,
+		    w2.ram_size, w2.fw_ok);
+		return;
+	}
+	uint64_t t0 = mach_absolute_time();
+	/* halt the ARM (out of reset, clock on, CPUHALT), PHY in reset */
+	uint32_t ioctl = 0;
+	(void)bp_read32(w2.cr4_wrap + WRAP_IOCTL, &ioctl);
+	core_reset(w2.cr4_wrap, ioctl & CR4_CPUHALT, CR4_CPUHALT, CR4_CPUHALT);
+	if (w2.d11_wrap != 0) {
+		core_disable(w2.d11_wrap, 0x8u | 0x4u, 0x4u);
+	}
+	(void)bp_read32(w2.cr4_wrap + WRAP_IOCTL, &ioctl);
+	printf("A510F WIFI: CR4 halted: ioctl 0x%x\n", ioctl);
+	/*
+	 * Round 76: brcmfmac downloads with the HT clock on (clkctl CLK_AVAIL:
+	 * CHIPCLKCSR = HT_AVAIL_REQ, wait HT_AVAIL); round 75 never asked for it.
+	 * And the first 4 KiB written right after the halt were lost: settle.
+	 */
+	{
+		uint8_t csr = 0;
+		int we = cmd52(1, 0x1000e, true, 0x10, NULL), hms = 0;
+		for (; hms < 1000; hms += 5) {
+			(void)cmd52(1, 0x1000e, false, 0, &csr);
+			if (csr & 0x80u) {
+				break;
+			}
+			IOSleep(5);
+		}
+		printf("A510F WIFI: HT for the download: write %d, csr 0x%x after %d ms\n", we, csr, hms);
+	}
+	IOSleep(100);
+
+	/* firmware */
+	const uint8_t *fw = w2.blob + 512;
+	int e = bp_write_mem(RAM_BASE, fw, w2.fw_len);
+	uint8_t chk[64];
+	int bad = 0;
+	if (e == 0) {
+		uint32_t at[3] = {0, w2.fw_len / 2u & ~63u, (w2.fw_len - 64u) & ~3u};
+		for (int k = 0; k < 3; k++) {
+			if (bp_read_mem(RAM_BASE + at[k], chk, 64) != 0 || memcmp(chk, fw + at[k], 64) != 0) {
+				bad |= 1 << k;
+			}
+		}
+	}
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	printf("A510F WIFI: firmware %u bytes written (%d) in %llu ms, read-back spots %s (0x%x)\n", w2.fw_len, e,
+	    ns / 1000000ull, bad ? "DIFFER" : "match", bad);
+	/*
+	 * Round 75: round 74's first 64 bytes differed (the other spots matched).
+	 * Check the first 4 KiB block by block, show the first difference,
+	 * rewrite differing blocks once and check again.
+	 */
+	if (e == 0) {
+		int nbad = 0, fixed = 0;
+		for (uint32_t off = 0; off < 4096u && off < w2.fw_len; off += 64u) {   /* round 82: first 4 KiB (the rest always matched; boot time) */
+			uint32_t c = w2.fw_len - off < 64u ? w2.fw_len - off : 64u;
+			if (bp_read_mem(RAM_BASE + off, chk, c) == 0 && memcmp(chk, fw + off, c) == 0) {
+				continue;
+			}
+			if (nbad++ < 2) {
+				printf("A510F WIFI: RAM +0x%x: %02x%02x%02x%02x %02x%02x%02x%02x, want %02x%02x%02x%02x %02x%02x%02x%02x\n", off,
+				    chk[0], chk[1], chk[2], chk[3], chk[4], chk[5], chk[6], chk[7],
+				    fw[off], fw[off + 1], fw[off + 2], fw[off + 3], fw[off + 4], fw[off + 5], fw[off + 6], fw[off + 7]);
+			}
+			if (bp_write_mem(RAM_BASE + off, fw + off, c) == 0 && bp_read_mem(RAM_BASE + off, chk, c) == 0 &&
+			    memcmp(chk, fw + off, c) == 0) {
+				fixed++;
+			}
+		}
+		printf("A510F WIFI: firmware check: %d blocks differed, %d fixed by a rewrite\n", nbad, fixed);
+		bad = nbad != fixed;
+	}
+	if (e != 0 || bad) {
+		return;
+	}
+
+	/* NVRAM at the end of RAM */
+	uint32_t fw_pad = (w2.fw_len + 511u) & ~511u, nvl = 0;
+	uint8_t *nv = nvram_build(w2.blob + 512 + fw_pad, w2.nv_len, &nvl);
+	if (nv == NULL) {
+		printf("A510F WIFI: NVRAM build failed\n");
+		return;
+	}
+	uint32_t nva = RAM_BASE + w2.ram_size - nvl;
+	e = bp_write_mem(nva, nv, nvl);
+	{
+		/* round 76: read the NVRAM back; its last word is the length token */
+		int nbad = 0;
+		for (uint32_t off = 0; e == 0 && off < nvl; off += 64u) {
+			uint32_t c = nvl - off < 64u ? nvl - off : 64u;
+			if (bp_read_mem(nva + off, chk, c) != 0 || memcmp(chk, nv + off, c) != 0) {
+				nbad++;
+				(void)bp_write_mem(nva + off, nv + off, c);
+			}
+		}
+		uint32_t tok = 0, want = 0;
+		(void)bp_read32(RAM_BASE + w2.ram_size - 4u, &tok);
+		memcpy(&want, nv + nvl - 4u, 4);
+		printf("A510F WIFI: NVRAM check: %d blocks rewritten; last word 0x%x (token 0x%x)\n", nbad, tok, want);
+	}
+	printf("A510F WIFI: NVRAM %u bytes at 0x%x (%d)\n", nvl, nva, e);
+	kfree_data(nv, w2.nv_len + 64u);
+	if (e != 0) {
+		return;
+	}
+
+	/* clear SDIO core interrupts, reset vector to address 0, CPU on */
+	uint32_t rstvec = 0;
+	memcpy(&rstvec, fw, 4);
+	(void)bp_write32(w2.sdio_base + 0x20, 0xffffffffu);
+	e = bp_write32(0, rstvec);
+	core_reset(w2.cr4_wrap, CR4_CPUHALT, 0, 0);
+	(void)bp_read32(w2.cr4_wrap + WRAP_IOCTL, &ioctl);
+	printf("A510F WIFI: reset vector 0x%08x (%d), CR4 released: ioctl 0x%x\n", rstvec, e, ioctl);
+
+	/* brcmfmac firmware_callback: force HT on the backplane (FORCE_HT 0x02), then F2 */
+	int hw = cmd52(1, 0x1000e, true, 0x02, NULL);
+	uint8_t csr = 0;
+	int ms = 0;
+	for (; ms < 1000; ms += 5) {
+		(void)cmd52(1, 0x1000e, false, 0, &csr);
+		if (csr & 0x80u) {
+			break;
+		}
+		IOSleep(5);
+	}
+	uint32_t sh0 = 0;
+	(void)bp_read32(RAM_BASE + w2.ram_size - 4u, &sh0);
+	printf("A510F WIFI: FORCE_HT write %d, csr 0x%x after %d ms; last RAM word 0x%x (sdpcm_shared once the firmware runs)\n",
+	    hw, csr, ms, sh0);
+
+	/* function 2 (brcmfmac firmware_callback: protocol version to the device first, interrupt mask after) */
+	(void)bp_write32(w2.sdio_base + 0x48, 4u << 16);   /* tosbmailboxdata = SDPCM_PROT_VERSION << 16 */
+	uint8_t ioen = 0, iordy = 0;
+	(void)cmd52(0, 0x02, false, 0, &ioen);
+	(void)cmd52(0, 0x02, true, (uint8_t)(ioen | 0x04u), NULL);
+	for (ms = 0; ms < 3000; ms += 10) {
+		(void)cmd52(0, 0x03, false, 0, &iordy);
+		if (iordy & 0x04u) {
+			break;
+		}
+		IOSleep(10);
+	}
+	(void)bp_write32(w2.sdio_base + 0x24, 0x200000f0u);        /* hostintmask: I_HMB_SW_MASK | I_CHIPACTIVE */
+	(void)cmd52(0, 0x210, true, 0x00, NULL);                /* function 2 block size 512 (FBR2) */
+	(void)cmd52(0, 0x211, true, 0x02, NULL);
+	w2.f2_ready = (iordy & 0x04u) != 0;
+	uint32_t mb = 0, shared = 0, inst = 0;
+	(void)bp_read32(w2.sdio_base + 0x4c, &mb);
+	(void)bp_read32(w2.sdio_base + 0x20, &inst);
+	(void)bp_read32(RAM_BASE + w2.ram_size - 4u, &shared);
+	printf("A510F WIFI: function 2 ready 0x%x after %d ms; mailbox 0x%x (fw ready %d, version %u), intstatus 0x%x, "
+	    "sdpcm_shared 0x%x\n", iordy, ms, mb, (mb & 0xau) != 0, (mb >> 16) & 0xffu, inst, shared);
+	printf("A510F WIFI: step 2b done\n");
+}
+
+/*
+ * Step 3: talk to the firmware (brcmfmac sdio.c / bcdc.c). Frames on
+ * function 2 through the ChipCommon window (address 0x8000 = cc base | 4-byte
+ * flag): writes incrementing, reads from the fixed FIFO address. A frame is
+ * a hardware header (LE16 length, LE16 ~length), an SDPCM header (LE32: seq
+ * [7:0], channel [11:8], next length [23:16], data offset [31:24]; LE32:
+ * flow control [7:0], max tx seq [15:8]) and, on the control channel (0), a
+ * BCDC header (LE32 cmd, len, flags (request id << 16 | SET 2 | ERROR 1),
+ * status) with the payload after it. Intstatus (SDIO core +0x20): bit 6 a
+ * frame waits, bit 7 the mailbox (+0x4c) has news; write-1-to-clear.
+ */
+#define F2_ADDR         0x8000u
+#define WLC_GET_VERSION 1u
+#define WLC_UP          2u
+#define WLC_GET_VAR     262u
+
+static uint8_t f2_buf[4096];            /* round 88: frames of 0xb40 bytes (good checksum) were dropped at 2048 */
+static uint8_t tx_seq;
+static uint8_t tx_max;
+static bool have_credit;
+static uint16_t req_id;
+
+static int
+f2_write(const uint8_t *buf, uint32_t len)
+{
+	int e = bp_window(CC_BASE);
+	for (uint32_t off = 0; e == 0 && off < len; off += 512u) {
+		uint32_t c = len - off < 512u ? len - off : 512u;
+		e = cmd53_write(2, F2_ADDR, buf + off, c);
+		if (e != 0 && clk_slower()) {
+			e = cmd53_write(2, F2_ADDR, buf + off, c);      /* round 86: once more, a step slower */
+		}
+	}
+	return e;
+}
+
+static int
+f2_read(uint8_t *buf, uint32_t len)
+{
+	int e = bp_window(CC_BASE);
+	w_fixed = true;
+	for (uint32_t off = 0; e == 0 && off < len; off += 512u) {
+		uint32_t c = len - off < 512u ? len - off : 512u;
+		e = cmd53_read(2, F2_ADDR, buf + off, c);
+		if (e == EBADMSG) {
+			e = 0;                  /* data CRC: a FIFO cannot be read twice; the frame header has its own check */
+		}
+	}
+	w_fixed = false;
+	return e;
+}
+
+/* wait for intstatus bits (and clear them); the mailbox is read and acknowledged when bit 7 comes */
+static uint32_t
+sdio_wait(uint32_t want, uint32_t ms)
+{
+	uint32_t got = 0;
+	for (uint32_t t = 0; t <= ms; t += 2) {
+		uint32_t st = 0;
+		if (bp_read32(w2.sdio_base + 0x20, &st) == 0 && (st & 0x200000f0u) != 0) {
+			(void)bp_write32(w2.sdio_base + 0x20, st & 0x200000f0u);
+			if (st & 0x80u) {
+				uint32_t mb = 0;
+				(void)bp_read32(w2.sdio_base + 0x4c, &mb);
+				(void)bp_write32(w2.sdio_base + 0x40, 0x2u);    /* SMB_INT_ACK */
+				printf("A510F WIFI: mailbox 0x%x (%s%s%s), protocol %u\n", mb, (mb & 0x8u) ? "firmware ready " : "",
+				    (mb & 0x2u) ? "device ready " : "", (mb & 0x10u) ? "FIRMWARE HALTED " : "", (mb >> 16) & 0xffu);
+			}
+			got |= st;
+			if (got & want) {
+				return got;
+			}
+		}
+		IOSleep(2);
+	}
+	return got;
+}
+
+/* read one frame into f2_buf; its length (0: none), channel and data offset */
+static uint32_t
+frame_read(uint32_t *chan, uint32_t *doff)
+{
+	if (f2_read(f2_buf, 4) != 0) {
+		return 0;
+	}
+	uint32_t len = (uint32_t)f2_buf[0] | ((uint32_t)f2_buf[1] << 8);
+	uint32_t chk = (uint32_t)f2_buf[2] | ((uint32_t)f2_buf[3] << 8);
+	if (len == 0 || ((len ^ chk) & 0xffffu) != 0xffffu || len < 12u || len > sizeof(f2_buf)) {
+		if (len != 0) {
+			/*
+			 * Round 87: 15931 of these, the read stream out of step. Drop
+			 * the rest of the frame as brcmfmac's rxfail does: abort F2
+			 * (CCCR 0x06), FRAMECTRL (0x1000d) SFC_RF_TERM, wait until the
+			 * read frame byte count (0x1001b/c) is 0.
+			 */
+			static unsigned bad;
+			bad++;
+			if (bad <= 8 || (bad & 1023u) == 0) {
+				printf("A510F WIFI: bad frame header len 0x%x chk 0x%x (%u so far), dropping the frame\n", len, chk, bad);
+			}
+			(void)cmd52(0, 0x06, true, 2, NULL);
+			(void)cmd52(1, 0x1000d, true, 1, NULL);
+			for (int i = 0; i < 10; i++) {
+				uint8_t hi = 0, lo = 0;
+				(void)cmd52(1, 0x1001c, false, 0, &hi);
+				(void)cmd52(1, 0x1001b, false, 0, &lo);
+				if (hi == 0 && lo == 0) {
+					break;
+				}
+			}
+		}
+		return 0;
+	}
+	uint32_t rest = ((len + 3u) & ~3u) - 4u;
+	if (rest > 0 && f2_read(f2_buf + 4, rest) != 0) {
+		return 0;
+	}
+	uint32_t w0 = 0, w1 = 0;
+	memcpy(&w0, f2_buf + 4, 4);
+	memcpy(&w1, f2_buf + 8, 4);
+	*chan = (w0 >> 8) & 0xfu;
+	if (len > 1600u || *chan == 3u) {
+		static unsigned big;
+		if (big++ < 6) {
+			printf("A510F WIFI: frame of %u bytes on channel %u (data offset %u)\n", len, *chan, w0 >> 24);
+		}
+	}
+	*doff = w0 >> 24;
+	tx_max = (uint8_t)(w1 >> 8);            /* the firmware's tx credit: we may send up to sequence tx_max */
+	have_credit = true;
+	return len;
+}
+
+/*
+ * Firmware events (channel 1): BCDC header (4 bytes, [3] = extra words),
+ * Ethernet header (type 0x886c), Broadcom header (10 bytes), event message
+ * (big endian: version 2, flags 2, type 4, status 4, reason 4, auth 4,
+ * datalen 4, addr 6, ifname 16, ifidx, bsscfgidx = 48 bytes), then data.
+ * Scan results (69): escan result (buflen, version, sync id, bss count),
+ * then bss_info: SSID length +18, SSID +19, chanspec +72, RSSI +78.
+ */
+#define EV_SET_SSID     0u
+#define EV_LINK         16u
+#define EV_PSK_SUP      46u
+#define EV_ESCAN        69u
+
+static struct {
+	int scan_done, join, link, keyed, nlog;
+	unsigned nseen;
+	char ssid[24][33];
+	int rssi[24];
+	unsigned chan[24];
+} ev;
+
+static uint32_t
+be32(const uint8_t *p)
+{
+	return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) | ((uint32_t)p[2] << 8) | p[3];
+}
+
+static void
+wifi_event(const uint8_t *f, uint32_t len, uint32_t doff)
+{
+	if (len < doff + 4u) {
+		return;
+	}
+	uint32_t bdo = (uint32_t)f[doff + 3] * 4u, at = doff + 4u + bdo;
+	if (len < at + 14u + 10u + 48u || f[at + 12] != 0x88 || f[at + 13] != 0x6c) {
+		return;
+	}
+	const uint8_t *m = f + at + 24, *d = m + 48;
+	uint32_t type = be32(m + 4), status = be32(m + 8), reason = be32(m + 12), dlen = be32(m + 24);
+	uint32_t flags = ((uint32_t)m[2] << 8) | m[3];
+	uint32_t have = len - (at + 24u + 48u);
+	if (dlen > have) {
+		dlen = have;
+	}
+	if (type == EV_ESCAN) {
+		if (status == 8u && dlen >= 12u + 80u) {
+			const uint8_t *b = d + 12;
+			uint32_t sl = b[18] <= 32 ? b[18] : 32;
+			int16_t rs = (int16_t)((uint16_t)b[78] | ((uint16_t)b[79] << 8));
+			unsigned ch = b[72];
+			char name[33];
+			memcpy(name, b + 19, sl);
+			name[sl] = 0;
+			bool dup = false;
+			for (unsigned i = 0; i < ev.nseen; i++) {
+				dup |= strcmp(ev.ssid[i], name) == 0;
+			}
+			if (!dup && ev.nseen < 24) {
+				memcpy(ev.ssid[ev.nseen], name, sl + 1);
+				ev.rssi[ev.nseen] = rs;
+				ev.chan[ev.nseen] = ch;
+				ev.nseen++;
+			}
+		} else if (status != 8u) {
+			ev.scan_done = status == 0 ? 1 : -1;
+		}
+		return;
+	}
+	if (type == EV_SET_SSID) {
+		ev.join = status == 0 ? 1 : -1;
+	} else if (type == EV_LINK) {
+		ev.link = (flags & 1u) ? 1 : -1;
+	} else if (type == EV_PSK_SUP) {
+		if (status == 6u) {
+			ev.keyed = 1;                   /* WLC_SUP_KEYED */
+		} else if (status == 7u) {
+			ev.keyed = -7;                  /* WLC_SUP_TIMEOUT (wrong passphrase, usually) */
+		}
+	}
+	if (ev.nlog++ < 40) {
+		printf("A510F WIFI: event %u status %u reason %u flags 0x%x, %u bytes of data\n", type, status, reason, flags, dlen);
+	}
+}
+
+/* one BCDC command on the control channel; the reply payload (up to outmax bytes) back into data */
+static int
+fw_dcmd(uint32_t cmd, bool set, uint8_t *data, uint32_t len, uint32_t outmax, uint32_t *status)
+{
+	uint32_t total = 12u + 16u + (len > outmax ? len : outmax);
+	if (total > sizeof(f2_buf)) {
+		return EINVAL;
+	}
+	bzero(f2_buf, sizeof(f2_buf));
+	uint16_t l16 = (uint16_t)total, c16 = (uint16_t)~l16;
+	memcpy(f2_buf, &l16, 2);
+	memcpy(f2_buf + 2, &c16, 2);
+	uint32_t w0 = (uint32_t)tx_seq++ | (0u << 8) | (12u << 24);
+	memcpy(f2_buf + 4, &w0, 4);
+	uint32_t id = ++req_id, flags = (id << 16) | (set ? 2u : 0u);
+	uint32_t blen = len > outmax ? len : outmax;
+	memcpy(f2_buf + 12, &cmd, 4);
+	memcpy(f2_buf + 16, &blen, 4);
+	memcpy(f2_buf + 20, &flags, 4);
+	if (len > 0) {
+		memcpy(f2_buf + 28, data, len);
+	}
+	int e = f2_write(f2_buf, (total + 3u) & ~3u);
+	if (e != 0) {
+		printf("A510F WIFI: dcmd %u send failed (%d)\n", cmd, e);
+		return e;
+	}
+	for (int tries = 0; tries < 300; tries++) {
+		IOSleep(10);    /* round 78: poll for frames (intstatus reads get data CRC errors since the firmware runs) */
+		for (int f = 0; f < 8; f++) {
+			uint32_t ch = 0, doff = 0, fl = frame_read(&ch, &doff);
+			if (fl == 0) {
+				break;
+			}
+			if (ch == 1) {
+				wifi_event(f2_buf, fl, doff);
+				continue;
+			}
+			if (ch != 0) {
+				continue;
+			}
+			uint32_t rflags = 0, rstat = 0;
+			memcpy(&rflags, f2_buf + doff + 8, 4);
+			memcpy(&rstat, f2_buf + doff + 12, 4);
+			if ((rflags >> 16) != (id & 0xffffu)) {
+				continue;
+			}
+			if (status != NULL) {
+				*status = (rflags & 1u) ? rstat : 0;
+			}
+			uint32_t pl = fl > doff + 16u ? fl - doff - 16u : 0;
+			if (outmax > 0 && data != NULL) {
+				memcpy(data, f2_buf + doff + 16, pl < outmax ? pl : outmax);
+			}
+			return (rflags & 1u) ? EIO : 0;
+		}
+	}
+	printf("A510F WIFI: dcmd %u: no reply\n", cmd);
+	return ETIMEDOUT;
+}
+
+static int
+fw_getvar(const char *name, uint8_t *out, uint32_t outlen)
+{
+	uint8_t req[256];
+	size_t nl = strlen(name) + 1;
+	if (nl > sizeof(req) || outlen > sizeof(req)) {
+		return EINVAL;
+	}
+	bzero(req, sizeof(req));
+	memcpy(req, name, nl);
+	uint32_t st = 0;
+	int e = fw_dcmd(WLC_GET_VAR, false, req, (uint32_t)nl, outlen > nl ? outlen : (uint32_t)nl, &st);
+	if (e == 0) {
+		memcpy(out, req, outlen);
+	}
+	return e != 0 ? e : (int)st;
+}
+
+static void
+wifi_step3(void)
+{
+	if (!w2.f2_ready) {
+		printf("A510F WIFI: step 3 skipped (function 2 not ready)\n");
+		return;
+	}
+	/*
+	 * Round 77: since the firmware runs, 4-byte reads of the SDIO core come
+	 * with data CRC errors (round 76). Compare the 4-bit and 1-bit bus and
+	 * keep the cleaner one.
+	 */
+	{
+		uint32_t before = w_dcrc, x = 0;
+		for (int i = 0; i < 4; i++) {
+			(void)bp_read32(w2.sdio_base + 0x20, &x);
+		}
+		uint32_t crc4 = w_dcrc - before;
+		uint8_t bic = 0;
+		(void)cmd52(0, 0x07, false, 0, &bic);
+		(void)cmd52(0, 0x07, true, (uint8_t)(bic & ~3u), NULL);
+		wr(w.mmc, W_CTYPE, 0);
+		before = w_dcrc;
+		for (int i = 0; i < 4; i++) {
+			(void)bp_read32(w2.sdio_base + 0x20, &x);
+		}
+		uint32_t crc1 = w_dcrc - before;
+		if (crc1 > crc4) {
+			(void)cmd52(0, 0x07, true, (uint8_t)((bic & ~3u) | 2u), NULL);
+			wr(w.mmc, W_CTYPE, 1);
+		}
+		printf("A510F WIFI: data CRC errors over 4 reads: 4-bit %u, 1-bit %u; using %s (intstatus 0x%x)\n", crc4, crc1,
+		    crc1 > crc4 ? "4-bit" : "1-bit", x);
+	}
+	uint32_t st = sdio_wait(0x80u, 3000);
+	printf("A510F WIFI: step 3: intstatus seen 0x%x\n", st);
+	uint8_t v[256];
+	uint32_t ver = 0, fst = 0;
+	int e = fw_dcmd(WLC_GET_VERSION, false, (uint8_t *)&ver, 0, 4, &fst);
+	printf("A510F WIFI: WLC_GET_VERSION %d: %u (status %u)\n", e, ver, fst);
+	bzero(v, sizeof(v));
+	e = fw_getvar("ver", v, 200);
+	v[199] = 0;
+	for (int i = 0; i < 200; i++) {
+		if (v[i] == '\n' || v[i] == '\r') {
+			v[i] = ' ';
+		}
+	}
+	printf("A510F WIFI: firmware \"%s\" (%d)\n", (const char *)v, e);
+	bzero(v, sizeof(v));
+	e = fw_getvar("cur_etheraddr", v, 6);
+	printf("A510F WIFI: MAC %02x:%02x:%02x:%02x:%02x:%02x (%d)\n", v[0], v[1], v[2], v[3], v[4], v[5], e);
+	e = fw_dcmd(WLC_UP, true, NULL, 0, 0, &fst);
+	printf("A510F WIFI: WLC_UP %d (status %u)\n", e, fst);
+	printf("A510F WIFI: step 3 done (data CRC errors %u, reads taken after two agreed %u)\n", w_dcrc, w_dcrc_soft);
+	w2.up = e == 0;
+}
+
+/*
+ * Step 4: scan (escan) and join the network from OTA sector 100 with the
+ * firmware's own WPA2-PSK supplicant (brcmfmac cfg80211.c / fwil_types.h:
+ * SET_INFRA 20, SET_AUTH 22, SET_SSID 26, SET_WSEC 134 (AES 4), SET_WPA_AUTH
+ * 165 (WPA2_PSK 0x80), SET_WSEC_PMK 268 (passphrase), SET_VAR 263, "sup_wpa").
+ */
+#define WLC_SET_INFRA   20u
+#define WLC_SET_AUTH    22u
+#define WLC_SET_SSID    26u
+#define WLC_SET_WSEC    134u
+#define WLC_SET_WPA_AUTH 165u
+#define WLC_SET_VAR     263u
+#define WLC_SET_WSEC_PMK 268u
+
+static int
+fw_setvar(const char *name, const void *val, uint32_t vlen)
+{
+	uint8_t req[256];
+	size_t nl = strlen(name) + 1;
+	if (nl + vlen > sizeof(req)) {
+		return EINVAL;
+	}
+	memcpy(req, name, nl);
+	memcpy(req + nl, val, vlen);
+	uint32_t st = 0;
+	int e = fw_dcmd(WLC_SET_VAR, true, req, (uint32_t)nl + vlen, 0, &st);
+	return e != 0 ? e : (int)st;
+}
+
+static int
+fw_set_u32(uint32_t cmd, uint32_t v)
+{
+	uint32_t st = 0;
+	int e = fw_dcmd(cmd, true, (uint8_t *)&v, 4, 0, &st);
+	return e != 0 ? e : (int)st;
+}
+
+/* read frames for up to ms, events to wifi_event; stop when *flag becomes non-zero */
+static ifnet_t wif;
+static void wif_deliver(const uint8_t *f, uint32_t len);
+
+static void
+events_poll(uint32_t ms, const int *flag)
+{
+	for (uint32_t t = 0; t < ms && (flag == NULL || *flag == 0); t += 2) {
+		for (int f = 0; f < 8; f++) {
+			uint32_t ch = 0, doff = 0, fl = frame_read(&ch, &doff);
+			if (fl == 0) {
+				break;
+			}
+			if (ch == 1) {
+				wifi_event(f2_buf, fl, doff);
+			} else if (ch == 2 && wif != NULL && fl > doff + 4u) {
+				uint32_t at = doff + 4u + (uint32_t)f2_buf[doff + 3] * 4u;
+				if (at < fl) {
+					wif_deliver(f2_buf + at, fl - at);      /* round 85: data read while waiting for credit */
+				}
+			}
+		}
+		IOSleep(2);
+	}
+}
+
+static void
+wifi_step4(void)
+{
+	if (!w2.up) {
+		printf("A510F WIFI: step 4 skipped (radio not up)\n");
+		return;
+	}
+	/* events: SET_SSID 0, JOIN 1, AUTH 3, DEAUTH 5/6, ASSOC 7, DISASSOC 11/12, LINK 16, PSK_SUP 46, ESCAN_RESULT 69 */
+	uint8_t mask[16];
+	bzero(mask, sizeof(mask));
+	int e = fw_getvar("event_msgs", mask, 16);
+	const unsigned want[] = {0, 1, 3, 5, 6, 7, 11, 12, 16, 46, 69};
+	for (unsigned i = 0; i < sizeof(want) / sizeof(want[0]); i++) {
+		mask[want[i] / 8] |= (uint8_t)(1u << (want[i] % 8));
+	}
+	int e2 = fw_setvar("event_msgs", mask, 16);
+	{
+		uint32_t zero = 0;      /* no rx superframes (glom): one frame per read, as frame_read expects */
+		int eg = fw_setvar("bus:rxglom", &zero, 4);
+		printf("A510F WIFI: bus:rxglom 0 -> %d\n", eg);
+	}
+	printf("A510F WIFI: event mask get %d set %d\n", e, e2);
+
+	/* escan: version 1, action START, sync id, then scan params (any BSS, active, defaults, all channels) */
+	uint8_t sp[76];
+	bzero(sp, sizeof(sp));
+	uint32_t v32 = 1;
+	memcpy(sp, &v32, 4);                    /* version */
+	uint16_t v16 = 1;
+	memcpy(sp + 4, &v16, 2);                /* action: start */
+	v16 = 0x1234;
+	memcpy(sp + 6, &v16, 2);                /* sync id */
+	memset(sp + 44, 0xff, 6);               /* bssid: broadcast */
+	sp[50] = 2;                             /* bss_type: any */
+	memset(sp + 52, 0xff, 16);              /* nprobes, active, passive, home time: firmware defaults */
+	ev.scan_done = 0;
+	ev.nseen = 0;
+	e = fw_setvar("escan", sp, sizeof(sp));
+	events_poll(8000, &ev.scan_done);
+	printf("A510F WIFI: scan %d, %s, %u networks:\n", e, ev.scan_done == 1 ? "complete" : ev.scan_done ? "FAILED" : "timed out",
+	    ev.nseen);
+	bool seen = false;
+	for (unsigned i = 0; i < ev.nseen; i++) {
+		printf("A510F WIFI:   \"%s\" %d dBm, channel %u\n", ev.ssid[i], ev.rssi[i], ev.chan[i]);
+		seen |= strcmp(ev.ssid[i], w2.ssid) == 0;
+	}
+	if (w2.ssid[0] == 0 || w2.pass[0] == 0) {
+		printf("A510F WIFI: no network to join\n");
+		return;
+	}
+	printf("A510F WIFI: joining \"%s\" (%s in the scan)\n", w2.ssid, seen ? "seen" : "not");
+
+	/* WPA2-PSK with the firmware supplicant */
+	int r1 = fw_set_u32(WLC_SET_INFRA, 1);
+	int r2 = fw_set_u32(WLC_SET_AUTH, 0);
+	int r3 = fw_set_u32(WLC_SET_WSEC, 4);
+	uint32_t one = 1;
+	int r4 = fw_setvar("sup_wpa", &one, 4);
+	int r5 = fw_set_u32(WLC_SET_WPA_AUTH, 0x80);
+	uint8_t pmk[68];
+	bzero(pmk, sizeof(pmk));
+	uint16_t kl = (uint16_t)strlen(w2.pass), kf = 1;   /* WSEC_PASSPHRASE */
+	memcpy(pmk, &kl, 2);
+	memcpy(pmk + 2, &kf, 2);
+	memcpy(pmk + 4, w2.pass, kl);
+	uint32_t st = 0;
+	int r6 = fw_dcmd(WLC_SET_WSEC_PMK, true, pmk, sizeof(pmk), 0, &st);
+	bzero(pmk, sizeof(pmk));
+	printf("A510F WIFI: infra %d auth %d wsec %d sup_wpa %d wpa_auth %d pmk %d/%u\n", r1, r2, r3, r4, r5, r6, st);
+	uint8_t ss[36];
+	bzero(ss, sizeof(ss));
+	uint32_t sl = (uint32_t)strlen(w2.ssid);
+	memcpy(ss, &sl, 4);
+	memcpy(ss + 4, w2.ssid, sl);
+	ev.join = ev.link = ev.keyed = 0;
+	e = fw_dcmd(WLC_SET_SSID, true, ss, sizeof(ss), 0, &st);
+	printf("A510F WIFI: SET_SSID %d/%u\n", e, st);
+	events_poll(20000, &ev.keyed);
+	printf("A510F WIFI: join %s, link %s, keys %s\n", ev.join == 1 ? "OK" : ev.join ? "FAILED" : "no event",
+	    ev.link == 1 ? "UP" : ev.link ? "down" : "no event", ev.keyed == 1 ? "DONE (connected)" : ev.keyed ? "failed" : "no event");
+	printf("A510F WIFI: step 4 done\n");
+	w2.keyed = ev.keyed == 1;
+}
+
+/*
+ * Step 5: the data path. Ethernet frames go on SDPCM channel 2 behind a
+ * 4-byte BCDC data header (flags 0x20 = protocol version 2, priority,
+ * flags2 = interface 0, data offset in words); received ones come the same
+ * way. Tested with a DHCP exchange (DISCOVER, OFFER, REQUEST, ACK): the
+ * router's answer proves both directions and gives the address, gateway and
+ * DNS server.
+ */
+static uint8_t w_mac[6];
+
+static int
+data_send(const uint8_t *eth, uint32_t len)
+{
+	/* the firmware's credit: (tx_max - tx_seq) must be 1..127 */
+	for (int t = 0; t < 250 && (!have_credit || (uint8_t)(tx_max - tx_seq) == 0 || ((uint8_t)(tx_max - tx_seq) & 0x80u)); t++) {
+		events_poll(2, NULL);
+	}
+	uint32_t total = 12u + 4u + len;
+	if (total > sizeof(f2_buf)) {
+		return EINVAL;
+	}
+	bzero(f2_buf, (total + 3u) & ~3u);
+	uint16_t l16 = (uint16_t)total, c16 = (uint16_t)~l16;
+	memcpy(f2_buf, &l16, 2);
+	memcpy(f2_buf + 2, &c16, 2);
+	uint32_t w0 = (uint32_t)tx_seq++ | (2u << 8) | (12u << 24);
+	memcpy(f2_buf + 4, &w0, 4);
+	f2_buf[12] = 0x20;                      /* BCDC version 2, no checksum offload */
+	memcpy(f2_buf + 16, eth, len);
+	return f2_write(f2_buf, (total + 3u) & ~3u);
+}
+
+/* the next received Ethernet frame within ms (events handled meanwhile); its length, 0 if none */
+static uint32_t
+data_recv(uint8_t *out, uint32_t max, uint32_t ms)
+{
+	for (uint32_t t = 0; t < ms; t += 10) {
+		for (int f = 0; f < 8; f++) {
+			uint32_t ch = 0, doff = 0, fl = frame_read(&ch, &doff);
+			if (fl == 0) {
+				break;
+			}
+			if (ch == 1) {
+				wifi_event(f2_buf, fl, doff);
+			} else if (ch == 2 && fl > doff + 4u) {
+				uint32_t at = doff + 4u + (uint32_t)f2_buf[doff + 3] * 4u;
+				if (at < fl) {
+					uint32_t n = fl - at < max ? fl - at : max;
+					memcpy(out, f2_buf + at, n);
+					return n;
+				}
+			}
+		}
+		IOSleep(10);
+	}
+	return 0;
+}
+
+static uint16_t
+ip_sum(const uint8_t *p, uint32_t n)
+{
+	uint32_t s = 0;
+	for (uint32_t i = 0; i + 1 < n; i += 2) {
+		s += ((uint32_t)p[i] << 8) | p[i + 1];
+	}
+	while (s >> 16) {
+		s = (s & 0xffffu) + (s >> 16);
+	}
+	return (uint16_t)~s;
+}
+
+/* a DHCP message (type 1 DISCOVER or 3 REQUEST) as an Ethernet broadcast; its length */
+static uint32_t
+dhcp_build(uint8_t *f, uint8_t type, uint32_t xid, const uint8_t req_ip[4], const uint8_t server[4])
+{
+	bzero(f, 342);
+	memset(f, 0xff, 6);
+	memcpy(f + 6, w_mac, 6);
+	f[12] = 0x08;
+	f[13] = 0x00;
+	uint8_t *ip = f + 14, *udp = ip + 20, *b = udp + 8;
+	b[0] = 1;                               /* BOOTREQUEST */
+	b[1] = 1;
+	b[2] = 6;
+	b[4] = (uint8_t)(xid >> 24);
+	b[5] = (uint8_t)(xid >> 16);
+	b[6] = (uint8_t)(xid >> 8);
+	b[7] = (uint8_t)xid;
+	b[10] = 0x80;                           /* broadcast reply */
+	memcpy(b + 28, w_mac, 6);
+	b[236] = 0x63;
+	b[237] = 0x82;
+	b[238] = 0x53;
+	b[239] = 0x63;
+	uint8_t *o = b + 240;
+	*o++ = 53;
+	*o++ = 1;
+	*o++ = type;
+	if (type == 3) {
+		*o++ = 50;
+		*o++ = 4;
+		memcpy(o, req_ip, 4);
+		o += 4;
+		*o++ = 54;
+		*o++ = 4;
+		memcpy(o, server, 4);
+		o += 4;
+	}
+	*o++ = 55;
+	*o++ = 4;
+	*o++ = 1;                               /* subnet mask */
+	*o++ = 3;                               /* router */
+	*o++ = 6;                               /* DNS */
+	*o++ = 51;                              /* lease time */
+	*o++ = 255;
+	uint32_t blen = 300;                    /* BOOTP minimum */
+	uint32_t ulen = 8u + blen, iplen = 20u + ulen;
+	ip[0] = 0x45;
+	ip[2] = (uint8_t)(iplen >> 8);
+	ip[3] = (uint8_t)iplen;
+	ip[8] = 64;
+	ip[9] = 17;
+	memset(ip + 16, 0xff, 4);
+	uint16_t cs = ip_sum(ip, 20);
+	ip[10] = (uint8_t)(cs >> 8);
+	ip[11] = (uint8_t)cs;
+	udp[1] = 68;
+	udp[3] = 67;
+	udp[4] = (uint8_t)(ulen >> 8);
+	udp[5] = (uint8_t)ulen;
+	return 14u + iplen;
+}
+
+/* a DHCP reply to xid: its message type, offered address and options (0: not one) */
+static int
+dhcp_parse(const uint8_t *f, uint32_t n, uint32_t xid, uint8_t yi[4], uint8_t srv[4], uint8_t mask[4], uint8_t gw[4],
+    uint8_t dns[4], uint32_t *lease)
+{
+	if (n < 14u + 20u + 8u + 240u || f[12] != 0x08 || f[13] != 0x00 || f[14 + 9] != 17) {
+		return 0;
+	}
+	uint32_t ihl = (uint32_t)(f[14] & 0xfu) * 4u;
+	const uint8_t *udp = f + 14 + ihl, *b = udp + 8;
+	if (14u + ihl + 8u + 240u > n || udp[3] != 68 || b[0] != 2) {
+		return 0;
+	}
+	uint32_t x = ((uint32_t)b[4] << 24) | ((uint32_t)b[5] << 16) | ((uint32_t)b[6] << 8) | b[7];
+	if (x != xid) {
+		return 0;
+	}
+	memcpy(yi, b + 16, 4);
+	int type = 0;
+	const uint8_t *o = b + 240, *end = f + n;
+	while (o + 2 <= end && *o != 255) {
+		if (*o == 0) {
+			o++;
+			continue;
+		}
+		uint8_t code = o[0], l = o[1];
+		const uint8_t *v = o + 2;
+		if (v + l > end) {
+			break;
+		}
+		if (code == 53 && l >= 1) {
+			type = v[0];
+		} else if (code == 54 && l >= 4) {
+			memcpy(srv, v, 4);
+		} else if (code == 1 && l >= 4) {
+			memcpy(mask, v, 4);
+		} else if (code == 3 && l >= 4) {
+			memcpy(gw, v, 4);
+		} else if (code == 6 && l >= 4) {
+			memcpy(dns, v, 4);
+		} else if (code == 51 && l >= 4) {
+			*lease = ((uint32_t)v[0] << 24) | ((uint32_t)v[1] << 16) | ((uint32_t)v[2] << 8) | v[3];
+		}
+		o = v + l;
+	}
+	return type;
+}
+
+static void
+wifi_step5(void)
+{
+	if (!w2.keyed) {
+		printf("A510F WIFI: step 5 skipped (not connected)\n");
+		return;
+	}
+	uint8_t mac[8];
+	bzero(mac, sizeof(mac));
+	if (fw_getvar("cur_etheraddr", mac, 6) != 0) {
+		printf("A510F WIFI: step 5: no MAC\n");
+		return;
+	}
+	memcpy(w_mac, mac, 6);
+	uint8_t *pkt = kalloc_data(1600, Z_WAITOK | Z_ZERO);
+	if (pkt == NULL) {
+		return;
+	}
+	uint32_t xid = 0xa5100000u | (uint32_t)(mach_absolute_time() & 0xffffu);
+	uint8_t yi[4] = {0}, srv[4] = {0}, msk[4] = {0}, gw[4] = {0}, dns[4] = {0}, none[4] = {0};
+	uint32_t lease = 0;
+	int got_offer = 0, got_ack = 0, frames = 0;
+	for (int attempt = 0; attempt < 3 && !got_offer; attempt++) {
+		uint32_t n = dhcp_build(pkt, 1, xid, none, none);
+		int e = data_send(pkt, n);
+		printf("A510F WIFI: DHCPDISCOVER %u bytes sent (%d), credit %u\n", n, e, (uint8_t)(tx_max - tx_seq));
+		for (int k = 0; k < 40 && !got_offer; k++) {
+			uint32_t r = data_recv(pkt, 1600, 100);
+			if (r == 0) {
+				continue;
+			}
+			frames++;
+			got_offer = dhcp_parse(pkt, r, xid, yi, srv, msk, gw, dns, &lease) == 2;
+		}
+	}
+	printf("A510F WIFI: %d frames received; offer %s: %u.%u.%u.%u from %u.%u.%u.%u\n", frames, got_offer ? "yes" : "no",
+	    yi[0], yi[1], yi[2], yi[3], srv[0], srv[1], srv[2], srv[3]);
+	if (got_offer) {
+		uint8_t want[4];
+		memcpy(want, yi, 4);
+		uint32_t n = dhcp_build(pkt, 3, xid, want, srv);
+		(void)data_send(pkt, n);
+		for (int k = 0; k < 40 && !got_ack; k++) {
+			uint32_t r = data_recv(pkt, 1600, 100);
+			if (r != 0) {
+				got_ack = dhcp_parse(pkt, r, xid, yi, srv, msk, gw, dns, &lease) == 5;
+			}
+		}
+		printf("A510F WIFI: DHCP %s: address %u.%u.%u.%u mask %u.%u.%u.%u gateway %u.%u.%u.%u DNS %u.%u.%u.%u, lease %u s\n",
+		    got_ack ? "ACK" : "no ACK", yi[0], yi[1], yi[2], yi[3], msk[0], msk[1], msk[2], msk[3], gw[0], gw[1], gw[2], gw[3],
+		    dns[0], dns[1], dns[2], dns[3], lease);
+	}
+	if (got_ack) {
+		memcpy(w2.ip, yi, 4);
+		memcpy(w2.mask, msk, 4);
+		memcpy(w2.gw, gw, 4);
+		memcpy(w2.dns, dns, 4);
+		w2.dhcp = 1;
+	}
+	kfree_data(pkt, 1600);
+	printf("A510F WIFI: step 5 done\n");
+}
+
+/*
+ * Step 6: en0 for iOS. An Ethernet interface (XNU's own Ethernet framer and
+ * demux: ARP and IP as for any adapter); this thread owns the SDIO bus from
+ * here on: frames the stack sends are queued by wif_output and sent here,
+ * received ones go to ifnet_input. The DHCP result is set from the kernel
+ * (IPv4 attach, up, address, default route); a DNS query to the router's DNS
+ * server through a kernel UDP socket tests the whole path.
+ */
+#define TXQ             128u
+
+static struct {
+	uint16_t len;
+	uint8_t b[1536];
+} txq[TXQ];
+static volatile unsigned txq_head, txq_tail;
+static LCK_GRP_DECLARE(wif_grp, "a510f_wifi");
+static LCK_MTX_DECLARE(wif_lock, &wif_grp);
+static ifnet_t wif;
+static volatile uint32_t wif_rx, wif_tx, wif_drop;
+
+static errno_t
+wif_output(ifnet_t ifp, mbuf_t m)
+{
+	size_t len = mbuf_pkthdr_len(m);
+	bpf_tap_out(ifp, DLT_EN10MB, m, NULL, 0);
+	lck_mtx_lock(&wif_lock);
+	unsigned next = (txq_head + 1u) % TXQ;
+	if (len <= sizeof(txq[0].b) && next != txq_tail && mbuf_copydata(m, 0, len, txq[txq_head].b) == 0) {
+		txq[txq_head].len = (uint16_t)len;
+		txq_head = next;
+	} else {
+		wif_drop++;
+	}
+	lck_mtx_unlock(&wif_lock);
+	mbuf_freem(m);
+	return 0;
+}
+
+static void
+wif_deliver(const uint8_t *f, uint32_t len)
+{
+	mbuf_t m = NULL;
+	if (wif == NULL || len < 14u || len > 1600u || mbuf_gethdr(MBUF_DONTWAIT, MBUF_TYPE_DATA, &m) != 0) {
+		return;
+	}
+	if (len > mbuf_maxlen(m) && mbuf_mclget(MBUF_DONTWAIT, MBUF_TYPE_DATA, &m) != 0) {
+		mbuf_freem(m);
+		return;
+	}
+	uint8_t *d = mbuf_data(m);
+	memcpy(d, f, len);
+	mbuf_setlen(m, len);
+	mbuf_pkthdr_setlen(m, len);
+	mbuf_pkthdr_setrcvif(m, wif);
+	bpf_tap_in(wif, DLT_EN10MB, m, NULL, 0);
+	mbuf_pkthdr_setheader(m, d);
+	mbuf_setdata(m, d + 14, len - 14u);
+	mbuf_pkthdr_adjustlen(m, -14);
+	struct ifnet_stat_increment_param st;
+	bzero(&st, sizeof(st));
+	st.packets_in = 1;
+	st.bytes_in = len;
+	(void)ifnet_input(wif, m, &st);
+	wif_rx++;
+}
+
+static int
+wif_attach(void)
+{
+	static const uint8_t bcast[6] = {0xff, 0xff, 0xff, 0xff, 0xff, 0xff};
+	struct ifnet_init_params p;
+	bzero(&p, sizeof(p));
+	p.uniqueid = "a510f-wifi";
+	p.uniqueid_len = 10;
+	p.name = "en";
+	p.unit = 0;
+	p.family = IFNET_FAMILY_ETHERNET;
+	p.type = IFT_ETHER;
+	p.output = wif_output;
+	p.demux = ether_demux;
+	p.add_proto = ether_add_proto;
+	p.del_proto = ether_del_proto;
+	p.check_multi = ether_check_multi;
+	p.framer = ether_frameout;
+	p.broadcast_addr = bcast;
+	p.broadcast_len = 6;
+	errno_t e = ifnet_allocate(&p, &wif);
+	if (e != 0) {
+		printf("A510F WIFI: ifnet_allocate failed (%d)\n", e);
+		wif = NULL;
+		return e;
+	}
+	(void)ifnet_set_lladdr(wif, w_mac, 6);
+	(void)ifnet_set_mtu(wif, 1500);
+	(void)ifnet_set_flags(wif, IFF_BROADCAST | IFF_SIMPLEX | IFF_MULTICAST, IFF_BROADCAST | IFF_SIMPLEX | IFF_MULTICAST);
+	struct sockaddr_dl sdl;
+	bzero(&sdl, sizeof(sdl));
+	sdl.sdl_len = (u_char)sizeof(sdl);
+	sdl.sdl_family = AF_LINK;
+	sdl.sdl_type = IFT_ETHER;
+	sdl.sdl_alen = 6;
+	memcpy(LLADDR(&sdl), w_mac, 6);
+	e = ifnet_attach(wif, &sdl);
+	if (e == 0) {
+		bpfattach(wif, DLT_EN10MB, 14);
+		(void)ifnet_set_flags(wif, IFF_UP | IFF_RUNNING, IFF_UP | IFF_RUNNING);   /* round 81: round 80 sent got ENETDOWN */
+		extern void a510f_net_publish(const uint8_t *mac, const char *bsd_name, uint32_t unit);
+		a510f_net_publish(w_mac, "en0", 0);
+	}
+	printf("A510F WIFI: en0 attached (%d)\n", e);
+	return e;
+}
+
+static void
+sin_set(struct sockaddr *sa, const uint8_t a[4])
+{
+	struct sockaddr_in *s = (struct sockaddr_in *)(void *)sa;
+	bzero(s, sizeof(*s));
+	s->sin_len = (uint8_t)sizeof(*s);
+	s->sin_family = AF_INET;
+	memcpy(&s->sin_addr, a, 4);
+}
+
+static void
+wif_ipconfig(void)
+{
+	socket_t so = NULL;
+	errno_t e = sock_socket(PF_INET, SOCK_DGRAM, 0, NULL, NULL, &so);
+	if (e != 0) {
+		printf("A510F WIFI: inet socket failed (%d)\n", e);
+		return;
+	}
+	struct ifreq ifr;
+	bzero(&ifr, sizeof(ifr));
+	strlcpy(ifr.ifr_name, "en0", sizeof(ifr.ifr_name));
+	errno_t ea = sock_ioctl(so, SIOCPROTOATTACH, &ifr);
+	ifr.ifr_flags = IFF_UP | IFF_RUNNING | IFF_BROADCAST | IFF_SIMPLEX | IFF_MULTICAST;
+	errno_t ef = sock_ioctl(so, SIOCSIFFLAGS, &ifr);
+	struct ifaliasreq ifra;
+	bzero(&ifra, sizeof(ifra));
+	strlcpy(ifra.ifra_name, "en0", sizeof(ifra.ifra_name));
+	uint8_t bc[4];
+	for (int i = 0; i < 4; i++) {
+		bc[i] = (uint8_t)(w2.ip[i] | (uint8_t)~w2.mask[i]);
+	}
+	sin_set(&ifra.ifra_addr, w2.ip);
+	sin_set(&ifra.ifra_mask, w2.mask);
+	sin_set(&ifra.ifra_broadaddr, bc);
+	errno_t eaddr = sock_ioctl(so, SIOCAIFADDR, &ifra);
+	sock_close(so);
+
+	/* default route via the gateway: RTM_ADD on a routing socket */
+	socket_t rs = NULL;
+	errno_t er = sock_socket(PF_ROUTE, SOCK_RAW, 0, NULL, NULL, &rs);
+	errno_t es = EINVAL;
+	if (er == 0) {
+		struct {
+			struct rt_msghdr h;
+			struct sockaddr_in dst, gw, mask;
+		} m;
+		bzero(&m, sizeof(m));
+		m.h.rtm_msglen = (u_short)sizeof(m);
+		m.h.rtm_version = RTM_VERSION;
+		m.h.rtm_type = RTM_ADD;
+		m.h.rtm_flags = RTF_UP | RTF_GATEWAY | RTF_STATIC;
+		m.h.rtm_addrs = RTA_DST | RTA_GATEWAY | RTA_NETMASK;
+		m.h.rtm_seq = 1;
+		static const uint8_t zero[4] = {0, 0, 0, 0};
+		sin_set((struct sockaddr *)&m.dst, zero);
+		sin_set((struct sockaddr *)&m.gw, w2.gw);
+		sin_set((struct sockaddr *)&m.mask, zero);
+		struct iovec iov = {&m, sizeof(m)};
+		struct msghdr msg;
+		bzero(&msg, sizeof(msg));
+		msg.msg_iov = &iov;
+		msg.msg_iovlen = 1;
+		size_t sent = 0;
+		es = sock_send(rs, &msg, 0, &sent);
+		sock_close(rs);
+	}
+	(void)ifnet_set_flags(wif, IFF_UP | IFF_RUNNING, IFF_UP | IFF_RUNNING);
+	printf("A510F WIFI: en0 inet attach %d, up %d, address %u.%u.%u.%u %d, default route via %u.%u.%u.%u %d/%d\n", ea, ef,
+	    w2.ip[0], w2.ip[1], w2.ip[2], w2.ip[3], eaddr, w2.gw[0], w2.gw[1], w2.gw[2], w2.gw[3], er, es);
+}
+
+/* a DNS query for apple.com to the router's DNS server, through the kernel's own UDP socket */
+static void
+wif_dns_test(__unused void *arg, __unused wait_result_t wr_)
+{
+	IOSleep(3000);
+	socket_t so = NULL;
+	errno_t e = sock_socket(PF_INET, SOCK_DGRAM, IPPROTO_UDP, NULL, NULL, &so);
+	if (e == 0) {
+		struct timeval tv = {4, 0};
+		(void)sock_setsockopt(so, SOL_SOCKET, SO_RCVTIMEO, &tv, (int)sizeof(tv));
+		static const uint8_t q[] = {0x12, 0x34, 0x01, 0x00, 0, 1, 0, 0, 0, 0, 0, 0,
+			                    5, 'a', 'p', 'p', 'l', 'e', 3, 'c', 'o', 'm', 0, 0, 1, 0, 1};
+		struct sockaddr_in to;
+		sin_set((struct sockaddr *)&to, w2.dns);
+		to.sin_port = htons(53);
+		struct iovec iov = {(void *)(uintptr_t)q, sizeof(q)};
+		struct msghdr m;
+		bzero(&m, sizeof(m));
+		m.msg_name = &to;
+		m.msg_namelen = (socklen_t)sizeof(to);
+		m.msg_iov = &iov;
+		m.msg_iovlen = 1;
+		size_t sent = 0, got = 0;
+		e = sock_send(so, &m, 0, &sent);
+		uint8_t r[512];
+		struct iovec riov = {r, sizeof(r)};
+		struct msghdr rm;
+		bzero(&rm, sizeof(rm));
+		rm.msg_iov = &riov;
+		rm.msg_iovlen = 1;
+		errno_t e2 = e == 0 ? sock_receive(so, &rm, 0, &got) : e;
+		uint8_t a[4] = {0, 0, 0, 0};
+		if (e2 == 0 && got > sizeof(q)) {
+			/* answers after the question: name (pointer or labels), type, class, ttl, rdlength, data */
+			uint32_t at = sizeof(q);
+			unsigned ans = ((unsigned)r[6] << 8) | r[7];
+			for (unsigned k = 0; k < ans && at + 12u <= got; k++) {
+				if ((r[at] & 0xc0u) == 0xc0u) {
+					at += 2;
+				} else {
+					while (at < got && r[at] != 0) {
+						at += 1u + r[at];
+					}
+					at++;
+				}
+				if (at + 10u > got) {
+					break;
+				}
+				unsigned type = ((unsigned)r[at] << 8) | r[at + 1], rl = ((unsigned)r[at + 8] << 8) | r[at + 9];
+				at += 10;
+				if (type == 1 && rl == 4 && at + 4u <= got) {
+					memcpy(a, r + at, 4);
+					break;
+				}
+				at += rl;
+			}
+		}
+		printf("A510F WIFI: DNS test: sent %d (%lu bytes), reply %d (%lu bytes): apple.com = %u.%u.%u.%u\n", e, (unsigned long)sent, e2, (unsigned long)got,
+		    a[0], a[1], a[2], a[3]);
+		sock_close(so);
+	} else {
+		printf("A510F WIFI: DNS test: socket failed (%d)\n", e);
+	}
+	thread_terminate(current_thread());
+}
+
+/* this thread from now on: send queued frames, deliver received ones, handle events; never returns */
+static void
+wif_service(void)
+{
+	uint64_t next_log = 0;
+	for (;;) {
+		bool busy = false;
+		while (txq_tail != txq_head) {
+			unsigned t = txq_tail;
+			(void)data_send(txq[t].b, txq[t].len);
+			lck_mtx_lock(&wif_lock);
+			txq_tail = (t + 1u) % TXQ;
+			lck_mtx_unlock(&wif_lock);
+			wif_tx++;
+			busy = true;
+		}
+		for (int f = 0; f < 8; f++) {
+			uint32_t ch = 0, doff = 0, fl = frame_read(&ch, &doff);
+			if (fl == 0) {
+				break;
+			}
+			busy = true;
+			if (ch == 1) {
+				wifi_event(f2_buf, fl, doff);
+			} else if (ch == 2 && fl > doff + 4u) {
+				uint32_t at = doff + 4u + (uint32_t)f2_buf[doff + 3] * 4u;
+				if (at < fl) {
+					wif_deliver(f2_buf + at, fl - at);
+				}
+			}
+		}
+		uint64_t now = mach_absolute_time();
+		if (now > next_log) {
+			uint64_t abs = 0;
+			nanoseconds_to_absolutetime(30ull * NSEC_PER_SEC, &abs);
+			next_log = now + abs;
+			printf("A510F WIFI: en0: %u frames in, %u out, %u dropped\n", wif_rx, wif_tx, wif_drop);
+		}
+		if (!busy) {
+			IOSleep(2);
+		}
+	}
+}
+
+static void
+wifi_step6(void)
+{
+	if (!w2.dhcp) {
+		printf("A510F WIFI: step 6 skipped (no DHCP lease)\n");
+		return;
+	}
+	if (wif_attach() != 0) {
+		return;
+	}
+	wif_ipconfig();
+	thread_t th;
+	if (kernel_thread_start(wif_dns_test, NULL, &th) == KERN_SUCCESS) {
+		thread_deallocate(th);
+	}
+	printf("A510F WIFI: step 6: en0 up, serving\n");
+	wif_service();
+}
+
+static void
+wifi_step1(void)
+{
+	/* 1. clocks: the same source and dividers as mmc0 (S-Boot set those up), gates on */
+	printf("A510F WIFI: before: top mux 0x%x/0x%x div 0x%x/0x%x en_sclk_top_fsys 0x%x, fsys en_aclk0 0x%x en_sclk 0x%x, "
+	    "gpr2 con 0x%x pud 0x%x drv 0x%x, gpr3 con 0x%x, gpd1 con 0x%x dat 0x%x\n",
+	    rd(w.top, TOP_MUX_FSYS0), rd(w.top, TOP_MUX_FSYS1), rd(w.top, TOP_DIV_FSYS0), rd(w.top, TOP_DIV_FSYS1),
+	    rd(w.top, TOP_EN_SCLK_FSYS), rd(w.fsys, FSYS_EN_ACLK0), rd(w.fsys, FSYS_EN_SCLK),
+	    rd(w.pfsys, 0x40), rd(w.pfsys, 0x48), rd(w.pfsys, 0x4c), rd(w.pfsys, 0x60),
+	    rd(w.ptop, 0xe0), rd(w.ptop, 0xe4));
+	wr(w.top, TOP_MUX_FSYS1, rd(w.top, TOP_MUX_FSYS0));
+	wr(w.top, TOP_DIV_FSYS1, rd(w.top, TOP_DIV_FSYS0));
+	field(w.top, TOP_EN_SCLK_FSYS, 1, 1, 1);
+	field(w.fsys, FSYS_EN_ACLK0, 8, 1, 1);
+	field(w.fsys, FSYS_EN_SCLK, 6, 1, 1);
+	IOSleep(2);
+
+	/* 2. pins: SDIO function 2, pull-up on cmd/data, drive strength 3 */
+	for (unsigned p = 0; p < 2; p++) {
+		field(w.pfsys, 0x40, 4 * p, 4, 2);
+		field(w.pfsys, 0x48, 2 * p, 2, p == 0 ? 0 : 3);
+		field(w.pfsys, 0x4c, 4 * p, 4, 3);
+	}
+	for (unsigned p = 0; p < 4; p++) {
+		field(w.pfsys, 0x60, 4 * p, 4, 2);
+		field(w.pfsys, 0x68, 2 * p, 2, 3);
+		field(w.pfsys, 0x6c, 4 * p, 4, 3);
+	}
+
+	/* 3. power cycle the chip: WL_REG_ON low, then high (bcmdhd waits ~200 ms) */
+	field(w.ptop, 0xe0, 0, 4, 1);
+	field(w.ptop, 0xe4, 0, 1, 0);
+	IOSleep(20);
+	field(w.ptop, 0xe4, 0, 1, 1);
+	IOSleep(250);
+
+	/* 4. controller */
+	uint32_t verid = rd(w.mmc, W_VERID), hcon = rd(w.mmc, W_HCON);
+	w.data_off = (verid & 0xffffu) >= 0x240a ? 0x200 : 0x100;
+	w.fifo_bytes = ((hcon >> 7) & 7u) == 2 ? 8 : 4;
+	printf("A510F WIFI: mmc1 verid 0x%x hcon 0x%x (fifo %u-byte at +0x%x), ctrl 0x%x clkena 0x%x clksel 0x%x\n",
+	    verid, hcon, w.fifo_bytes, w.data_off, rd(w.mmc, W_CTRL), rd(w.mmc, W_CLKENA), rd(w.mmc, W_CLKSEL));
+	wr(w.mmc, W_CTRL, rd(w.mmc, W_CTRL) | 7u);
+	if (!wait_clear(W_CTRL, 7u, 200)) {
+		printf("A510F WIFI: controller reset stuck, ctrl 0x%x\n", rd(w.mmc, W_CTRL));
+		return;
+	}
+	wr(w.mmc, W_PWREN, 1);
+	wr(w.mmc, W_INTMASK, 0);
+	wr(w.mmc, W_RINTSTS, 0xffffffffu);
+	wr(w.mmc, W_TMOUT, 0xffffffffu);
+	wr(w.mmc, W_FIFOTH, (2u << 28) | (31u << 16) | 32u);
+	wr(w.mmc, W_CTYPE, 0);
+	wr(w.mmc, W_CLKSEL, (3u << 24) | 2u);       /* ciu / 4 (samsung,dw-mshc-ciu-div = 3), sample phase 2 */
+	wr(w.mmc, W_CLKENA, 0);
+	int e1 = clk_update();
+	wr(w.mmc, W_CLKDIV, 255);                   /* card clock = ciu / 510: a few hundred kHz */
+	wr(w.mmc, W_CLKSRC, 0);
+	int e2 = clk_update();
+	wr(w.mmc, W_CLKENA, 1);
+	int e3 = clk_update();
+	printf("A510F WIFI: card clock on (updates %d %d %d)\n", e1, e2, e3);
+	IOSleep(10);
+
+	/* 5. SDIO reset (CCCR 6 bit 3; may not answer), 80 clocks + CMD0, then CMD5 */
+	(void)cmd52(0, 0x06, true, 0x08, NULL);
+	int e0 = cmd(0 | C_SEND_INIT, 0, NULL);
+	uint32_t ocr = 0;
+	int e5 = cmd(5 | C_RESP_EXP, 0, &ocr);
+	printf("A510F WIFI: CMD0 %d, CMD5 %d ocr 0x%x (functions %u)\n", e0, e5, ocr, (ocr >> 28) & 7u);
+	if (e5 != 0) {
+		printf("A510F WIFI: no SDIO answer: rintsts 0x%x status 0x%x\n", rd(w.mmc, W_RINTSTS), rd(w.mmc, W_STATUS));
+		return;
+	}
+	uint32_t want = (ocr & 0x00ffff00u) != 0 ? (ocr & 0x00300000u ? 0x00300000u : ocr & 0x00ffff00u) : 0x00300000u;
+	int tries = 0;
+	do {
+		e5 = cmd(5 | C_RESP_EXP, want, &ocr);
+		if (e5 == 0 && (ocr & (1u << 31))) {
+			break;
+		}
+		IOSleep(10);
+	} while (++tries < 100);
+	printf("A510F WIFI: CMD5 0x%x: %d ocr 0x%x after %d tries\n", want, e5, ocr, tries);
+	if (!(ocr & (1u << 31))) {
+		return;
+	}
+	uint32_t r6 = 0, r1 = 0;
+	int e3c = cmd(3 | C_RESP_EXP | C_RESP_CRC, 0, &r6);
+	uint32_t rca = r6 >> 16;
+	int e7 = cmd(7 | C_RESP_EXP | C_RESP_CRC | C_PRV_WAIT, rca << 16, &r1);
+	printf("A510F WIFI: CMD3 %d rca 0x%x, CMD7 %d r1 0x%x\n", e3c, rca, e7, r1);
+	if (e3c != 0 || e7 != 0) {
+		return;
+	}
+
+	/* 6. CCCR */
+	uint8_t cccr[20];
+	int ecc = 0;
+	for (unsigned i = 0; i < 20; i++) {
+		cccr[i] = 0;
+		ecc |= cmd52(0, i, false, 0, &cccr[i]);
+	}
+	printf("A510F WIFI: CCCR (%d): %02x %02x %02x %02x %02x %02x %02x %02x  %02x %02x %02x %02x %02x %02x %02x %02x  %02x %02x %02x %02x\n",
+	    ecc, cccr[0], cccr[1], cccr[2], cccr[3], cccr[4], cccr[5], cccr[6], cccr[7], cccr[8], cccr[9], cccr[10], cccr[11],
+	    cccr[12], cccr[13], cccr[14], cccr[15], cccr[16], cccr[17], cccr[18], cccr[19]);
+
+	/* 7. CIS (function 0): manufacturer / card id tuple (0x20), with CMD52 only */
+	{
+		uint32_t cis = (uint32_t)cccr[9] | ((uint32_t)cccr[10] << 8) | ((uint32_t)cccr[11] << 16);
+		uint32_t a = cis;
+		for (int t = 0; t < 32 && a < cis + 512; t++) {
+			uint8_t code = 0, link = 0;
+			if (cmd52(0, a, false, 0, &code) != 0 || code == 0xff) {
+				break;
+			}
+			(void)cmd52(0, a + 1, false, 0, &link);
+			if (code == 0x20 && link >= 4) {
+				uint8_t m[4] = {0, 0, 0, 0};
+				for (unsigned b = 0; b < 4; b++) {
+					(void)cmd52(0, a + 2 + b, false, 0, &m[b]);
+				}
+				printf("A510F WIFI: CIS at 0x%x: manufacturer 0x%02x%02x, card 0x%02x%02x\n", cis, m[1], m[0], m[3], m[2]);
+			}
+			a += 2u + link;
+		}
+	}
+
+	/* 8. function 1 on, block size 64 */
+	(void)cmd52(0, 0x02, true, 0x02, NULL);
+	uint8_t rdy = 0;
+	tries = 0;
+	do {
+		(void)cmd52(0, 0x03, false, 0, &rdy);
+		if (rdy & 0x02) {
+			break;
+		}
+		IOSleep(10);
+	} while (++tries < 100);
+	(void)cmd52(0, 0x110, true, 64, NULL);
+	(void)cmd52(0, 0x111, true, 0, NULL);
+	printf("A510F WIFI: function 1 ready 0x%x after %d tries\n", rdy, tries);
+	if (!(rdy & 0x02)) {
+		return;
+	}
+
+	/* 9. backplane: ALP clock (CHIPCLKCSR 0x1000e: FORCE_HW_CLKREQ_OFF | ALP_AVAIL_REQ, wait ALP_AVAIL 0x40) */
+	(void)cmd52(1, 0x1000e, true, 0x28, NULL);
+	uint8_t csr = 0;
+	tries = 0;
+	do {
+		(void)cmd52(1, 0x1000e, false, 0, &csr);
+		if (csr & 0x40) {
+			break;
+		}
+		IOSleep(1);
+	} while (++tries < 200);
+	/* keep ALP forced (brcmfmac: FORCE_HW_CLKREQ_OFF | FORCE_ALP); 0x20 alone dropped it and the backplane hung */
+	(void)cmd52(1, 0x1000e, true, 0x21, NULL);
+	printf("A510F WIFI: chip clock csr 0x%x after %d ms\n", csr, tries);
+
+	/* 10. ChipCommon chip id: window 0x18000000 (SBADDR low/mid/high), 4-byte access at +0x8000 */
+	(void)cmd52(1, 0x1000a, true, 0x00, NULL);
+	(void)cmd52(1, 0x1000b, true, 0x00, NULL);
+	(void)cmd52(1, 0x1000c, true, 0x18, NULL);
+	/* 10a. the chip id byte by byte (CMD52 into the window, no 4-byte flag) */
+	uint8_t cb[4] = {0, 0, 0, 0};
+	int e52 = 0;
+	for (unsigned b = 0; b < 4; b++) {
+		e52 |= cmd52(1, b, false, 0, &cb[b]);
+	}
+	uint32_t v = (uint32_t)cb[0] | ((uint32_t)cb[1] << 8) | ((uint32_t)cb[2] << 16) | ((uint32_t)cb[3] << 24);
+	printf("A510F WIFI: chipid by CMD52 (%d) 0x%08x: chip 0x%x (%u) rev %u, package %u, %u cores\n",
+	    e52, v, v & 0xffffu, v & 0xffffu, (v >> 16) & 0xfu, (v >> 20) & 0xfu, (v >> 24) & 0xfu);
+	/* 10b. the same with CMD53 (4 bytes, 4-byte access flag), 1-bit bus */
+	uint8_t id[4] = {0, 0, 0, 0};
+	int eid = cmd53_read(1, 0x8000, id, 4);
+	v = (uint32_t)id[0] | ((uint32_t)id[1] << 8) | ((uint32_t)id[2] << 16) | ((uint32_t)id[3] << 24);
+	printf("A510F WIFI: chipid by CMD53, 1-bit (%d) 0x%08x\n", eid, v);
+
+	/* 11. 4-bit bus, then CMD53 again */
+	uint8_t bic = 0;
+	if (cmd52(0, 0x07, false, 0, &bic) == 0 && cmd52(0, 0x07, true, (uint8_t)((bic & ~3u) | 2u), NULL) == 0) {
+		wr(w.mmc, W_CTYPE, 1);
+	}
+	uint8_t chk = 0;
+	int ebw = cmd52(0, 0x07, false, 0, &chk);
+	printf("A510F WIFI: bus interface 0x%x -> 0x%x (%d), 4-bit\n", bic, chk, ebw);
+	id[0] = id[1] = id[2] = id[3] = 0;
+	eid = cmd53_read(1, 0x8000, id, 4);
+	v = (uint32_t)id[0] | ((uint32_t)id[1] << 8) | ((uint32_t)id[2] << 16) | ((uint32_t)id[3] << 24);
+	printf("A510F WIFI: chipid by CMD53, 4-bit (%d) 0x%08x\n", eid, v);
+	/*
+	 * Round 85: the card clock was ciu/510 (~200 kHz, ~45 KB/s): too slow once
+	 * iOS uses en0 (round 84: 1973 frames dropped). Try divider 4 (ciu/8,
+	 * ~12.5 MHz), then 16; keep the first that reads the chip id 8 times right.
+	 */
+	{
+		static const uint32_t divs[] = {4u, 16u};
+		uint32_t good = 255u;
+		for (unsigned d = 0; d < 2 && good == 255u; d++) {
+			wr(w.mmc, W_CLKENA, 0);
+			(void)clk_update();
+			wr(w.mmc, W_CLKDIV, divs[d]);
+			(void)clk_update();
+			wr(w.mmc, W_CLKENA, 1);
+			(void)clk_update();
+			int okc = 0;
+			for (int k = 0; k < 8; k++) {
+				uint8_t b[4] = {0, 0, 0, 0};
+				if (cmd53_read(1, 0x8000, b, 4) == 0 && memcmp(b, &v, 4) == 0) {
+					okc++;
+				}
+			}
+			printf("A510F WIFI: card clock divider %u: %d of 8 chip id reads right\n", divs[d], okc);
+			if (okc == 8) {
+				good = divs[d];
+			}
+		}
+		if (good == 255u) {
+			wr(w.mmc, W_CLKENA, 0);
+			(void)clk_update();
+			wr(w.mmc, W_CLKDIV, 255);
+			(void)clk_update();
+			wr(w.mmc, W_CLKENA, 1);
+			(void)clk_update();
+		}
+		w_clkdiv = good;
+		printf("A510F WIFI: card clock divider %u\n", good);
+	}
+	printf("A510F WIFI: step 1 done\n");
+	wifi_step2a();
+	wifi_step2b();
+	wifi_step3();
+	wifi_step4();
+	wifi_step5();
+	wifi_step6();
+}
+
+static void
+wifi_thread(__unused void *arg, __unused wait_result_t wr_)
+{
+	IOSleep((unsigned)w.after_s * 1000u);
+	printf("A510F WIFI: step 1 (SDIO bring-up, chip id) at %d s\n", w.after_s);
+	wifi_step1();
+	thread_terminate(current_thread());
+}
+
+void
+a510f_wifi_start(void)
+{
+	w.after_s = 0;
+	PE_parse_boot_argn("a510fwifi", &w.after_s, sizeof(w.after_s));
+	if (w.after_s <= 0) {
+		return;
+	}
+	w.top = ml_io_map(CMU_TOP_PA, 0x1000);
+	w.fsys = ml_io_map(CMU_FSYS_PA, 0x1000);
+	w.pfsys = ml_io_map(PIN_FSYS_PA, 0x1000);
+	w.ptop = ml_io_map(PIN_TOP_PA, 0x1000);
+	w.mmc = ml_io_map(MMC1_PA, 0x2000);
+	thread_t th;
+	if (kernel_thread_start(wifi_thread, NULL, &th) == KERN_SUCCESS) {
+		thread_deallocate(th);
+	}
+}
