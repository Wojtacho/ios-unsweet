+/*
+ * A510F Wi-Fi (bsd/dev/a510f_wifi.c): read nsect sectors at lba inside the
+ * partition named part (NULL: absolute LBA) into dst (any kernel memory:
+ * bounced through a DMA buffer, 64 sectors a read). 0 or an errno.
+ */
+int a510f_mmc_read(const char *part, uint64_t lba, uint32_t nsect, void *dst);
+
+int
+a510f_mmc_read(const char *part, uint64_t lba, uint32_t nsect, void *dst)
+{
+	static uint8_t *bounce;
+	int error = 0;
+	uint64_t first = 0, n = UINT64_MAX;
+	mmc_lock();
+	if (bounce == NULL) {
+		bounce = mmc_alloc(64 * MMC_SECTOR);
+	}
+	if (part != NULL) {
+		error = mmc_part_find(part, &first, &n);
+	}
+	if (!error && (bounce == NULL || lba + nsect > n)) {
+		error = bounce == NULL ? ENOMEM : EINVAL;
+	}
+	for (uint32_t k = 0; !error && k < nsect; k += 64) {
+		uint32_t c = nsect - k < 64 ? nsect - k : 64;
+		error = mmc_read(first + lba + k, c, bounce);
+		if (!error) {
+			memcpy((uint8_t *)dst + (uint64_t)k * MMC_SECTOR, bounce, (size_t)c * MMC_SECTOR);
+		}
+	}
+	mmc_unlock();
+	return error;
+}
