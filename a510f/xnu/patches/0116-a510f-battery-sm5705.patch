+#if defined(SWEET_GIC_V2)
+/*
+ * SM5705 words (Samsung sm5705_fuelgauge.c): SOC 8.8 percent; voltage
+ * [13:11] V + [10:0]/2048 V; current [15] sign (set = discharging),
+ * [12:11] A + [10:0]/2048 A; temperature [15] sign, [14:8] C + [7:4]/16.
+ * Samsung's UI level is the raw SOC scaled by capacity_max 990 (99.0 %).
+ * There is no charger-chip reading yet: charging = more than 20 mA into the
+ * battery; external power = charging, or full (>= 99 %) and not discharging.
+ */
+void
+SweetBattery::pollA510F(void)
+{
+	uint16_t soc = 0, volt = 0, cur = 0, temp = 0;
+	bool ok = !a510f_fg_read(0x05, &soc) && !a510f_fg_read(0x07, &volt) &&
+	    !a510f_fg_read(0x08, &cur) && !a510f_fg_read(0x09, &temp);
+	unsigned mv = ((volt & 0x3800u) >> 11) * 1000u + ((volt & 0x07ffu) * 1000u) / 2048u;
+	unsigned raw = ((soc & 0xff00u) >> 8) * 10u + ((soc & 0x00ffu) * 10u) / 256u;     /* 0.1 % */
+	unsigned percent = (raw * 100u + 495u) / 990u;
+	if (percent > 100) {
+		percent = 100;
+	}
+	/* Zero, floating (0xffff) or implausible data must not become 0 %. */
+	if (!ok || mv < 2800 || mv > 4600 || soc == 0xffff || (percent == 0 && mv > 3500)) {
+		if (fFails++ < 5) {
+			IOLog("SWEET BATTERY: SM5705 read %s: soc 0x%04x volt 0x%04x cur 0x%04x temp 0x%04x\n",
+			    ok ? "implausible" : "failed", soc, volt, cur, temp);
+		}
+		publish(100, 4200, 0, true, true, false, true, false, false);
+		return;
+	}
+	int ma = (int)(((cur & 0x1800u) >> 11) * 1000u + ((cur & 0x07ffu) * 1000u) / 2048u);
+	if (cur & 0x8000u) {
+		ma = -ma;
+	}
+	int t = (int)(((temp & 0x7f00u) >> 8) * 10u + ((temp & 0x00f0u) * 10u) / 256u);   /* 0.1 C */
+	if (temp & 0x8000u) {
+		t = -t;
+	}
+	fTempCenti = (t > -300 && t < 800) ? (UInt32)(t * 10) : 2500;
+	bool charging = ma > 20;
+	bool external = charging || (percent >= 99 && ma > -15);
+	bool full = external && percent >= 100;
+	publish(percent, mv, ma, external, external, charging && !full, full, true, true);
+	if (fPolls++ < 3 || (fPolls % 20) == 0 || (int)external != fLastExt || (int)charging != fLastChg) {
+		IOLog("SWEET BATTERY: SM5705 %u%% (raw %u.%u%%) %umV %dmA %d.%dC external %d charging %d\n",
+		    percent, raw / 10, raw % 10, mv, ma, t / 10, (t < 0 ? -t : t) % 10, external, charging);
+	}
+	fLastExt = external;
+	fLastChg = charging;
+}
+#endif
