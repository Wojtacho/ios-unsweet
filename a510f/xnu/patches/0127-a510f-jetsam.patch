diff --git a/bsd/kern/kern_memorystatus.c b/bsd/kern/kern_memorystatus.c
index 1750d3a..e7e0d30 100644
--- a/bsd/kern/kern_memorystatus.c
+++ b/bsd/kern/kern_memorystatus.c
@@ -45,6 +45,9 @@
 #include <mach/host_priv.h>
 #include <mach/mach_host.h>
 #include <pexpert/pexpert.h>
+#if defined(__arm64__)
+#include <pexpert/arm64/board_config.h>     /* A510F: ARM64_BOARD_CONFIG_SWEET */
+#endif
 #include <sys/coalition.h>
 #include <sys/kern_event.h>
 #include <sys/proc.h>
@@ -1358,6 +1361,21 @@ memorystatus_init(void)
 		    memorystatus_jetsam_proc_size_panic);
 	}
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	/*
+	 * A510F: the iPhone 8 Plus userland's per-process memory limits are set
+	 * for a 3 GB phone, and backboardd here also hosts Mesa. Jetsam (enabled
+	 * in MASTER.arm64.sweet) kills by priority band when memory runs low;
+	 * the per-process high-water limits stay off unless sweet_memlimits=1.
+	 */
+	{
+		int limits = 0;
+		PE_parse_boot_argn("sweet_memlimits", &limits, sizeof(limits));
+		memorystatus_highwater_enabled = limits ? 1 : 0;
+		printf("A510F JETSAM: on, per-process memory limits %s\n", limits ? "on" : "off (sweet_memlimits=0)");
+	}
+#endif
+
 	/* Apply overrides */
 	if (!PE_parse_boot_argn("kern.jetsam_delta", &delta_percentage, sizeof(delta_percentage))) {
 		PE_get_default("kern.jetsam_delta", &delta_percentage, sizeof(delta_percentage));
