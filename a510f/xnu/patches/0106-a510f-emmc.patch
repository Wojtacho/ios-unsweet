@@ -0,0 +1,1008 @@
+/*
+ * A510F (Samsung Galaxy A5 2016, Exynos 7580) internal eMMC.
+ *
+ * The Synopsys DesignWare MMC host at SWEET_MMC_BASE ("samsung,exynos7580-
+ * dw-mshc", dwmmc0) is left running by S-Boot, which loaded our boot image
+ * through it: clocks, bus width/timing and the card (selected, transfer
+ * state) are reused as they are. This driver switches the host to polled
+ * PIO (no DMA, no interrupts). Commands: CMD13, CMD17/18 (read), CMD12 and,
+ * only with boot-arg mmcrw=1, CMD24/25 (write) and CMD6 cache flush.
+ *
+ *  - boot-arg mmcprobe=1: print the host state and the GPT (IOFindBSDRoot);
+ *    with mmcrw=1 mmcwtest=1 also write/verify/restore the last sector of
+ *    the mmcroot range.
+ *  - mmcroot= (default USERDATA) names one GPT partition or a range "A..B"
+ *    (first sector of A to last sector of B). It may only cover SYSTEM,
+ *    CACHE, HIDDEN and USERDATA: anything else (EFS/IMEI, modem, bootloader,
+ *    BOOT, RECOVERY ...) is refused. It is the BSD disk mmcroot0
+ *    (rmmcroot0); root on it with rd=mmcroot0. Writes never leave it.
+ *
+ * Layout and GPT handling follow sweet's bsd/dev/sweet_ufs.c.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <pexpert/arm64/board_config.h>
+#if defined(SWEET_MMC_BASE)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/buf.h>
+#include <sys/conf.h>
+#include <sys/disk.h>
+#include <sys/errno.h>
+#include <sys/proc.h>
+#include <sys/uio.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/locks.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <libkern/libkern.h>
+
+/* osfmk/arm/machine_routines.h, not exported to the BSD layer */
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+#define MMC_CTRL        0x000
+#define MMC_CLKDIV      0x008
+#define MMC_CLKENA      0x010
+#define MMC_TMOUT       0x014
+#define MMC_CTYPE       0x018
+#define MMC_BLKSIZ      0x01c
+#define MMC_BYTCNT      0x020
+#define MMC_INTMASK     0x024
+#define MMC_CMDARG      0x028
+#define MMC_CMD         0x02c
+#define MMC_RESP0       0x030
+#define MMC_RINTSTS     0x044
+#define MMC_STATUS      0x048
+#define MMC_FIFOTH      0x04c
+#define MMC_VERID       0x06c
+#define MMC_HCON        0x070
+#define MMC_UHS_REG     0x074
+#define MMC_BMOD        0x080
+/* Exynos SMU ("eMMC protector"): per-sector-range access control (Linux dw_mmc-exynos.h) */
+#define MMC_MPSECURITY  0x1010
+#define MMC_MPSBEGIN0   0x1200
+#define MMC_MPSEND0     0x1204
+#define MMC_MPSCTRL0    0x120c
+#define MPSCTRL_LINUX   0x71u   /* SECURE_WRITE | NON_SECURE_READ | NON_SECURE_WRITE | VALID */
+
+#define CTRL_RESET      (1u << 0)
+#define CTRL_FIFO_RESET (1u << 1)
+#define CTRL_INT_ENABLE (1u << 4)
+#define CTRL_DMA_ENABLE (1u << 5)
+#define CTRL_USE_IDMAC  (1u << 25)
+#define BMOD_IDMAC_EN   (1u << 7)
+
+#define INT_RESP_ERR    (1u << 1)
+#define INT_CMD_DONE    (1u << 2)
+#define INT_DATA_OVER   (1u << 3)
+#define INT_TXDR        (1u << 4)
+#define INT_RXDR        (1u << 5)
+#define INT_RCRC        (1u << 6)
+#define INT_DCRC        (1u << 7)
+#define INT_RTO         (1u << 8)
+#define INT_DRTO        (1u << 9)
+#define INT_HTO         (1u << 10)
+#define INT_FRUN        (1u << 11)
+#define INT_HLE         (1u << 12)
+#define INT_SBE         (1u << 13)
+#define INT_ACD         (1u << 14)
+#define INT_EBE         (1u << 15)
+#define INT_CMD_ERR     (INT_RESP_ERR | INT_RCRC | INT_RTO | INT_HLE)
+#define INT_DATA_ERR    (INT_DCRC | INT_DRTO | INT_HTO | INT_FRUN | INT_SBE | INT_EBE)
+
+#define CMD_START       (1u << 31)
+#define CMD_USE_HOLD    (1u << 29)
+#define CMD_STOP_ABORT  (1u << 14)
+#define CMD_PRV_DAT_WAIT (1u << 13)
+#define CMD_SEND_STOP   (1u << 12)
+#define CMD_DAT_WR      (1u << 10)
+#define CMD_DAT_EXP     (1u << 9)
+#define CMD_RESP_CRC    (1u << 8)
+#define CMD_RESP_EXP    (1u << 6)
+#define CMD_R1          (CMD_RESP_EXP | CMD_RESP_CRC)
+
+#define STATUS_DATA_BUSY (1u << 9)
+#define STATUS_FCNT(s)  (((s) >> 17) & 0x1fff)
+
+#define FIFO_DEPTH      64u                     /* dwmmc0 fifo-depth = <0x40> */
+#define MMC_SECTOR      512u
+#define MAX_XFER_BLOCKS 256u                    /* 128 KiB per CMD18 */
+#define CMD_TIMEOUT_NS  (100ull * NSEC_PER_MSEC)
+#define DATA_TIMEOUT_NS (2ull * NSEC_PER_SEC)
+#define BUSY_TIMEOUT_NS (5ull * NSEC_PER_SEC)   /* card programming after a write */
+
+static struct {
+	vm_offset_t regs;
+	uint32_t data_off;                      /* FIFO window */
+	uint32_t fifo_bytes;                    /* FIFO entry width */
+	uint32_t fifo_wmode;                    /* 64-bit FIFO writes: 0 = 2x32-bit, 1 = 1x64-bit */
+	uint32_t wr_prefill;                    /* fill the FIFO before CMD24/25 is sent */
+	uint32_t wr_r1, wr_seen;                /* last write: CMD24/25 R1, RINTSTS seen */
+	bool host_ok;
+	uint64_t first_lba, nsect;              /* partition, in 512-byte sectors */
+	uint32_t secsize;                       /* logical sector size for the BSD layer */
+	int bmajor, cmajor;
+	dev_t bdev;
+	bool ready;
+	bool writable;                          /* boot-arg mmcrw=1 */
+	char name[80];
+} sm;
+
+static LCK_GRP_DECLARE(sweet_mmc_grp, "sweet_mmc");
+static LCK_MTX_DECLARE(sweet_mmc_lock, &sweet_mmc_grp);
+
+static inline uint32_t
+mmc_rd(uint32_t off)
+{
+	return *(volatile uint32_t *)(sm.regs + off);
+}
+
+static inline void
+mmc_wr(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(sm.regs + off) = v;
+}
+
+static uint64_t
+deadline_after(uint64_t ns)
+{
+	uint64_t abs;
+	nanoseconds_to_absolutetime(ns, &abs);
+	return mach_absolute_time() + abs;
+}
+
+static bool
+mmc_wait_clear(uint32_t off, uint32_t bits, uint64_t ns)
+{
+	uint64_t end = deadline_after(ns);
+	while (mmc_rd(off) & bits) {
+		if (mach_absolute_time() > end) {
+			return false;
+		}
+	}
+	return true;
+}
+
+static int
+mmc_reset_fifo(void)
+{
+	mmc_wr(MMC_CTRL, mmc_rd(MMC_CTRL) | CTRL_FIFO_RESET);
+	return mmc_wait_clear(MMC_CTRL, CTRL_FIFO_RESET, CMD_TIMEOUT_NS) ? 0 : ETIMEDOUT;
+}
+
+/* Send a command and wait for its response; *resp gets R1 (RESP0). */
+static int
+mmc_cmd(uint32_t cmd, uint32_t arg, uint32_t *resp)
+{
+	mmc_wr(MMC_RINTSTS, INT_CMD_DONE | INT_CMD_ERR);
+	mmc_wr(MMC_CMDARG, arg);
+	mmc_wr(MMC_CMD, cmd | CMD_START | CMD_USE_HOLD);
+	if (!mmc_wait_clear(MMC_CMD, CMD_START, CMD_TIMEOUT_NS)) {
+		return ETIMEDOUT;
+	}
+	uint64_t end = deadline_after(CMD_TIMEOUT_NS);
+	uint32_t s;
+	while (!((s = mmc_rd(MMC_RINTSTS)) & (INT_CMD_DONE | INT_HLE))) {
+		if (mach_absolute_time() > end) {
+			return ETIMEDOUT;
+		}
+	}
+	mmc_wr(MMC_RINTSTS, s & (INT_CMD_DONE | INT_CMD_ERR));
+	if (resp) {
+		*resp = mmc_rd(MMC_RESP0);
+	}
+	return (s & INT_CMD_ERR) ? EIO : 0;
+}
+
+/* CMD12 STOP_TRANSMISSION after a failed multi-block read. */
+static void
+mmc_abort(void)
+{
+	(void)mmc_cmd(12 | CMD_R1 | CMD_STOP_ABORT, 0, NULL);
+	(void)mmc_wait_clear(MMC_STATUS, STATUS_DATA_BUSY, DATA_TIMEOUT_NS);
+	(void)mmc_reset_fifo();
+	mmc_wr(MMC_RINTSTS, 0xffffffff);
+}
+
+/* Copy whatever the FIFO holds to dst, at most want bytes. */
+static uint32_t
+mmc_drain(uint8_t *dst, uint32_t want)
+{
+	uint32_t n = STATUS_FCNT(mmc_rd(MMC_STATUS)), got = 0;
+	volatile uint8_t *fifo = (volatile uint8_t *)(sm.regs + sm.data_off);
+	while (n-- && got < want) {
+		if (sm.fifo_bytes == 8) {
+			/*
+			 * Exynos 7580: 32-bit SFR accesses only, also for the 64-bit
+			 * FIFO (Samsung's CONFIG_MMC_DW_FORCE_32BIT_SFR_RW mci_readq:
+			 * low word at DATA, high word at DATA + 4). A 64-bit load
+			 * did not pop the FIFO: the first read ended in HTO.
+			 */
+			uint32_t v[2];
+			v[0] = *(volatile uint32_t *)fifo;
+			v[1] = *(volatile uint32_t *)(fifo + 4);
+			memcpy(dst + got, v, MIN(8u, want - got));
+			got += 8;
+		} else {
+			uint32_t v = *(volatile uint32_t *)fifo;
+			memcpy(dst + got, &v, MIN(4u, want - got));
+			got += 4;
+		}
+	}
+	return MIN(got, want);
+}
+
+/* Data-in command: nblk blocks of blksz bytes into dst (*r1 = its R1). */
+static int
+mmc_rdata(uint32_t op, uint32_t arg, uint32_t blksz, uint32_t nblk, uint8_t *dst, uint32_t *r1)
+{
+	uint64_t lba = arg;
+	if (!mmc_wait_clear(MMC_STATUS, STATUS_DATA_BUSY, DATA_TIMEOUT_NS)) {
+		return EBUSY;
+	}
+	int error = mmc_reset_fifo();
+	if (error) {
+		return error;
+	}
+	mmc_wr(MMC_RINTSTS, 0xffffffff);
+	mmc_wr(MMC_BLKSIZ, blksz);
+	mmc_wr(MMC_BYTCNT, nblk * blksz);
+	uint32_t cmd = CMD_DAT_EXP | CMD_R1 | CMD_PRV_DAT_WAIT | op;
+	mmc_wr(MMC_CMDARG, arg);
+	mmc_wr(MMC_CMD, cmd | CMD_START | CMD_USE_HOLD);
+	if (!mmc_wait_clear(MMC_CMD, CMD_START, CMD_TIMEOUT_NS)) {
+		return ETIMEDOUT;
+	}
+
+	uint32_t total = nblk * blksz, got = 0, seen = 0;
+	uint64_t end = deadline_after(DATA_TIMEOUT_NS);
+	/* First few (rintsts, status, bytes) samples, printed if the read fails. */
+	uint32_t trace[8][3];
+	unsigned ntrace = 0;
+	for (;;) {
+		uint32_t s = mmc_rd(MMC_RINTSTS);
+		seen |= s;
+		/* Empty the FIFO first: a full FIFO with no reader raises HTO. */
+		uint32_t before = got;
+		got += mmc_drain(dst + got, total - got);
+		if (ntrace < 8 && (got != before || s)) {
+			trace[ntrace][0] = s;
+			trace[ntrace][1] = mmc_rd(MMC_STATUS);
+			trace[ntrace][2] = got;
+			ntrace++;
+		}
+		/* HTO only means "the FIFO filled up": not fatal while data flows. */
+		if ((s & INT_HTO) && got != before) {
+			mmc_wr(MMC_RINTSTS, INT_HTO);
+			s &= ~INT_HTO;
+		}
+		if (s & (INT_CMD_ERR | INT_DATA_ERR)) {
+			printf("SWEET MMC: read lba %llu x%u failed, rintsts 0x%x, %u/%u bytes\n",
+			    lba, nblk, s, got, total);
+			for (unsigned i = 0; i < ntrace; i++) {
+				printf("SWEET MMC:   rintsts 0x%x status 0x%x bytes %u\n",
+				    trace[i][0], trace[i][1], trace[i][2]);
+			}
+			mmc_abort();
+			return EIO;
+		}
+		if (s & INT_RXDR) {
+			mmc_wr(MMC_RINTSTS, INT_RXDR);
+		}
+		if (s & INT_DATA_OVER) {
+			got += mmc_drain(dst + got, total - got);
+			break;
+		}
+		if (mach_absolute_time() > end) {
+			printf("SWEET MMC: read lba %llu x%u timed out, %u/%u bytes, rintsts 0x%x\n",
+			    lba, nblk, got, total, s);
+			mmc_abort();
+			return ETIMEDOUT;
+		}
+	}
+	/* Multi-block: wait for the automatic CMD12 too. */
+	if (nblk > 1) {
+		uint64_t stop_end = deadline_after(CMD_TIMEOUT_NS);
+		while (!((seen |= mmc_rd(MMC_RINTSTS)) & INT_ACD)) {
+			if (mach_absolute_time() > stop_end) {
+				break;
+			}
+		}
+	}
+	if (r1) {
+		*r1 = mmc_rd(MMC_RESP0);
+	}
+	mmc_wr(MMC_RINTSTS, 0xffffffff);
+	return got == total ? 0 : EIO;
+}
+
+/* Read nblk 512-byte sectors at lba (card address) into dst. */
+static int
+mmc_read(uint64_t lba, uint32_t nblk, uint8_t *dst)
+{
+	if (nblk == 0) {
+		return 0;
+	}
+	if (nblk > MAX_XFER_BLOCKS || lba + nblk > UINT32_MAX) {
+		return EINVAL;
+	}
+	return mmc_rdata(nblk > 1 ? (18 | CMD_SEND_STOP) : 17, (uint32_t)lba,
+	           MMC_SECTOR, nblk, dst, NULL);
+}
+
+/* Copy up to want bytes from src into the FIFO's free entries. */
+static uint32_t
+mmc_fill(const uint8_t *src, uint32_t want)
+{
+	uint32_t used = STATUS_FCNT(mmc_rd(MMC_STATUS)), put = 0;
+	uint32_t room = used < FIFO_DEPTH ? FIFO_DEPTH - used : 0;
+	volatile uint8_t *fifo = (volatile uint8_t *)(sm.regs + sm.data_off);
+	while (room-- && put < want) {
+		if (sm.fifo_bytes == 8) {
+			uint32_t v[2] = { 0, 0 };
+			memcpy(v, src + put, MIN(8u, want - put));
+			if (sm.fifo_wmode == 1) {
+				uint64_t q = (uint64_t)v[1] << 32 | v[0];
+				*(volatile uint64_t *)fifo = q;
+			} else {
+				*(volatile uint32_t *)fifo = v[0];
+				*(volatile uint32_t *)(fifo + 4) = v[1];
+			}
+			put += 8;
+		} else {
+			uint32_t v = 0;
+			memcpy(&v, src + put, MIN(4u, want - put));
+			*(volatile uint32_t *)fifo = v;
+			put += 4;
+		}
+	}
+	return MIN(put, want);
+}
+
+/* Write nblk 512-byte sectors from src at lba (card address). */
+static int
+mmc_write(uint64_t lba, uint32_t nblk, const uint8_t *src)
+{
+	if (nblk == 0) {
+		return 0;
+	}
+	if (!sm.writable || nblk > MAX_XFER_BLOCKS || lba + nblk > UINT32_MAX) {
+		return EINVAL;
+	}
+	if (!mmc_wait_clear(MMC_STATUS, STATUS_DATA_BUSY, BUSY_TIMEOUT_NS)) {
+		return EBUSY;
+	}
+	int error = mmc_reset_fifo();
+	if (error) {
+		return error;
+	}
+	mmc_wr(MMC_RINTSTS, 0xffffffff);
+	mmc_wr(MMC_BLKSIZ, MMC_SECTOR);
+	mmc_wr(MMC_BYTCNT, nblk * MMC_SECTOR);
+	uint32_t total = nblk * MMC_SECTOR;
+	/* The host accepts FIFO data before the command starts. */
+	uint32_t put = sm.wr_prefill ? mmc_fill(src, total) : 0;
+	uint32_t cmd = CMD_DAT_EXP | CMD_DAT_WR | CMD_R1 | CMD_PRV_DAT_WAIT |
+	    (nblk > 1 ? (25 | CMD_SEND_STOP) : 24);
+	mmc_wr(MMC_CMDARG, (uint32_t)lba);
+	mmc_wr(MMC_CMD, cmd | CMD_START | CMD_USE_HOLD);
+	if (!mmc_wait_clear(MMC_CMD, CMD_START, CMD_TIMEOUT_NS)) {
+		mmc_abort();
+		return ETIMEDOUT;
+	}
+	uint32_t seen = 0;
+	uint64_t end = deadline_after(BUSY_TIMEOUT_NS);
+	for (;;) {
+		uint32_t s = mmc_rd(MMC_RINTSTS);
+		seen |= s;
+		uint32_t before = put;
+		put += mmc_fill(src + put, total - put);
+		/* HTO on a write = FIFO ran empty: not fatal while we keep filling. */
+		if ((s & INT_HTO) && put != before) {
+			mmc_wr(MMC_RINTSTS, INT_HTO);
+			s &= ~INT_HTO;
+		}
+		if (s & (INT_CMD_ERR | INT_DATA_ERR)) {
+			printf("SWEET MMC: write lba %llu x%u failed, rintsts 0x%x, %u/%u bytes\n",
+			    lba, nblk, s, put, total);
+			mmc_abort();
+			return EIO;
+		}
+		if (s & INT_TXDR) {
+			mmc_wr(MMC_RINTSTS, INT_TXDR);
+		}
+		if (s & INT_DATA_OVER) {
+			break;
+		}
+		if (mach_absolute_time() > end) {
+			printf("SWEET MMC: write lba %llu x%u timed out, %u/%u bytes, rintsts 0x%x\n",
+			    lba, nblk, put, total, s);
+			mmc_abort();
+			return ETIMEDOUT;
+		}
+	}
+	if (nblk > 1) {
+		uint64_t stop_end = deadline_after(CMD_TIMEOUT_NS);
+		while (!((seen |= mmc_rd(MMC_RINTSTS)) & INT_ACD)) {
+			if (mach_absolute_time() > stop_end) {
+				break;
+			}
+		}
+	}
+	sm.wr_r1 = mmc_rd(MMC_RESP0);
+	sm.wr_seen = seen;
+	/* Wait while the card programs the data (DAT0 busy). */
+	bool idle = mmc_wait_clear(MMC_STATUS, STATUS_DATA_BUSY, BUSY_TIMEOUT_NS);
+	mmc_wr(MMC_RINTSTS, 0xffffffff);
+	if (!idle) {
+		printf("SWEET MMC: write lba %llu x%u: card still busy\n", lba, nblk);
+		return ETIMEDOUT;
+	}
+	return put == total ? 0 : EIO;
+}
+
+/* CMD6 SWITCH: EXT_CSD[32] FLUSH_CACHE = 1 (ignored by cards without a cache). */
+static int
+mmc_flush(void)
+{
+	if (!sm.writable) {
+		return 0;
+	}
+	(void)mmc_cmd(6 | CMD_R1, (3u << 24) | (32u << 16) | (1u << 8), NULL);
+	return mmc_wait_clear(MMC_STATUS, STATUS_DATA_BUSY, BUSY_TIMEOUT_NS) ? 0 : ETIMEDOUT;
+}
+
+/* Reuse the host S-Boot left running; polled PIO from here on. */
+static int
+mmc_take_over_host(bool verbose)
+{
+	if (sm.host_ok) {
+		return 0;
+	}
+	sm.regs = ml_io_map(SWEET_MMC_BASE, SWEET_MMC_SIZE);
+	if (!sm.regs) {
+		return ENOMEM;
+	}
+	uint32_t verid = mmc_rd(MMC_VERID) & 0xffff, hcon = mmc_rd(MMC_HCON);
+	uint32_t ctrl = mmc_rd(MMC_CTRL), bmod = mmc_rd(MMC_BMOD);
+	if (verbose) {
+		printf("SWEET MMC: verid 0x%x hcon 0x%x ctrl 0x%x bmod 0x%x clkena 0x%x clkdiv 0x%x\n",
+		    verid, hcon, ctrl, bmod, mmc_rd(MMC_CLKENA), mmc_rd(MMC_CLKDIV));
+		printf("SWEET MMC: ctype 0x%x uhs 0x%x status 0x%x fifoth 0x%x tmout 0x%x intmask 0x%x\n",
+		    mmc_rd(MMC_CTYPE), mmc_rd(MMC_UHS_REG), mmc_rd(MMC_STATUS),
+		    mmc_rd(MMC_FIFOTH), mmc_rd(MMC_TMOUT), mmc_rd(MMC_INTMASK));
+	}
+	if (verid == 0 || verid == 0xffff) {
+		printf("SWEET MMC: no DesignWare MMC host at 0x%x\n", SWEET_MMC_BASE);
+		return ENXIO;
+	}
+	sm.data_off = verid >= 0x240a ? 0x200 : 0x100;
+	switch ((hcon >> 7) & 7) {     /* H_DATA_WIDTH */
+	case 2:
+		sm.fifo_bytes = 8;
+		break;
+	case 1:
+		sm.fifo_bytes = 4;
+		break;
+	default:
+		printf("SWEET MMC: unsupported FIFO width (hcon 0x%x)\n", hcon);
+		return ENXIO;
+	}
+	/* Polled PIO: no interrupts, no internal DMA. */
+	mmc_wr(MMC_INTMASK, 0);
+	mmc_wr(MMC_CTRL, ctrl & ~(CTRL_INT_ENABLE | CTRL_DMA_ENABLE | CTRL_USE_IDMAC));
+	mmc_wr(MMC_BMOD, bmod & ~BMOD_IDMAC_EN);
+	mmc_wr(MMC_RINTSTS, 0xffffffff);
+
+	/* CMD13 SEND_STATUS, RCA 1 (Linux and bootloaders give the eMMC RCA 1). */
+	uint32_t r1 = 0;
+	int error = mmc_cmd(13 | CMD_R1, 1u << 16, &r1);
+	if (verbose) {
+		printf("SWEET MMC: CMD13 %s, R1 0x%x (state %u, 4 = transfer)\n",
+		    error ? "failed" : "ok", r1, (r1 >> 9) & 0xf);
+	}
+	sm.host_ok = true;
+	return 0;
+}
+
+static uint8_t *
+mmc_alloc(size_t size)
+{
+	return (uint8_t *)kalloc_data(size, Z_WAITOK | Z_ZERO);
+}
+
+/* Partitions mmcroot may cover. Everything else holds firmware/IMEI/boot. */
+static bool
+mmc_root_allowed(const char *name)
+{
+	return strcmp(name, "SYSTEM") == 0 || strcmp(name, "CACHE") == 0 ||
+	       strcmp(name, "HIDDEN") == 0 || strcmp(name, "USERDATA") == 0;
+}
+
+static void
+mmc_entry_name(const uint8_t *e, char name[37])
+{
+	unsigned c;
+	for (c = 0; c < 36; c++) {
+		uint16_t ch = (uint16_t)(e[56 + 2 * c] | e[57 + 2 * c] << 8);
+		if (ch == 0 || ch > 0x7f) {
+			break;
+		}
+		name[c] = (char)ch;
+	}
+	name[c] = 0;
+}
+
+/*
+ * Walk the GPT. With want == NULL print every partition; otherwise record
+ * the partition (or "A..B" range) named want.
+ */
+static int
+mmc_gpt(const char *want)
+{
+	uint8_t *b = mmc_alloc(MAX_XFER_BLOCKS * MMC_SECTOR);
+	int error = mmc_read(1, 1, b);
+	if (error) {
+		goto out;
+	}
+	if (want == NULL) {
+		printf("SWEET MMC: LBA 1: %02x %02x %02x %02x %02x %02x %02x %02x (\"EFI PART\" = 45 46 49 20 50 41 52 54)\n",
+		    b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7]);
+	}
+	if (memcmp(b, "EFI PART", 8) != 0) {
+		printf("SWEET MMC: no GPT at LBA 1 (%02x %02x %02x %02x)\n", b[0], b[1], b[2], b[3]);
+		error = ENXIO;
+		goto out;
+	}
+	uint64_t entry_lba, last_lba;
+	uint32_t nent, esz;
+	memcpy(&last_lba, b + 32, 8);
+	memcpy(&entry_lba, b + 72, 8);
+	memcpy(&nent, b + 80, 4);
+	memcpy(&esz, b + 84, 4);
+	if (want == NULL) {
+		printf("SWEET MMC: GPT: %u entries at LBA %llu, disk %llu MiB\n",
+		    nent, entry_lba, (last_lba + 1) * MMC_SECTOR >> 20);
+	}
+	if (esz != 128 || nent == 0 || nent > 128) {
+		printf("SWEET MMC: unsupported GPT entries %u x %u\n", nent, esz);
+		error = ENXIO;
+		goto out;
+	}
+	error = mmc_read(entry_lba, (nent * esz + MMC_SECTOR - 1) / MMC_SECTOR, b);
+	if (error) {
+		goto out;
+	}
+	error = want ? ENOENT : 0;
+	int shown = 0;
+	char line[160] = "";
+	char lo[37] = "", hi[37] = "";
+	bool found_lo = false, found_hi = false;
+	uint64_t lo_first = 0, hi_last = 0;
+	if (want) {
+		const char *dots = NULL;
+		for (const char *q = want; *q && q[1]; q++) {
+			if (q[0] == '.' && q[1] == '.') {
+				dots = q;
+				break;
+			}
+		}
+		if (dots) {
+			strlcpy(lo, want, MIN(sizeof(lo), (size_t)(dots - want) + 1));
+			strlcpy(hi, dots + 2, sizeof(hi));
+		} else {
+			strlcpy(lo, want, sizeof(lo));
+			strlcpy(hi, want, sizeof(hi));
+		}
+	}
+	for (uint32_t i = 0; i < nent; i++) {
+		const uint8_t *e = b + i * esz;
+		uint64_t first, last;
+		memcpy(&first, e + 32, 8);
+		memcpy(&last, e + 40, 8);
+		if (first == 0 && last == 0) {
+			continue;
+		}
+		char name[37];
+		mmc_entry_name(e, name);
+		if (want == NULL) {
+			/* Three per line: NAME lba+size(MiB) */
+			char item[56];
+			snprintf(item, sizeof(item), "%-10s %7llu+%-5llu ", name, first,
+			    (last - first + 1) * MMC_SECTOR >> 20);
+			strlcat(line, item, sizeof(line));
+			if (++shown % 3 == 0) {
+				printf("SWEET MMC: %s\n", line);
+				line[0] = 0;
+			}
+			continue;
+		}
+		if (strcmp(name, lo) == 0) {
+			lo_first = first;
+			found_lo = true;
+		}
+		if (strcmp(name, hi) == 0) {
+			hi_last = last;
+			found_hi = true;
+		}
+	}
+	if (want == NULL && line[0]) {
+		printf("SWEET MMC: %s\n", line);
+	}
+	if (want && found_lo && found_hi && hi_last >= lo_first) {
+		/* Refuse a range that touches anything but the iOS-root partitions. */
+		error = 0;
+		for (uint32_t i = 0; i < nent; i++) {
+			const uint8_t *e = b + i * esz;
+			uint64_t first, last;
+			memcpy(&first, e + 32, 8);
+			memcpy(&last, e + 40, 8);
+			if ((first == 0 && last == 0) || last < lo_first || first > hi_last) {
+				continue;
+			}
+			char name[37];
+			mmc_entry_name(e, name);
+			if (!mmc_root_allowed(name)) {
+				printf("SWEET MMC: refusing \"%s\": it covers %s\n", want, name);
+				error = EPERM;
+			}
+		}
+		if (!error) {
+			sm.first_lba = lo_first;
+			sm.nsect = hi_last - lo_first + 1;
+			strlcpy(sm.name, want, sizeof(sm.name));
+		}
+	}
+	if (want && error == ENOENT) {
+		printf("SWEET MMC: no GPT partition (range) \"%s\"\n", want);
+	}
+out:
+	kfree_data(b, MAX_XFER_BLOCKS * MMC_SECTOR);
+	return error;
+}
+
+/* boot-arg mmcprobe=1: show what the eMMC looks like, change nothing. */
+void sweet_mmc_probe(void);
+
+void
+sweet_mmc_probe(void)
+{
+	lck_mtx_lock(&sweet_mmc_lock);
+	int error = mmc_take_over_host(true);
+	if (!error) {
+		error = mmc_gpt(NULL);
+	}
+	uint32_t rw = 0, wtest = 0;
+	PE_parse_boot_argn("mmcrw", &rw, sizeof(rw));
+	PE_parse_boot_argn("mmcwtest", &wtest, sizeof(wtest));
+	if (!error && rw == 1 && wtest == 1) {
+		char want[64] = "USERDATA";
+		PE_parse_boot_argn("mmcroot", want, sizeof(want));
+		error = mmc_gpt(want);
+		if (!error) {
+			printf("SWEET MMC: range \"%s\": first LBA %llu, %llu MiB\n",
+			    sm.name, sm.first_lba, sm.nsect * MMC_SECTOR >> 20);
+			/* Last sector of the range: save, write a pattern, verify, restore. */
+			uint64_t lba = sm.first_lba + sm.nsect - 1;
+			uint8_t *orig = mmc_alloc(MMC_SECTOR), *pat = mmc_alloc(MMC_SECTOR),
+			    *back = mmc_alloc(MMC_SECTOR);
+			for (unsigned i = 0; i < MMC_SECTOR; i++) {
+				pat[i] = (uint8_t)(0xa5 ^ i ^ (lba >> (8 * (i & 3))));
+			}
+			sm.writable = true;
+			int r1 = mmc_read(lba, 1, orig);
+			unsigned nz = 0;
+			for (unsigned i = 0; i < MMC_SECTOR; i++) {
+				nz += orig[i] != 0;
+			}
+			printf("SWEET MMC: wtest LBA %llu read %d, %u non-zero bytes, %02x %02x %02x %02x %02x %02x %02x %02x\n",
+			    lba, r1, nz, orig[0], orig[1], orig[2], orig[3], orig[4], orig[5], orig[6], orig[7]);
+			printf("SWEET MMC: wtest pattern %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x\n",
+			    pat[0], pat[1], pat[2], pat[3], pat[4], pat[5], pat[6], pat[7], pat[8], pat[9], pat[10], pat[11]);
+			/* Known buffers to recognise what actually reaches the card. */
+			uint8_t *ext = mmc_alloc(MMC_SECTOR), *gpt = mmc_alloc(MMC_SECTOR);
+			int e = mmc_rdata(8, 0, MMC_SECTOR, 1, ext, NULL);
+			int g = mmc_read(1, 1, gpt);
+			printf("SWEET MMC: EXT_CSD %d, GPT header %d (%c%c%c%c)\n", e, g, gpt[0], gpt[1], gpt[2], gpt[3]);
+
+			/* FIFO loopback: does a CPU write land in the FIFO at all? */
+			volatile uint32_t *fw = (volatile uint32_t *)(sm.regs + sm.data_off);
+			for (uint32_t mode = 0; mode < 2; mode++) {
+				(void)mmc_reset_fifo();
+				sm.fifo_wmode = mode;
+				static const uint8_t lp[16] = {
+					0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77, 0x88,
+					0x99, 0xaa, 0xbb, 0xcc, 0xdd, 0xee, 0xf0, 0x0f,
+				};
+				uint32_t s0 = mmc_rd(MMC_STATUS);
+				uint32_t n = mmc_fill(lp, sizeof(lp));
+				uint32_t s1 = mmc_rd(MMC_STATUS);
+				uint32_t v0 = fw[0], v1 = fw[1], v2 = fw[0], v3 = fw[1];
+				uint32_t s2 = mmc_rd(MMC_STATUS);
+				printf("SWEET MMC: FIFO mode %u: put %u, status 0x%x fcnt %u -> 0x%x fcnt %u, read %08x %08x %08x %08x -> fcnt %u\n",
+				    mode, n, s0, STATUS_FCNT(s0), s1, STATUS_FCNT(s1), v0, v1, v2, v3, STATUS_FCNT(s2));
+			}
+			(void)mmc_reset_fifo();
+
+			int good = -1;
+			for (uint32_t t = 0; !r1 && t < 3 && good < 0; t++) {
+				/* 0: Linux order (command, then data on TXDR) 2x32; 1: same, 64-bit; 2: prefill 2x32 */
+				sm.fifo_wmode = t == 1 ? 1 : 0;
+				sm.wr_prefill = t == 2;
+				/* Leave the GPT header in the FIFO RAM as the stale-data marker. */
+				(void)mmc_read(1, 1, back);
+				int w = mmc_write(lba, 1, pat);
+				memset(back, 0xee, MMC_SECTOR);
+				int r = mmc_read(lba, 1, back);
+				unsigned bad = 0, eqext = 0, eqgpt = 0, nzf = MMC_SECTOR, nzl = 0;
+				for (unsigned i = 0; i < MMC_SECTOR; i++) {
+					bad += back[i] != pat[i];
+					eqext += back[i] == ext[i];
+					eqgpt += back[i] == gpt[i];
+					if (back[i]) {
+						nzf = MIN(nzf, i);
+						nzl = i;
+					}
+				}
+				printf("SWEET MMC: try %u (%s, mode %u) write %d R1 0x%x int 0x%x read %d: %u bad, %u =EXT_CSD(old), %u =GPT, nz %u..%u\n",
+				    t, sm.wr_prefill ? "prefill" : "on TXDR", sm.fifo_wmode, w, sm.wr_r1, sm.wr_seen, r,
+				    bad, eqext, eqgpt, nzf, nzl);
+				printf("SWEET MMC:   back %02x %02x %02x %02x %02x %02x %02x %02x\n",
+				    back[0], back[1], back[2], back[3], back[4], back[5], back[6], back[7]);
+				if (!w && !r && bad == 0) {
+					good = (int)t;
+				}
+			}
+			kfree_data(ext, MMC_SECTOR);
+			kfree_data(gpt, MMC_SECTOR);
+			/* The sector was all zeros before the first write test (eleventh boot). */
+			bzero(orig, MMC_SECTOR);
+			sm.fifo_wmode = good == 1 ? 1 : 0;
+			sm.wr_prefill = good == 2;
+			int w2 = r1 ? -1 : mmc_write(lba, 1, orig);
+			int r3 = w2 ? -1 : mmc_read(lba, 1, back);
+			bool restored = !r3 && memcmp(orig, back, MMC_SECTOR) == 0;
+			int fl = mmc_flush();
+			sm.writable = false;
+			printf("SWEET MMC: write test: try %d %s, zeroed %s, flush %d\n",
+			    good, good >= 0 ? "OK" : "FAILED", restored ? "OK" : "FAILED", fl);
+			error = (good >= 0 && restored) ? 0 : EIO;
+			kfree_data(orig, MMC_SECTOR);
+			kfree_data(pat, MMC_SECTOR);
+			kfree_data(back, MMC_SECTOR);
+		}
+	}
+	lck_mtx_unlock(&sweet_mmc_lock);
+	printf("SWEET MMC: probe %s (%d)\n", error ? "FAILED" : "done", error);
+}
+
+static int
+sweet_mmc_open(__unused dev_t dev, int flags, __unused int devtype, __unused struct proc *p)
+{
+	if (!sm.ready) {
+		return ENXIO;
+	}
+	return ((flags & FWRITE) && !sm.writable) ? EROFS : 0;
+}
+
+static int
+sweet_mmc_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+static void
+sweet_mmc_strategy(buf_t bp)
+{
+	int error = 0;
+	caddr_t vaddr = NULL;
+	uint64_t off = (uint64_t)buf_blkno(bp) * sm.secsize;
+	uint32_t count = buf_count(bp);
+	uint64_t part_bytes = sm.nsect * MMC_SECTOR;
+
+	bool rd = (buf_flags(bp) & B_READ) != 0;
+	buf_setresid(bp, count);
+	if (!rd && !sm.writable) {
+		error = EROFS;
+		goto done;
+	}
+	if (off > part_bytes || count > part_bytes - off ||
+	    (off % MMC_SECTOR) || (count % MMC_SECTOR)) {
+		error = EINVAL;
+		goto done;
+	}
+	if (count == 0) {
+		goto done;
+	}
+	if (buf_map(bp, &vaddr)) {
+		error = EIO;
+		goto done;
+	}
+
+	lck_mtx_lock(&sweet_mmc_lock);
+	for (uint32_t done = 0; done < count;) {
+		uint32_t nblk = MIN((count - done) / MMC_SECTOR, MAX_XFER_BLOCKS);
+		uint64_t lba = sm.first_lba + (off + done) / MMC_SECTOR;
+		error = rd ? mmc_read(lba, nblk, (uint8_t *)vaddr + done) :
+		    mmc_write(lba, nblk, (const uint8_t *)vaddr + done);
+		if (error) {
+			break;
+		}
+		done += nblk * MMC_SECTOR;
+		buf_setresid(bp, count - done);
+	}
+	lck_mtx_unlock(&sweet_mmc_lock);
+	buf_unmap(bp);
+
+done:
+	if (error) {
+		buf_seterror(bp, error);
+	}
+	buf_biodone(bp);
+}
+
+static int
+sweet_mmc_ioctl(__unused dev_t dev, u_long cmd, caddr_t data, __unused int flag,
+    __unused struct proc *p, int is_char)
+{
+	uint32_t *f = (uint32_t *)data;
+	uint64_t *o = (uint64_t *)data;
+
+	switch (cmd) {
+	case DKIOCGETBLOCKSIZE:
+		*f = sm.secsize;
+		return 0;
+	case DKIOCSETBLOCKSIZE:
+		if (is_char) {
+			return ENODEV;
+		}
+		if (*f < DEV_BSIZE || *f > 4096 || (*f & (*f - 1))) {
+			return EINVAL;
+		}
+		sm.secsize = *f;
+		return 0;
+	case DKIOCGETPHYSICALBLOCKSIZE:
+		*f = MMC_SECTOR;
+		return 0;
+	case DKIOCGETBLOCKCOUNT:
+		*o = sm.nsect * MMC_SECTOR / sm.secsize;
+		return 0;
+	case DKIOCISWRITABLE:
+		*f = sm.writable ? 1 : 0;
+		return 0;
+	case DKIOCSYNCHRONIZE: {
+		lck_mtx_lock(&sweet_mmc_lock);
+		int error = mmc_flush();
+		lck_mtx_unlock(&sweet_mmc_lock);
+		return error;
+	}
+	case DKIOCGETMAXBLOCKCOUNTREAD:
+		*o = MAX_XFER_BLOCKS * MMC_SECTOR / sm.secsize;
+		return 0;
+	case DKIOCGETMAXBLOCKCOUNTWRITE:
+		*o = sm.writable ? MAX_XFER_BLOCKS * MMC_SECTOR / sm.secsize : 0;
+		return 0;
+	case DKIOCGETMAXSEGMENTCOUNTREAD:
+	case DKIOCGETMAXSEGMENTCOUNTWRITE:
+		*o = 1;
+		return 0;
+	default:
+		return ENOTTY;
+	}
+}
+
+static int
+sweet_mmc_bioctl(dev_t dev, u_long cmd, caddr_t data, int flag, struct proc *p)
+{
+	return sweet_mmc_ioctl(dev, cmd, data, flag, p, 0);
+}
+
+static int
+sweet_mmc_cioctl(dev_t dev, u_long cmd, caddr_t data, int flag, struct proc *p)
+{
+	return sweet_mmc_ioctl(dev, cmd, data, flag, p, 1);
+}
+
+static int
+sweet_mmc_psize(__unused dev_t dev)
+{
+	return sm.ready ? (int)MIN(sm.nsect * MMC_SECTOR / sm.secsize, INT_MAX) : -1;
+}
+
+static int
+sweet_mmc_read(dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	return physio(sweet_mmc_strategy, NULL, dev, B_READ, minphys, uio, (int)sm.secsize);
+}
+
+static int
+sweet_mmc_write(dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	if (!sm.writable) {
+		return EROFS;
+	}
+	return physio(sweet_mmc_strategy, NULL, dev, B_WRITE, minphys, uio, (int)sm.secsize);
+}
+
+static const struct bdevsw sweet_mmc_bdevsw = {
+	.d_open     = sweet_mmc_open,
+	.d_close    = sweet_mmc_close,
+	.d_strategy = sweet_mmc_strategy,
+	.d_ioctl    = sweet_mmc_bioctl,
+	.d_dump     = eno_dump,
+	.d_psize    = sweet_mmc_psize,
+	.d_type     = D_DISK,
+};
+
+static const struct cdevsw sweet_mmc_cdevsw = {
+	.d_open       = sweet_mmc_open,
+	.d_close      = sweet_mmc_close,
+	.d_read       = sweet_mmc_read,
+	.d_write      = sweet_mmc_write,
+	.d_ioctl      = sweet_mmc_cioctl,
+	.d_stop       = eno_stop,
+	.d_reset      = eno_reset,
+	.d_ttys       = NULL,
+	.d_select     = eno_select,
+	.d_mmap       = eno_mmap,
+	.d_strategy   = eno_strat,
+	.d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc,
+	.d_type       = D_DISK,
+};
+
+static int
+sweet_mmc_init(void)
+{
+	char want[64] = "USERDATA";
+	uint32_t rw = 0;
+	PE_parse_boot_argn("mmcroot", want, sizeof(want));
+	PE_parse_boot_argn("mmcrw", &rw, sizeof(rw));
+	sm.secsize = DEV_BSIZE;
+
+	lck_mtx_lock(&sweet_mmc_lock);
+	int error = mmc_take_over_host(false);
+	if (!error) {
+		error = mmc_gpt(want);
+	}
+	lck_mtx_unlock(&sweet_mmc_lock);
+	if (error) {
+		return error;
+	}
+
+	sm.bmajor = bdevsw_add(-1, &sweet_mmc_bdevsw);
+	if (sm.bmajor < 0) {
+		return ENXIO;
+	}
+	sm.cmajor = cdevsw_add_with_bdev(-1, &sweet_mmc_cdevsw, sm.bmajor);
+	if (sm.cmajor < 0) {
+		return ENXIO;
+	}
+	sm.bdev = makedev(sm.bmajor, 0);
+	devfs_make_node(sm.bdev, DEVFS_BLOCK, UID_ROOT, GID_OPERATOR, 0640, "mmcroot0");
+	devfs_make_node(makedev(sm.cmajor, 0), DEVFS_CHAR, UID_ROOT, GID_OPERATOR, 0640, "rmmcroot0");
+	sm.writable = (rw == 1);
+	sm.ready = true;
+	printf("SWEET MMC: \"%s\": first LBA %llu, %llu MiB, %s\n",
+	    sm.name, sm.first_lba, sm.nsect * MMC_SECTOR >> 20,
+	    sm.writable ? "read-write" : "read-only");
+	return 0;
+}
+
+/* Root device for rd=mmcroot0 (IOFindBSDRoot). */
+int sweet_mmc_rootdev(dev_t *dev);
+
+int
+sweet_mmc_rootdev(dev_t *dev)
+{
+	if (!sm.ready) {
+		int error = sweet_mmc_init();
+		if (error) {
+			return error;
+		}
+	}
+	*dev = sm.bdev;
+	return 0;
+}
+#endif /* SWEET_MMC_BASE */
+#endif /* ARM64_BOARD_CONFIG_SWEET */
