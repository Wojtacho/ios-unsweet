diff --git a/bsd/vfs/vfs_vnops.c b/bsd/vfs/vfs_vnops.c
--- a/bsd/vfs/vfs_vnops.c
+++ b/bsd/vfs/vfs_vnops.c
@@ -697,6 +697,24 @@
 		fmode &= ~O_TRUNC;
 	}
 
+#if defined(__arm64__)
+	/* A510F: SpringBoard exit(1)s on SQLITE_CORRUPT (ProactiveSupport, rounds 86-90): which databases it opens */
+	if (vp != NULLVP && (!strcmp(current_proc()->p_comm, "SpringBoard") || !strcmp(current_proc()->p_comm, "duetexpertd"))) {
+		static int told;
+		char pb[512];
+		int pl = sizeof(pb);
+		bool hit = false;
+		if (told < 60 && vn_getpath(vp, pb, &pl) == 0) {
+			for (const char *q = pb; *q != 0 && !hit; q++) {
+				hit = !strncmp(q, ".db", 3) || !strncmp(q, ".sqlite", 7) || !strncmp(q, "orrupt", 6);
+			}
+		}
+		if (hit) {
+			told++;
+			printf("A510F OPEN: %s %s fmode 0x%x\n", current_proc()->p_comm, pb, fmode);
+		}
+	}
+#endif
 	*fmodep = fmode;
 	return 0;
 
