+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * A510F: boot-arg sweetenv=NAME:VAR=VAL[,VAR=VAL...][;NAME2:...] adds
+ * VAR=VAL to the environment of every executable whose file name is NAME
+ * (after joranv1/ios-sailfish's sweetenv). Used to load the GL library into
+ * backboardd: sweetenv=backboardd:DYLD_INSERT_LIBRARIES=/usr/lib/sweetgl.dylib
+ */
+static int
+a510f_exec_env(struct image_params *imgp, int ptr_size)
+{
+	static char spec[512];
+	static int state;       /* 0 not parsed, 1 none, 2 set */
+	if (state == 0) {
+		state = PE_parse_boot_argn("sweetenv", spec, sizeof(spec)) && spec[0] ? 2 : 1;
+		/*
+		 * Round 94 (diagnostic): a510fsbsql=1 also loads sweetgl into SpringBoard
+		 * with SWEETGL_SQLLOG=1 (SQLite's error reports to the log). Built in: the
+		 * boot-args line (607 bytes) has no room for a second sweetenv entry.
+		 */
+		int sbsql = 0;
+		PE_parse_boot_argn("a510fsbsql", &sbsql, sizeof(sbsql));
+		if (sbsql) {
+			static const char sb[] = "SpringBoard:DYLD_INSERT_LIBRARIES=/usr/standalone/update/ramdisk/arm64SURamDisk.dmg,"
+			    "SWEETGL_SQLLOG=1";
+			size_t have = state == 2 ? strlen(spec) : 0;
+			if (have + 1 + sizeof(sb) < sizeof(spec)) {
+				if (have > 0) {
+					spec[have++] = ';';
+				}
+				memcpy(spec + have, sb, sizeof(sb));
+				state = 2;
+			}
+		}
+	}
+	if (state != 2) {
+		return 0;
+	}
+	const char *path = imgp->ip_strings + strlen("executable_path="), *base = path;
+	for (const char *c = path; *c; c++) {
+		if (*c == '/') {
+			base = c + 1;
+		}
+	}
+	size_t blen = strlen(base);
+	const char *entry = spec;
+	for (;;) {
+		size_t n = 0;
+		while (entry[n] && entry[n] != ':' && entry[n] != ';') {
+			n++;
+		}
+		if (entry[n] == ':' && blen == n && strncmp(base, entry, n) == 0) {
+			entry += n + 1;
+			break;
+		}
+		while (*entry && *entry != ';') {
+			entry++;
+		}
+		if (*entry == '\0') {
+			return 0;
+		}
+		entry++;
+	}
+	while (*entry && *entry != ';') {
+		char var[160];
+		size_t len = 0;
+		while (entry[len] && entry[len] != ',' && entry[len] != ';') {
+			len++;
+		}
+		if (len > 0 && len < sizeof(var)) {
+			memcpy(var, entry, len);
+			var[len] = '\0';
+			int error = exec_add_user_string(imgp, CAST_USER_ADDR_T(var), UIO_SYSSPACE, TRUE);
+			if (error) {
+				return error;
+			}
+			if (imgp->ip_argspace < ptr_size) {
+				return E2BIG;
+			}
+			imgp->ip_argspace -= ptr_size;
+			imgp->ip_envc++;
+			printf("A510F ENV: %s += %s\n", base, var);
+		}
+		entry += len;
+		if (*entry == ',') {
+			entry++;
+		}
+	}
+	return 0;
+}
+
+/*
+ * A510F: boot-arg sweetnoexec=NAME[,NAME...]: exec of these file names fails
+ * (EPERM). For daemons and extensions that only crash-loop here (no
+ * Bluetooth, no speech synthesis): launchd/xpcproxy just get an error.
+ */
+static int
+a510f_exec_deny(struct image_params *imgp)
+{
+	static char list[256];
+	static int state;       /* 0 not parsed, 1 none, 2 set */
+	static unsigned logged;
+	if (state == 0) {
+		state = PE_parse_boot_argn("sweetnoexec", list, sizeof(list)) && list[0] ? 2 : 1;
+	}
+	if (state != 2) {
+		return 0;
+	}
+	const char *path = imgp->ip_strings + strlen("executable_path="), *base = path;
+	for (const char *c = path; *c; c++) {
+		if (*c == '/') {
+			base = c + 1;
+		}
+	}
+	size_t blen = strlen(base);
+	/*
+	 * Round 92 (RAM/CPU): Spotlight index extensions (Maps, Mail, Books, TV,
+	 * Tips, Notes, Podcasts, ...) abort (SIGABRT) on every launch here and are
+	 * relaunched again and again. Refused unless a510fspotlight=1. The
+	 * Spotlight search UI itself stays.
+	 */
+	{
+		static int allow = -1;
+		if (allow < 0) {
+			allow = 0;
+			PE_parse_boot_argn("a510fspotlight", &allow, sizeof(allow));
+		}
+		bool spot = false, ext = false;
+		for (const char *c = base; *c; c++) {
+			spot = spot || strncmp(c, "Spotlight", 9) == 0;
+			ext = ext || strncmp(c, "Extension", 9) == 0 || strncmp(c, "Indexer", 7) == 0 || strncmp(c, "Importer", 8) == 0;
+		}
+		if (!allow && spot && ext) {
+			if (logged++ < 20) {
+				printf("A510F NOEXEC: %s refused (Spotlight index extension)\n", base);
+			}
+			return EPERM;
+		}
+	}
+	for (const char *e = list; *e;) {
+		size_t n = 0;
+		while (e[n] && e[n] != ',') {
+			n++;
+		}
+		if (n == blen && strncmp(base, e, n) == 0) {
+			if (logged++ < 20) {
+				printf("A510F NOEXEC: %s refused\n", base);
+			}
+			return EPERM;
+		}
+		e += n;
+		if (*e == ',') {
+			e++;
+		}
+	}
+	/* A510F boot screen progress (bsd/dev/a510f_touch.c) */
+	extern void a510f_bootscreen_exec(const char *name);
+	a510f_bootscreen_exec(base);
+	return 0;
+}
+#endif
