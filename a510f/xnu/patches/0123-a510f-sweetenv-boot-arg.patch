+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	error = a510f_exec_deny(imgp);
+	if (error) {
+		goto bad;
+	}
+	error = a510f_exec_env(imgp, new_ptr_size);
+	if (error) {
+		goto bad;
+	}
+#endif
