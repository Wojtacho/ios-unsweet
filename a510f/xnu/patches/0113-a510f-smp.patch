+#if defined(SWEET_GIC_V2)
+/*
+ * A510F SMP bring-up breadcrumb: store VAL in sweet_smp_trace (SweetCPU.cpp)
+ * and push it to memory. Runs with the MMU off (adrp gives the physical
+ * address) or on. Clobbers x16, x17 only.
+ */
+.macro SWEET_SMP_MARK
+	adrp	x16, EXT(sweet_smp_trace)@page
+	add		x16, x16, EXT(sweet_smp_trace)@pageoff
+	mov		x17, #($0)
+	str		w17, [x16]
+	dc		civac, x16
+	dsb		sy
+.endmacro
+#endif
+
