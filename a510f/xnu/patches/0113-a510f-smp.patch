+static uint32_t
+sweet_pmu_core_status(uint32_t mpidr)
+{
+	if (sweet_pmu_va == 0) {
+		return 0xdeadbeef;
+	}
+	unsigned int n = ((mpidr >> 8) & 0xff) * 4 + (mpidr & 0xff);
+	return *(volatile uint32_t *)(sweet_pmu_va + 0x2004 + 0x80 * n);
+}
+extern "C" vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+/* SMCCC 1.0 call with up to three arguments; x0 is the result. */
+static int64_t
+sweet_psci_call(uint64_t fn, uint64_t a1, uint64_t a2, uint64_t a3)
+{
+	register uint64_t x0 __asm__("x0") = fn;
+	register uint64_t x1 __asm__("x1") = a1;
+	register uint64_t x2 __asm__("x2") = a2;
+	register uint64_t x3 __asm__("x3") = a3;
+	__asm__ volatile("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : :
+	    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13",
+	    "x14", "x15", "x16", "x17", "cc", "memory");
+	return (int64_t)x0;
+}
+
+/*
+ * A510F: what the firmware and the hardware say about a core that never
+ * reached its entry stub. Read-only: PSCI VERSION / AFFINITY_INFO, the
+ * entry instruction word read back through a fresh mapping of entry_pa, and
+ * the Exynos PMU per-core status words (0x2004 + 0x80 * n, as on other
+ * Exynos chips; unverified for the 7580, reads only).
+ */
+static void
+sweet_smp_diag_panic(unsigned int i, uint32_t mpidr, uint32_t stage, uint32_t inited)
+{
+	int64_t ver = sweet_psci_call(0x84000000ULL, 0, 0, 0);
+	int64_t aff = sweet_psci_call(0xC4000004ULL, mpidr, 0, 0);
+	uint32_t want = *(const volatile uint32_t *)(uintptr_t)&sweet_secondary_entry;
+	uint32_t got = 0xdeadbeef;
+	vm_offset_t pg = ml_io_map((vm_offset_t)(sweet_last_entry_pa & ~0xfffULL), 0x1000);
+	if (pg) {
+		got = *(volatile uint32_t *)(pg + (sweet_last_entry_pa & 0xfff));
+	}
+	(void)ver;
+	(void)aff;
+	uint32_t now = sweet_pmu_core_status(mpidr);
+	/* Second CPU_ON, exactly as Samsung's Linux (x3 = 0). */
+	int64_t rc2 = sweet_psci_call(0xC4000003ULL, mpidr, sweet_last_entry_pa, 0);
+	__asm__ volatile ("sev");
+	IOSleep(500);
+	uint32_t stage2 = sweet_smp_trace_read();
+	panic("SWEET CPU: cpu=%u mpidr 0x%x timeout: stage 0x%x, CPU_ON rc %d, initCPU %u | "
+	    "entry 0x%llx ok %d | pmu before %x after %x now %x | retry rc %lld stage 0x%x pmu %x",
+	    i, mpidr, stage, sweet_last_cpu_on_rc, inited, sweet_last_entry_pa, got == want,
+	    sweet_pmu_before, sweet_pmu_after, now, (long long)rc2, stage2, sweet_pmu_core_status(mpidr));
+}
+/*
+ * A510F: last bring-up stage a starting core reached (osfmk/arm64/start.s):
+ * 0x100|EL entry stub, 0x20 past EL switch, 0x30 CPU data found, 0xE0 no CPU
+ * data (hang), 0x50 initCPU. Written with the MMU off, so always cleaned to
+ * and read from memory.
+ */
+extern "C" {
+uint32_t sweet_smp_trace __attribute__((aligned(64))) = 0;
+}
+
+static inline void
+sweet_smp_trace_sync(void)
+{
+	__asm__ volatile ("dc civac, %0" : : "r"(&sweet_smp_trace) : "memory");
+	__builtin_arm_dsb(DSB_SY);
+}
+
+static uint32_t
+sweet_smp_trace_read(void)
+{
+	sweet_smp_trace_sync();
+	return __atomic_load_n(&sweet_smp_trace, __ATOMIC_ACQUIRE);
+}
 
