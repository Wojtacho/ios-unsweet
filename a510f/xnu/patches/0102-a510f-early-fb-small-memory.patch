+#define SWEET_FB_BASE             0x67000000
+#define SWEET_FB_WIDTH            1080
+#define SWEET_FB_HEIGHT           1920
+#define SWEET_FB_STRIDE           4320
+#define SWEET_FB_SIZE             0x800000
+
