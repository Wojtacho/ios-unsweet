diff --git a/makedefs/MakeInc.def b/makedefs/MakeInc.def
index 17a98e8..5ca8baa 100644
--- a/makedefs/MakeInc.def
+++ b/makedefs/MakeInc.def
@@ -332,11 +332,15 @@ ARM64_PLKSEG_ADDR  =0xfffffff004004000
 ARM64_LINK_ADDR    =0xfffffff007004000
 
 # Use ARM_LARGE_MEMORY config for all MacOSX targets.
+# A510F: not with 4K pages. Its kernel VA starts at -2TB (41 bits), but the
+# 4K pmap walks from L1 (T1SZ 25/26: 38-39 bit VA) and has no L0 level.
 ifneq ($(filter $(PLATFORM),MacOSX),)
+ifneq ($(CURRENT_MACHINE_CONFIG),SWEET)
 LARGE_MEMORY_DEFINE=-DARM_LARGE_MEMORY=1
 ARM64_PLKSEG_ADDR  =0xfffffe0004004000
 ARM64_LINK_ADDR    =0xfffffe0007004000
 endif
+endif
 
 
 CFLAGS_ARM64	= -Darm64 -DARM64 -D__ARM64__ -DLP64 -DPAGE_SIZE_FIXED -DVM_KERNEL_LINK_ADDRESS=$(ARM64_LINK_ADDR) \
diff --git a/osfmk/arm/arm_init.c b/osfmk/arm/arm_init.c
index 42362c5..bafab60 100644
--- a/osfmk/arm/arm_init.c
+++ b/osfmk/arm/arm_init.c
@@ -544,6 +544,7 @@ arm_init(
 	sweet_early_mark(20, "kprintf startup complete");
