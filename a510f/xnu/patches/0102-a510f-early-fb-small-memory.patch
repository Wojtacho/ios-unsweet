diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
index 06bb568..94768c6 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1837,17 +1837,57 @@ static void
 sweet_early_map_final(void)
 {
 	const vm_map_address_t va = SWEET_EARLY_FB_VA;
-	assert(va + ARM_TT_L2_SIZE <= gVirtBase);
-	tt_entry_t l1 = cpu_tte[(va & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT];
+	const unsigned int nblocks = (SWEET_FB_SIZE + ARM_TT_L2_SIZE - 1) / ARM_TT_L2_SIZE;
+	assert(va + nblocks * ARM_TT_L2_SIZE <= gVirtBase);
+	tt_entry_t *l1p = &cpu_tte[(va & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT];
+	if (*l1p == ARM_TTE_EMPTY) {
+		/*
+		 * A510F: without ARM_LARGE_MEMORY nothing has built an L2 table
+		 * at VM_MIN_KERNEL_ADDRESS yet (first boot panicked here). Add
+		 * one; sweet_early_unmap_final() empties it again before the VM
+		 * allocates in this range.
+		 */
+		vm_offset_t pt = alloc_ptpage(TRUE);
+		bzero((void *)pt, ARM_PGBYTES);
+		*l1p = (kvtophys(pt) & ARM_TTE_TABLE_MASK) | ARM_TTE_TYPE_TABLE | ARM_TTE_VALID;
+	}
+	tt_entry_t l1 = *l1p;
 	assert((l1 & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) == (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE));
 	tt_entry_t *l2 = (tt_entry_t *)phystokv(l1 & ARM_TTE_TABLE_MASK);
 	tt_entry_t *slot = &l2[(va & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT];
-	assert(*slot == ARM_TTE_EMPTY);
-	*slot = 0x9c000000ULL | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
-	    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
-	    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
-	    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
+	/* A510F (4K): 8MB framebuffer = four 2MB blocks; all in this L2 table. */
+	assert(((va & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT) + nblocks <= TTE_PGENTRIES);
+	for (unsigned int i = 0; i < nblocks; i++) {
+		assert(slot[i] == ARM_TTE_EMPTY);
+		slot[i] = ((uint64_t)SWEET_FB_BASE + (uint64_t)i * ARM_TT_L2_SIZE) |
+		    ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
+		    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
+		    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
+		    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
+	}
+	__asm__ volatile("dsb ishst" ::: "memory");
+}
+
+/*
+ * A510F: drop the framebuffer alias once the early console is disabled
+ * (fbcon has taken over), before the VM can hand out VAs in this range.
+ */
+void
+sweet_early_unmap_final(void)
+{
+	const vm_map_address_t va = SWEET_EARLY_FB_VA;
+	const unsigned int nblocks = (SWEET_FB_SIZE + ARM_TT_L2_SIZE - 1) / ARM_TT_L2_SIZE;
+	tt_entry_t l1 = cpu_tte[(va & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT];
+	if ((l1 & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) != (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE)) {
+		return;
+	}
+	tt_entry_t *slot = (tt_entry_t *)phystokv(l1 & ARM_TTE_TABLE_MASK) +
+	    ((va & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT);
+	for (unsigned int i = 0; i < nblocks; i++) {
+		slot[i] = ARM_TTE_EMPTY;
+	}
 	__asm__ volatile("dsb ishst" ::: "memory");
+	flush_mmu_tlb();
 }
 #endif
 
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 023086f..b09e193 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -515,10 +515,10 @@ LEXT(start_first_cpu)
 
 #if defined(SWEET)
 	/* Stage 0: white 64x32 band, no stack or page tables needed. */
-	MOV64	x0, (0x9c000000 + 2368 * 4320)
+	MOV64	x0, (SWEET_FB_BASE + (SWEET_FB_HEIGHT - 32) * SWEET_FB_STRIDE)
 	mov		w1, #-1
 	mov		x2, #32
-	mov		x4, #4320
+	mov		x4, #(SWEET_FB_STRIDE)
 Lsweet_mark_row:
 	mov		x3, #64
 	mov		x5, x0
@@ -680,19 +680,26 @@ Lkernelcache_base_found:
 
 #if defined(SWEET)
 	/*
-	 * Splash framebuffer: one 32MB Normal-NC block in the EXISTING V=P
-	 * L2 table. Both framebuffer and RAM use L1 index 0; another call to
-	 * create_bootstrap_mapping would replace the RAM L2 table.
-	 * SWEET uses 16K pages and all bring-up RAM is below 4GB, so the first
-	 * V=P L2 page is bootstrap_pagetables + 2*PGBYTES.
+	 * Splash framebuffer: Normal-NC L2 blocks in the EXISTING V=P L2 table
+	 * (another create_bootstrap_mapping call would replace the RAM L2
+	 * table). The framebuffer must share the first V=P L2 table's L1 entry
+	 * with the kernel (bootstrap_pagetables + 2*PGBYTES): one 32MB block on
+	 * sweet (16K), 1GB of 2MB blocks on the A510F (4K: framebuffer
+	 * 0x67000000 and kernel 0x71000000 are both in 0x40000000-0x7fffffff).
 	 */
-	MOV64	x10, 0x9c000000
+	MOV64	x10, SWEET_FB_BASE
 	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
 	orr		x11, x11, x10
 	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
 	lsr		x12, x12, #(ARM_TT_L2_SHIFT)
 	add		x13, x25, #(2 * PGBYTES)
+	mov		x14, #((SWEET_FB_SIZE + ARM_TT_L2_SIZE - 1) / ARM_TT_L2_SIZE)
+Lsweet_fb_block:
 	str		x11, [x13, x12, lsl #TTE_SHIFT]
+	add		x11, x11, #(ARM_TT_L2_SIZE)
+	add		x12, x12, #1
+	subs	x14, x14, #1
+	b.ne	Lsweet_fb_block
 #endif
 
 	/* Ensure TTEs are visible */
