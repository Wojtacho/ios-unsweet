@@ -33,6 +33,17 @@
 
 #define HAS_GIC_V3                1
 
+/*
+ * A510F: splash framebuffer S-Boot leaves programmed in DECON window 0
+ * (probe run, a510f/NOTES.md): 1080x1920 a8r8g8b8, stride 4320 bytes.
+ * SWEET_FB_SIZE is the mapped size: whole 2MB blocks (4K pages).
