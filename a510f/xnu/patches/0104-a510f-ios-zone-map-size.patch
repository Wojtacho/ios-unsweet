diff --git a/osfmk/kern/zalloc.c b/osfmk/kern/zalloc.c
index 182b44a..e8ba722 100644
--- a/osfmk/kern/zalloc.c
+++ b/osfmk/kern/zalloc.c
@@ -160,7 +160,12 @@ ZONE_DEFINE_TYPE(percpu_u64_zone, "percpu.64", uint64_t,
 #define ZONE_GUARD_SPARSE       (64  * 1024)
 #endif /* ZSECURITY_CONFIG(SAD_FENG_SHUI) */
 
-#if XNU_PLATFORM_MacOSX
+/*
+ * A510F: a macOS-platform arm64 build without ARM_LARGE_MEMORY (4K pages)
+ * has the iOS kernel VA layout (~112GB): the 128GB macOS zone map cannot
+ * fit, so kmem_range_init panicked. Use the iOS sizes there.
+ */
+#if XNU_PLATFORM_MacOSX && !(defined(__arm64__) && !defined(ARM_LARGE_MEMORY))
 #define ZONE_MAP_MAX            (32ULL << 30)
 #define ZONE_MAP_VA_SIZE        (128ULL << 30)
 #else /* XNU_PLATFORM_MacOSX */
diff --git a/osfmk/vm/vm_kern.c b/osfmk/vm/vm_kern.c
index 54edb01..ed63628 100644
--- a/osfmk/vm/vm_kern.c
+++ b/osfmk/vm/vm_kern.c
@@ -3641,6 +3641,16 @@ kmem_scramble_ranges(void)
 		struct mach_vm_range *sp_range = sp.kc_range;
 		if (vm_map_locate_space(kernel_map, sp.kc_size, 0,
 		    VM_MAP_KERNEL_FLAGS_ANYWHERE(), &start, NULL) != KERN_SUCCESS) {
+			/* A510F: show what did not fit before panicking. */
+			vm_map_size_t largest = 0;
+			vm_map_sizes(kernel_map, NULL, NULL, &largest);
+			printf("kmem_range_init: claim %u/%u %s size 0x%llx at 0x%llx, largest free 0x%llx\n",
+			    i, kmem_claim_count, sp.kc_name, (unsigned long long)sp.kc_size,
+			    (unsigned long long)start, (unsigned long long)largest);
+			for (uint32_t j = 0; j < kmem_claim_count; j++) {
+				printf("  claim %-24s 0x%llx\n", kmem_claims[j].kc_name,
+				    (unsigned long long)kmem_claims[j].kc_size);
+			}
 			panic("kmem_range_init: vm_map_locate_space failing for claim %s",
 			    sp.kc_name);
 		}
