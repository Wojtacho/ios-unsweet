+			int v = 0;
+			sweet_boot_checked = 1;
+			if (PE_parse_boot_argn("sweetboot", &v, sizeof(v)) && v) {
+				sweet_console_muted = 1;
+			}
+		}
+	}
 	if (sweet_console_muted && !panic_active()) {
 		return;
 	}
 #endif
