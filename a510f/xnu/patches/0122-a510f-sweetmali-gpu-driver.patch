index 0000000..9a2f2af
--- /dev/null
+++ b/iokit/Kernel/arm/SweetMali.cpp
@@ -0,0 +1,770 @@
+/*
+ * SweetMali: kernel driver for the A510F's Mali-T720 MP2 (Exynos 7580),
+ * shaped after Linux panfrost (drivers/gpu/drm/panfrost) so that Mesa's
+ * panfrost driver can sit on top of it through a small DRM emulation layer
+ * in user space (as joranv1/ios-sailfish did for freedreno / SweetGPU).
+ *
+ * Hardware (a510f/NOTES.md, GPU milestones 1 and 2a): Mali at 0x11400000,
+ * G3D power domain PMU 0x10464060/64 (S-Boot leaves it on, BUCK4 1.0 V),
+ * CMU_G3D 0x11460000 (GPU clocked from aclk_g3d_400), CMU_TOP 0x10010000.
+ * GPU_ID 0x07201000: 2 shader cores, 1 tiler, 1 L2, 3 job slots, 4 AS.
+ *
+ * One GPU address space (AS0) for every client, 4-level Mali LPAE tables
+ * grown on demand (io-pgtable-arm ARM_MALI_LPAE: table type 3, leaf type 1,
+ * HAP rw bits 6/7, outer shareable, attr 0; MEMATTR 0x888D88), MMU lock +
+ * FLUSH_PT after each change (panfrost_mmu.c). Submits are synchronous: the
+ * call returns when the job chain is done, which keeps the vertex/tiler ->
+ * fragment ordering Mesa expects without fences. A failing job is
+ * hard-stopped and the GPU reset and set up again.
+ *
+ * User client (IOServiceOpen type 0), selectors:
+ *   10 BO_NEW     in [size, flags]  out [handle, gpu_va, user_va, size]
+ *   11 BO_FREE    in [handle]
+ *   12 IMPORT     in [IOSurface id] out [handle, gpu_va, user_va, size]
+ *   13 SUBMIT     in [jc, requirements (bit 0 = fragment)]  out [js status, us]
+ *   14 WAIT       in [handle, timeout]  (submits are synchronous: no-op)
+ *   15 GET_PARAM  in [panfrost DRM_PANFROST_PARAM_*]  out [value]
+ */
+#include <pexpert/arm64/board_config.h>
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOLocks.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <libkern/c++/OSArray.h>
+#include <pexpert/pexpert.h>
+#include <kern/clock.h>
+#include <IOKit/system.h>
+#include <sys/proc.h>
+
+extern "C" void sweet_mali_publish(IOService *provider);
+
+#if defined(SWEET_GIC_V2)
+#include "SweetSurface.h"
+
+extern "C" vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern "C" vm_offset_t ml_vtophys(vm_offset_t va);
+
+#define MALI_PA         0x11400000u
+#define PMU_PD_PA       0x10464000u
+#define CMU_G3D_PA      0x11460000u
+#define CMU_TOP_PA      0x10010000u
+
+#define GPU_ID                  0x000
+#define GPU_IRQ_RAWSTAT         0x020
+#define GPU_IRQ_CLEAR           0x024
+#define GPU_IRQ_MASK            0x028
+#define GPU_COMMAND             0x030
+#define GPU_STATUS              0x034
+#define SHADER_PRESENT          0x100
+#define TILER_PRESENT           0x110
+#define L2_PRESENT              0x120
+#define SHADER_READY            0x140
+#define TILER_READY             0x150
+#define L2_READY                0x160
+#define SHADER_PWRON            0x180
+#define TILER_PWRON             0x190
+#define L2_PWRON                0x1a0
+#define JOB_INT_RAWSTAT         0x1000
+#define JOB_INT_CLEAR           0x1004
+#define JOB_INT_MASK            0x1008
+#define JS(n, r)                (0x1800 + (n) * 0x80 + (r))
+#define JS_HEAD                 0x00
+#define JS_STATUS               0x24
+#define JS_COMMAND              0x20
+#define JS_HEAD_NEXT            0x40
+#define JS_AFFINITY_NEXT        0x50
+#define JS_CONFIG_NEXT          0x58
+#define JS_COMMAND_NEXT         0x60
+#define MMU_INT_RAWSTAT         0x2000
+#define MMU_INT_CLEAR           0x2004
+#define MMU_INT_MASK            0x2008
+#define AS(n, r)                (0x2400 + (n) * 0x40 + (r))
+#define AS_TRANSTAB_LO          0x00
+#define AS_TRANSTAB_HI          0x04
+#define AS_MEMATTR_LO           0x08
+#define AS_MEMATTR_HI           0x0c
+#define AS_LOCKADDR_LO          0x10
+#define AS_LOCKADDR_HI          0x14
+#define AS_COMMAND              0x18
+#define AS_FAULTSTATUS          0x1c
+#define AS_FAULTADDRESS_LO      0x20
+#define AS_FAULTADDRESS_HI      0x24
+#define AS_STATUS               0x28
+
+#define AS_COMMAND_UPDATE       1
+#define AS_COMMAND_LOCK         2
+#define AS_COMMAND_FLUSH_PT     4
+#define AS_COMMAND_FLUSH_MEM    5
+
+#define MALI_PTE_LEAF           (1ull | (3ull << 6) | (2ull << 8))      /* type 1, HAP rw, outer shareable, attr 0 */
+#define MALI_PTE_TABLE          3ull
+#define MALI_VA_BASE            0x10000000ull   /* GPU VAs handed out from here (MMU_FEATURES: 33-bit VA) */
+#define MALI_VA_LIMIT           0x1f0000000ull
+#define MALI_MAX_TABLES         512
+#define MALI_TIMEOUT_MS         2000
+
+static vm_offset_t g_gpu, g_pmu, g_g3d, g_top;
+static IOLock *g_lock;
+static uint64_t *g_l0;
+static uint64_t g_l0_pa, g_va_next = MALI_VA_BASE;
+static uint32_t g_shader, g_tiler, g_l2;
+static bool g_ready;
+static struct { uint64_t pa; uint64_t *va; } g_tables[MALI_MAX_TABLES];
+static unsigned g_ntables;
+static uint8_t *g_pool;
+static unsigned g_pool_left;
+static uint32_t g_jobs, g_faults;
+
+static inline uint32_t
+rd(vm_offset_t b, uint32_t o)
+{
+	uint32_t v = *(volatile uint32_t *)(b + o);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static inline void
+wr(vm_offset_t b, uint32_t o, uint32_t v)
+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(b + o) = v;
+}
+
+static bool
+poll(vm_offset_t b, uint32_t off, uint32_t mask, uint32_t want, int ms)
+{
+	for (int i = 0; i < ms * 10; i++) {
+		if ((rd(b, off) & mask) == want) {
+			return true;
+		}
+		IODelay(100);
+	}
+	return false;
+}
+
+static void
+dc_civac(const void *p, size_t len)
+{
+	uintptr_t a = (uintptr_t)p & ~(uintptr_t)63, end = (uintptr_t)p + len;
+	for (; a < end; a += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r"(a) : "memory");
+	}
+	__asm__ volatile ("dsb sy" : : : "memory");
+}
+
+/* ---- page tables ---------------------------------------------------- */
+
+/* A zeroed 4 KB table (from 16 KB kernel pages), remembered by its PA. */
+static uint64_t *
+table_alloc(uint64_t *pa)
+{
+	if (g_ntables >= MALI_MAX_TABLES) {
+		return NULL;
+	}
+	if (g_pool_left == 0) {
+		g_pool = (uint8_t *)IOMallocAligned(16384, 16384);
+		if (g_pool == NULL) {
+			return NULL;
+		}
+		bzero(g_pool, 16384);
+		dc_civac(g_pool, 16384);
+		g_pool_left = 4;
+	}
+	uint64_t *t = (uint64_t *)(void *)(g_pool + (4 - g_pool_left) * 4096);
+	g_pool_left--;
+	*pa = ml_vtophys((vm_offset_t)t) & ~0xfffull;
+	g_tables[g_ntables].pa = *pa;
+	g_tables[g_ntables].va = t;
+	g_ntables++;
+	return t;
+}
+
+static uint64_t *
+table_va(uint64_t pa)
+{
+	for (unsigned i = 0; i < g_ntables; i++) {
+		if (g_tables[i].pa == pa) {
+			return g_tables[i].va;
+		}
+	}
+	return NULL;
+}
+
+/* Leaf entry for va (tables created on the way when create). */
+static uint64_t *
+pte(uint64_t va, bool create)
+{
+	uint64_t *t = g_l0;
+	for (int lvl = 0; lvl < 3; lvl++) {
+		unsigned idx = (unsigned)((va >> (39 - 9 * lvl)) & 0x1ff);
+		uint64_t e = t[idx];
+		if ((e & 3) != MALI_PTE_TABLE) {
+			if (!create) {
+				return NULL;
+			}
+			uint64_t npa;
+			uint64_t *n = table_alloc(&npa);
+			if (n == NULL) {
+				return NULL;
+			}
+			t[idx] = npa | MALI_PTE_TABLE;
+			dc_civac(&t[idx], 8);
+			t = n;
+		} else {
+			t = table_va(e & 0xfffffffff000ull);
+			if (t == NULL) {
+				return NULL;
+			}
+		}
+	}
+	return &t[(va >> 12) & 0x1ff];
+}
+
+static bool
+as_wait(void)
+{
+	return poll(g_gpu, AS(0, AS_STATUS), 1, 0, 100);
+}
+
+/* panfrost_mmu.c lock_region + operation (log2 region, at least 32 KB). */
+static void
+as_op(uint64_t va, uint64_t size, uint32_t cmd)
+{
+	uint64_t end = va + size - 1;
+	unsigned width = 15;
+	while (width < 63 && ((va >> width) != (end >> width))) {
+		width++;
+	}
+	uint64_t region = (va & ~((1ull << width) - 1)) | (width - 1);
+	as_wait();
+	wr(g_gpu, AS(0, AS_LOCKADDR_LO), (uint32_t)region);
+	wr(g_gpu, AS(0, AS_LOCKADDR_HI), (uint32_t)(region >> 32));
+	wr(g_gpu, AS(0, AS_COMMAND), AS_COMMAND_LOCK);
+	as_wait();
+	wr(g_gpu, AS(0, AS_COMMAND), cmd);
+	as_wait();
+}
+
+/* Map/unmap the 4 KB pages of md at va. Lock held. */
+static bool
+gpu_map(uint64_t va, IOMemoryDescriptor *md, uint64_t size)
+{
+	for (uint64_t off = 0; off < size; off += 4096) {
+		IOByteCount len = 0;
+		addr64_t pa = md->getPhysicalSegment(off, &len, kIOMemoryMapperNone);
+		uint64_t *p = pte(va + off, true);
+		if (pa == 0 || p == NULL) {
+			return false;
+		}
+		*p = (pa & ~0xfffull) | MALI_PTE_LEAF;
+		dc_civac(p, 8);
+	}
+	as_op(va, size, AS_COMMAND_FLUSH_PT);
+	return true;
+}
+
+static void
+gpu_unmap(uint64_t va, uint64_t size)
+{
+	for (uint64_t off = 0; off < size; off += 4096) {
+		uint64_t *p = pte(va + off, false);
+		if (p != NULL) {
+			*p = 0;
+			dc_civac(p, 8);
+		}
+	}
+	as_op(va, size, AS_COMMAND_FLUSH_PT);
+}
+
+/* ---- GPU bring-up ----------------------------------------------------- */
+
+static void
+as_setup(void)
+{
+	uint64_t transtab = g_l0_pa | 4 | 3;            /* READ_INNER | ADRMODE_TABLE */
+	as_wait();
+	wr(g_gpu, AS(0, AS_TRANSTAB_LO), (uint32_t)transtab);
+	wr(g_gpu, AS(0, AS_TRANSTAB_HI), (uint32_t)(transtab >> 32));
+	wr(g_gpu, AS(0, AS_MEMATTR_LO), 0x00888d88u);
+	wr(g_gpu, AS(0, AS_MEMATTR_HI), 0);
+	wr(g_gpu, AS(0, AS_COMMAND), AS_COMMAND_UPDATE);
+	as_wait();
+}
+
+/* Soft reset, power the cores, AS0, cycle counter. Lock held (or init). */
+static bool
+gpu_reset(void)
+{
+	wr(g_gpu, GPU_IRQ_MASK, 0);
+	wr(g_gpu, JOB_INT_MASK, 0);
+	wr(g_gpu, MMU_INT_MASK, 0);
+	wr(g_gpu, GPU_IRQ_CLEAR, 0xffffffffu);
+	wr(g_gpu, GPU_COMMAND, 1);                      /* SOFT_RESET */
+	bool reset = poll(g_gpu, GPU_IRQ_RAWSTAT, 1u << 8, 1u << 8, 100);
+	wr(g_gpu, GPU_IRQ_CLEAR, 0xffffffffu);
+	wr(g_gpu, L2_PWRON, g_l2);
+	bool l2 = poll(g_gpu, L2_READY, g_l2, g_l2, 100);
+	wr(g_gpu, TILER_PWRON, g_tiler);
+	bool tiler = poll(g_gpu, TILER_READY, g_tiler, g_tiler, 100);
+	wr(g_gpu, SHADER_PWRON, g_shader);
+	bool shader = poll(g_gpu, SHADER_READY, g_shader, g_shader, 100);
+	wr(g_gpu, JOB_INT_CLEAR, 0xffffffffu);
+	wr(g_gpu, MMU_INT_CLEAR, 0xffffffffu);
+	as_setup();
+	wr(g_gpu, GPU_COMMAND, 5);                      /* CYCLE_COUNT_START */
+	return reset && l2 && tiler && shader;
+}
+
+static bool
+gpu_power_clock(void)
+{
+	if ((rd(g_pmu, 0x64) & 0xf) != 0xf) {
+		wr(g_pmu, 0x60, 0xf);
+		if (!poll(g_pmu, 0x64, 0xf, 0xf, 100)) {
+			return false;
+		}
+	}
+	wr(g_top, 0x800, rd(g_top, 0x800) | (1u << 14));        /* aclk_g3d_400 gate */
+	wr(g_g3d, 0x208, rd(g_g3d, 0x208) | 1u);                /* mout_g3d = aclk_g3d_400 */
+	bool muxed = poll(g_g3d, 0x408, 0x7, 0x2, 10);
+	wr(g_g3d, 0x600, (rd(g_g3d, 0x600) & ~0x77u) | (2u << 4));      /* aclk /1, pclk /3 */
+	poll(g_g3d, 0x700, 0xffffffffu, 0, 10);
+	wr(g_g3d, 0x800, rd(g_g3d, 0x800) | 0xb3u);
+	wr(g_g3d, 0x900, rd(g_g3d, 0x900) | 0x11u);
+	return muxed;
+}
+
+/* ---- jobs ------------------------------------------------------------- */
+
+/* Run one job chain to completion. Lock held. Returns 0 or an error code. */
+static IOReturn
+gpu_run(uint64_t jc, uint32_t req, uint32_t *status_out, uint64_t *us_out)
+{
+	unsigned js = (req & 1) ? 0 : 1;                /* PANFROST_JD_REQ_FS -> slot 0 */
+	uint32_t done = 1u << js, err = 1u << (16 + js);
+	uint64_t t0 = mach_absolute_time();
+	wr(g_gpu, JOB_INT_CLEAR, done | err);
+	wr(g_gpu, MMU_INT_CLEAR, 1);
+	wr(g_gpu, JS(js, JS_HEAD_NEXT), (uint32_t)jc);
+	wr(g_gpu, JS(js, JS_HEAD_NEXT) + 4, (uint32_t)(jc >> 32));
+	wr(g_gpu, JS(js, JS_AFFINITY_NEXT), g_shader);
+	wr(g_gpu, JS(js, JS_AFFINITY_NEXT) + 4, 0);
+	/* AS0, priority 8, clean+invalidate at start and end, START_MMU (T720 HW_ISSUE_10649) */
+	wr(g_gpu, JS(js, JS_CONFIG_NEXT), (8u << 16) | (3u << 8) | (3u << 12) | (1u << 10));
+	wr(g_gpu, JS(js, JS_COMMAND_NEXT), 1);
+	uint32_t raw = 0, mmu = 0;
+	uint64_t deadline;
+	nanoseconds_to_absolutetime((uint64_t)MALI_TIMEOUT_MS * 1000000ull, &deadline);
+	deadline += t0;
+	for (int spin = 0;; spin++) {
+		raw = rd(g_gpu, JOB_INT_RAWSTAT);
+		mmu = rd(g_gpu, MMU_INT_RAWSTAT);
+		if ((raw & (done | err)) || (mmu & 1) || mach_absolute_time() > deadline) {
+			break;
+		}
+		if (spin < 50) {
+			IODelay(10);
+		} else {
+			IOSleep(1);
+		}
+	}
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	uint32_t status = rd(g_gpu, JS(js, JS_STATUS));
+	if (us_out) {
+		*us_out = ns / 1000;
+	}
+	g_jobs++;
+	if ((raw & done) && !(raw & err) && !(mmu & 1)) {
+		wr(g_gpu, JOB_INT_CLEAR, done);
+		if (status_out) {
+			*status_out = 1;
+		}
+		return kIOReturnSuccess;
+	}
+	g_faults++;
+	if (g_faults <= 20) {
+		char name[32];
+		proc_selfname(name, sizeof(name));
+		IOLog("SWEET MALI: %s job 0x%llx js%u %s: irq 0x%x mmu 0x%x status 0x%x head 0x%x | AS0 fault 0x%x at 0x%x%08x (%llu us)\n",
+		    name, jc, js, (raw & err) ? "error" : (mmu & 1) ? "MMU fault" : "TIMEOUT", raw, mmu, status,
+		    rd(g_gpu, JS(js, JS_HEAD)), rd(g_gpu, AS(0, AS_FAULTSTATUS)),
+		    rd(g_gpu, AS(0, AS_FAULTADDRESS_HI)), rd(g_gpu, AS(0, AS_FAULTADDRESS_LO)), ns / 1000);
+	}
+	if (status_out) {
+		*status_out = status ? status : 0xffff;
+	}
+	wr(g_gpu, JS(js, JS_COMMAND), 3);               /* HARD_STOP */
+	IOSleep(1);
+	gpu_reset();
+	return kIOReturnIOError;
+}
+
+/* ---- buffer objects ---------------------------------------------------- */
+
+class SweetMaliBO : public OSObject {
+	OSDeclareDefaultStructors(SweetMaliBO);
+public:
+	IOMemoryDescriptor *md;
+	IOMemoryMap        *userMap;
+	SweetSurface       *surface;
+	uint64_t            gpuVA, size;
+	bool init() APPLE_KEXT_OVERRIDE { md = NULL; userMap = NULL; surface = NULL; gpuVA = 0; size = 0; return OSObject::init(); }
+	void free() APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(SweetMaliBO, OSObject);
+
+void
+SweetMaliBO::free()
+{
+	if (gpuVA != 0) {
+		IOLockLock(g_lock);
+		gpu_unmap(gpuVA, size);
+		IOLockUnlock(g_lock);
+	}
+	OSSafeReleaseNULL(userMap);
+	OSSafeReleaseNULL(md);
+	OSSafeReleaseNULL(surface);
+	OSObject::free();
+}
+
+/* GPU-map md (size rounded to 4 KB) and map it into task. */
+static SweetMaliBO *
+bo_make(IOMemoryDescriptor *md, uint64_t size, task_t task, IOOptionBits cache)
+{
+	SweetMaliBO *bo = OSTypeAlloc(SweetMaliBO);
+	if (bo == NULL || !bo->init()) {
+		OSSafeReleaseNULL(bo);
+		return NULL;
+	}
+	bo->md = md;
+	md->retain();
+	bo->size = (size + 4095) & ~4095ull;
+	IOLockLock(g_lock);
+	uint64_t va = (g_va_next + 0xffff) & ~0xffffull;        /* 64 KB aligned */
+	bool ok = va + bo->size <= MALI_VA_LIMIT && gpu_map(va, md, bo->size);
+	if (ok) {
+		bo->gpuVA = va;
+		g_va_next = va + bo->size;
+	}
+	IOLockUnlock(g_lock);
+	if (ok && task != NULL) {
+		bo->userMap = md->createMappingInTask(task, 0, kIOMapAnywhere | cache);
+		ok = bo->userMap != NULL;
+	}
+	if (!ok) {
+		bo->release();
+		return NULL;
+	}
+	return bo;
+}
+
+static SweetMaliBO *
+bo_new(uint64_t size, task_t task)
+{
+	if (size == 0 || size > (256ull << 20)) {
+		return NULL;
+	}
+	size = (size + 16383) & ~16383ull;
+	IOBufferMemoryDescriptor *md = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+	    kIODirectionInOut | kIOMemoryKernelUserShared, size, 16384);
+	if (md == NULL) {
+		return NULL;
+	}
+	bzero(md->getBytesNoCopy(), size);
+	dc_civac(md->getBytesNoCopy(), size);
+	SweetMaliBO *bo = bo_make(md, size, task, kIOMapWriteCombineCache);
+	md->release();
+	return bo;
+}
+
+/* ---- self-test ---------------------------------------------------------- */
+
+/* The milestone 2a WRITE_VALUE job, through the BO and submit paths. */
+static void
+mali_selftest(void)
+{
+	SweetMaliBO *bo = bo_new(16384, NULL);
+	if (bo == NULL) {
+		IOLog("SWEET MALI: self-test: no BO\n");
+		return;
+	}
+	uint8_t *mem = (uint8_t *)OSDynamicCast(IOBufferMemoryDescriptor, bo->md)->getBytesNoCopy();
+	uint32_t *w = (uint32_t *)(void *)mem;
+	w[4] = 1u | (2u << 1) | (1u << 16);             /* 64-bit, WRITE_VALUE, index 1 */
+	uint64_t target = bo->gpuVA + 0x100, pattern = 0xaaaaaaaaaaaaaaaaull;
+	memcpy(mem + 0x20, &target, 8);
+	w[0x28 / 4] = 1;                                /* cycle counter */
+	memcpy(mem + 0x100, &pattern, 8);
+	dc_civac(mem, 16384);
+	uint32_t status = 0;
+	uint64_t us = 0;
+	IOLockLock(g_lock);
+	IOReturn r = gpu_run(bo->gpuVA, 0, &status, &us);
+	IOLockUnlock(g_lock);
+	dc_civac(mem, 16384);
+	uint64_t result;
+	memcpy(&result, mem + 0x100, 8);
+	IOLog("SWEET MALI: self-test job at gpu 0x%llx: 0x%x in %llu us, header 0x%x, cycles 0x%llx -> %s\n",
+	    bo->gpuVA, r, us, w[0], result, (r == kIOReturnSuccess && result != pattern) ? "ok" : "FAILED");
+	bo->release();
+}
+
+/* ---- user client ---------------------------------------------------------- */
+
+static const uint32_t mali_param_reg[] = {
+	/* DRM_PANFROST_PARAM_*: 0 GPU_PROD_ID and 1 GPU_REVISION are derived */
+	0, 0, SHADER_PRESENT, TILER_PRESENT, L2_PRESENT, 0xe00 /* STACK_PRESENT */,
+	0x018 /* AS */, 0x01c /* JS */, 0x004 /* L2_FEATURES */, 0x008 /* CORE */, 0x00c /* TILER */,
+	0x010 /* MEM */, 0x014 /* MMU */, 0x0ac /* THREAD */, 0x0a0, 0x0a4, 0x0a8, 0x300 /* COHERENCY */,
+	0x0b0, 0x0b4, 0x0b8, 0x0bc,
+	0x0c0, 0x0c4, 0x0c8, 0x0cc, 0x0d0, 0x0d4, 0x0d8, 0x0dc, 0x0e0, 0x0e4, 0x0e8, 0x0ec, 0x0f0, 0x0f4, 0x0f8, 0x0fc,
+};
+
+class SweetMaliUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(SweetMaliUserClient);
+	task_t   fTask;
+	OSArray *fBOs;
+	IOReturn boReply(SweetMaliBO *bo, IOExternalMethodArguments *args);
+public:
+	bool initWithTask(task_t owningTask, void *securityID, UInt32 type) APPLE_KEXT_OVERRIDE;
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	void free(void) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target, void *reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(SweetMaliUserClient, IOUserClient);
+
+bool
+SweetMaliUserClient::initWithTask(task_t owningTask, void *securityID, UInt32 type)
+{
+	if (!IOUserClient::initWithTask(owningTask, securityID, type)) {
+		return false;
+	}
+	fTask = owningTask;
+	fBOs = OSArray::withCapacity(64);
+	return fBOs != NULL;
+}
+
+IOReturn
+SweetMaliUserClient::clientClose(void)
+{
+	if (fBOs != NULL) {
+		fBOs->flushCollection();
+	}
+	terminate();
+	return kIOReturnSuccess;
+}
+
+void
+SweetMaliUserClient::free(void)
+{
+	OSSafeReleaseNULL(fBOs);
+	IOUserClient::free();
+}
+
+IOReturn
+SweetMaliUserClient::boReply(SweetMaliBO *bo, IOExternalMethodArguments *args)
+{
+	if (bo == NULL) {
+		return kIOReturnNoMemory;
+	}
+	/* handle = slot + 1; reuse freed slots (OSArray holds the BO) */
+	unsigned slot = fBOs->getCount();
+	for (unsigned i = 0; i < fBOs->getCount(); i++) {
+		if (OSDynamicCast(SweetMaliBO, fBOs->getObject(i)) == NULL) {
+			slot = i;
+			break;
+		}
+	}
+	if (slot < fBOs->getCount()) {
+		fBOs->replaceObject(slot, bo);
+	} else {
+		fBOs->setObject(bo);
+	}
+	bo->release();
+	if (args->scalarOutputCount < 4) {
+		return kIOReturnBadArgument;
+	}
+	args->scalarOutput[0] = slot + 1;
+	args->scalarOutput[1] = bo->gpuVA;
+	args->scalarOutput[2] = bo->userMap ? bo->userMap->getAddress() : 0;
+	args->scalarOutput[3] = bo->size;
+	return kIOReturnSuccess;
+}
+
+IOReturn
+SweetMaliUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    IOExternalMethodDispatch *, OSObject *, void *)
+{
+	if (!g_ready) {
+		return kIOReturnNotReady;
+	}
+	const uint64_t *in = args->scalarInput;
+	uint32_t nin = args->scalarInputCount;
+	switch (selector) {
+	case 10:                                        /* BO_NEW */
+		if (nin < 2) {
+			return kIOReturnBadArgument;
+		}
+		return boReply(bo_new(in[0], fTask), args);
+	case 11: {                                      /* BO_FREE */
+		if (nin < 1 || in[0] == 0 || in[0] > fBOs->getCount()) {
+			return kIOReturnBadArgument;
+		}
+		/* a non-BO placeholder keeps the other handles stable; boReply reuses it */
+		OSNumber *empty = OSNumber::withNumber((unsigned long long)0, 32);
+		fBOs->replaceObject((unsigned)in[0] - 1, empty);
+		OSSafeReleaseNULL(empty);
+		return kIOReturnSuccess;
+	}
+	case 12: {                                      /* IMPORT IOSurface */
+		if (nin < 1) {
+			return kIOReturnBadArgument;
+		}
+		SweetSurface *s = sweet_surface_copy((uint32_t)in[0]);
+		if (s == NULL || s->memory == NULL) {
+			OSSafeReleaseNULL(s);
+			return kIOReturnNotFound;
+		}
+		SweetMaliBO *bo = bo_make(s->memory, s->memory->getLength(), fTask,
+		    s->wrapped ? kIOMapDefaultCache : kIOMapWriteCombineCache);
+		if (bo != NULL) {
+			bo->surface = s;
+		} else {
+			s->release();
+		}
+		return boReply(bo, args);
+	}
+	case 13: {                                      /* SUBMIT */
+		if (nin < 2 || args->scalarOutputCount < 2) {
+			return kIOReturnBadArgument;
+		}
+		uint32_t status = 0;
+		uint64_t us = 0;
+		IOLockLock(g_lock);
+		IOReturn r = gpu_run(in[0], (uint32_t)in[1], &status, &us);
+		IOLockUnlock(g_lock);
+		args->scalarOutput[0] = status;
+		args->scalarOutput[1] = us;
+		return r;
+	}
+	case 14:                                        /* WAIT: submits are synchronous */
+		return kIOReturnSuccess;
+	case 15: {                                      /* GET_PARAM */
+		if (nin < 1 || args->scalarOutputCount < 1) {
+			return kIOReturnBadArgument;
+		}
+		uint64_t p = in[0], v = 0;
+		uint32_t id = rd(g_gpu, GPU_ID);
+		if (p == 0) {
+			v = id >> 16;
+		} else if (p == 1) {
+			v = id & 0xffff;
+		} else if (p == 5) {                    /* STACK_PRESENT: not on Midgard */
+			v = 0;
+		} else if (p == 17) {                   /* COHERENCY_FEATURES: not on Midgard (panfrost: ACE-Lite) */
+			v = 1;
+		} else if (p < sizeof(mali_param_reg) / sizeof(mali_param_reg[0])) {
+			v = rd(g_gpu, mali_param_reg[p]);
+		} else if (p == 38) {                   /* NR_CORE_GROUPS */
+			v = 1;
+		}
+		args->scalarOutput[0] = v;
+		return kIOReturnSuccess;
+	}
+	default:
+		return kIOReturnUnsupported;
+	}
+}
+
+class SweetMali : public IOService {
+	OSDeclareDefaultStructors(SweetMali);
+public:
+	IOReturn newUserClient(task_t owningTask, void *securityID, UInt32 type, IOUserClient **handler) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(SweetMali, IOService);
+
+IOReturn
+SweetMali::newUserClient(task_t owningTask, void *securityID, UInt32 type, IOUserClient **handler)
+{
+	SweetMaliUserClient *uc = OSTypeAlloc(SweetMaliUserClient);
+	if (uc == NULL) {
+		return kIOReturnNoMemory;
+	}
+	if (!uc->initWithTask(owningTask, securityID, type) || !uc->attach(this)) {
+		uc->release();
+		return kIOReturnError;
+	}
+	if (!uc->start(this)) {
+		uc->detach(this);
+		uc->release();
+		return kIOReturnError;
+	}
+	*handler = uc;
+	return kIOReturnSuccess;
+}
+
+static bool
+mali_init(void)
+{
+	g_gpu = ml_io_map(MALI_PA, 0x5000);
+	g_pmu = ml_io_map(PMU_PD_PA, 0x1000);
+	g_g3d = ml_io_map(CMU_G3D_PA, 0x1000);
+	g_top = ml_io_map(CMU_TOP_PA, 0x1000);
+	g_lock = IOLockAlloc();
+	if (!g_gpu || !g_pmu || !g_g3d || !g_top || !g_lock) {
+		return false;
+	}
+	if (!gpu_power_clock()) {
+		IOLog("SWEET MALI: no GPU power/clock (pd st 0x%x mux stat 0x%x)\n", rd(g_pmu, 0x64), rd(g_g3d, 0x408));
+		return false;
+	}
+	g_shader = rd(g_gpu, SHADER_PRESENT);
+	g_tiler = rd(g_gpu, TILER_PRESENT);
+	g_l2 = rd(g_gpu, L2_PRESENT);
+	g_l0 = table_alloc(&g_l0_pa);
+	if (g_l0 == NULL) {
+		return false;
+	}
+	bool ok = gpu_reset();
+	IOLog("SWEET MALI: Mali GPU_ID 0x%08x shader 0x%x tiler 0x%x l2 0x%x, reset+power %d, AS0 table 0x%llx\n",
+	    rd(g_gpu, GPU_ID), g_shader, g_tiler, g_l2, ok, g_l0_pa);
+	return ok;
+}
+
+void
+sweet_mali_publish(IOService *provider)
+{
+	uint32_t on = 1;
+	PE_parse_boot_argn("sweetmali", &on, sizeof(on));
+	if (!on) {
+		IOLog("SWEET MALI: off (sweetmali=0)\n");
+		return;
+	}
+	if (!mali_init()) {
+		IOLog("SWEET MALI: init failed, no GPU service\n");
+		return;
+	}
+	g_ready = true;
+	mali_selftest();
+	SweetMali *m = OSTypeAlloc(SweetMali);
+	if (m != NULL && m->init() && m->attach(provider)) {
+		m->registerService();
+		IOLog("SWEET MALI: SweetMali published\n");
+	}
+	OSSafeReleaseNULL(m);
+}
+#else
+void
+sweet_mali_publish(IOService *)
+{
+}
